<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-Umsetzung der Messwerte: CPU/RAM (kernel32/ntdll), GPU (nvml.dll), Datenträger- und Netzwerk-Durchsatz
       und der Grafikspeicher über die Leistungsindikatoren (Stykker.Shared). Ohne Oberfläche; Core kennt diese Schicht nicht. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StykkerHud.Platform.Windows</AssemblyName>
    <RootNamespace>StykkerHud.Platform.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StykkerHud.Core\StykkerHud.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\src\Stykker.Shared\Stykker.Shared.csproj" />
  </ItemGroup>

</Project>
