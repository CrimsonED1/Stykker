<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- StykkerHUD-Server: die Messwerte dieser Maschine als Web-Oberfläche (Blazor Server, Port 8079) mit
       Tray-Symbol. Nur auf 127.0.0.1 erreichbar. Das Fenster (StykkerHUD.exe) zeigt dieselben Seiten. -->
  <PropertyGroup>
    <!-- net10.0 statt net10.0-windows: nur so bindet das SDK blazor.web.js ein (Tray-Symbol folgt ohne WinForms) -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Exe statt WinExe: mit WinExe bindet das SDK blazor.web.js nicht ein. Das Fenster startet den Server ohne
         Konsolenfenster. -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StykkerHUD-Server</AssemblyName>
    <RootNamespace>StykkerHud.Server</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StykkerHud.Core\StykkerHud.Core.csproj" />
    <ProjectReference Include="..\StykkerHud.Platform.Windows\StykkerHud.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\..\shared\src\Stykker.Shared\Stykker.Shared.csproj" />
  </ItemGroup>

  <!-- Das Design-System wird nicht kopiert und nicht eingebunden: der Server liefert es zur Laufzeit unter /ds aus
       seiner Quelle (Vorgabe C:\_AI\Stykker\MonoRepo\shared\design-system, umstellbar über den Schalter design-system). So gibt
       es genau eine Fassung für die ganze Stykker-Familie. -->

</Project>
