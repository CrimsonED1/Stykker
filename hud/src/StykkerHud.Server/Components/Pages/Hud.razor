@page "/"
@* Die Übersicht: alles statisch gerendert, die Werte holt hud.js im Sekundentakt aus /api/snapshot. Eine Kurve
   je Sekunde braucht keine Blazor-Schleife – und der Monitor läuft auch dann weiter, wenn die Seite kurz stockt.
   Kein Wert steht als Zahl im Markup: fehlt eine Messung, zeigt die Seite „–" (nie eine erfundene Zahl). *@

<div class="top">
    <div class="brand"><span class="logo">◆</span> STYKKER <span class="acc">HUD</span></div>
    <nav>
        <a class="active" href="/">Overview</a>
    </nav>
    <div class="strip">
        <span class="stat" title="Processor load">CPU <span class="mini"><i id="t-cpu"></i></span><b id="v-cpu">–</b>%</span>
        <span class="stat" title="Memory in use">RAM <b id="v-ram">–</b> GB</span>
        <span class="stat" title="Graphics processor">GPU <span class="mini"><i id="t-gpu"></i></span><b id="v-gpu">–</b>%</span>
        <span class="stat" title="Graphics memory in use">VRAM <b id="v-vram">–</b> GB</span>
        <span class="stat" title="Processes">Processes <b id="v-procs">–</b></span>
        <span class="stat" title="Time since the service started">Up <b id="v-uptime">–</b></span>
        <div class="seg" role="group" aria-label="Theme">
            <button type="button" data-theme-choice="dark" class="on">Dark</button>
            <button type="button" data-theme-choice="titan">Titan</button>
        </div>
    </div>
</div>

<main>
    <div id="notes"></div>

    <div class="layout">
        <div class="col">
            <div class="sec">Processor<span class="right mono" id="v-cores">–</span></div>
            <div class="card">
                <div class="spark" style="height:80px">
                    <svg viewBox="0 0 100 40" preserveAspectRatio="none">
                        <path class="area" id="cpu-area" d="" />
                        <path class="g1" id="cpu-g1" d="" />
                        <path class="ln" id="cpu-line" d="" />
                    </svg>
                    <span class="tip" id="cpu-tip" style="top:100%"></span>
                    <span class="lbl tl" id="cpu-peak">–</span>
                    <span class="lbl bl">−5 min</span>
                    <span class="lbl br">now</span>
                </div>
                @* Die Kerne liegen zugeklappt: in der Zeile steht nur die Spitze, das Raster entsteht beim Öffnen. *@
                <details class="hud-fold" id="cores-fold">
                    <summary>
                        <span class="sec">Cores<span class="right mono" id="v-cores-summary">–</span></span>
                    </summary>
                    <div class="hud-cores" id="cores"></div>
                </details>
            </div>

            <div class="sec">Processes<span class="right mono" id="v-proc-shown">–</span></div>
            @* Die Rückfrage vor einer Aktion steht als Leiste über der Liste; das Ergebnis kommt als Toast. *@
            <div id="confirm"></div>
            <div class="hud-tools">
                <div class="search">
                    <input id="q" placeholder="Filter processes" aria-label="Filter processes" />
                </div>
                <div class="seg" role="group" aria-label="Sort by">
                    <button type="button" class="on" data-sort="cpu">CPU</button>
                    <button type="button" data-sort="ram">Memory</button>
                    <button type="button" data-sort="gpu">GPU</button>
                    <button type="button" data-sort="name">Name</button>
                </div>
            </div>
            <div class="reqs" id="procs">
                <div class="req head">
                    <span></span>
                    <span>Name</span>
                    <span class="hostc">PID</span>
                    <span>CPU</span>
                    <span class="pp">Memory</span>
                    <span class="pp">GPU</span>
                    <span class="ex"><span>VRAM</span><span>Threads</span></span>
                    <span></span>
                    <span class="ago">CPU time</span>
                    <span></span>
                </div>
                <div id="proc-rows"></div>
            </div>
        </div>

        <div class="col">
            <div class="sec">Graphics<span class="right mono" id="v-gpu-name">–</span></div>
            <div class="card srv idle" id="gpu-card" style="--b:var(--b-llama)">
                <div class="tps"><b id="v-gpu-big">–</b><span>%</span></div>
                <div class="ctx" style="margin-top:8px">
                    <div class="bar"><i id="t-vram"></i></div>
                    <span class="num" id="v-vram-text">– / – GB</span>
                </div>
                @* Die Aufteilung über die Engines entsteht aus den Messwerten; ohne die Leistungsindikatoren bleibt sie leer. *@
                <div class="stack" id="gpu-stack" style="margin:12px 0 4px" hidden></div>
                <div class="legend" id="gpu-engines" hidden></div>
                <div class="mgrid" style="margin:12px 0 0">
                    <span class="mc" title="Graphics memory in use"><svg class="ic"><use href="#i-vram" /></svg><b id="v-gpu-vram">–</b><small>GB</small></span>
                    <span class="mc" title="Temperature"><b id="v-gpu-temp">–</b><small>°C</small></span>
                    <span class="mc" id="gpu-power" title="Board power draw"><b id="v-gpu-power">–</b><small id="v-gpu-power-max">W</small></span>
                    <span class="mc" title="Graphics clock"><svg class="ic"><use href="#i-timer" /></svg><b id="v-gpu-clock">–</b><small>MHz</small></span>
                    <span class="mc" title="Memory clock"><svg class="ic"><use href="#i-timer" /></svg><b id="v-gpu-memclock">–</b><small>MHz</small></span>
                </div>
                <div class="spark" style="height:64px;margin-top:10px">
                    <svg viewBox="0 0 100 40" preserveAspectRatio="none">
                        <path class="area" id="gpu-area" d="" />
                        <path class="g1" id="gpu-g1" d="" />
                        <path class="ln" id="gpu-line" d="" />
                    </svg>
                    <span class="tip" id="gpu-tip" style="top:100%"></span>
                    <span class="lbl tl" id="gpu-peak">–</span>
                    <span class="lbl br">now</span>
                </div>
            </div>

            <div class="sec">Memory</div>
            <div class="card">
                <div class="ctx">
                    <div class="bar"><i id="t-ram"></i></div>
                    <span class="num" id="v-ram-text">– / – GB</span>
                </div>
                <div class="ctx" style="margin-top:6px">
                    <div class="bar"><i id="t-commit"></i></div>
                    <span class="num" id="v-commit-text">– / – GB</span>
                </div>
            </div>

            @* Durchsatz als Balken: der Balken zeigt den Wert am bisher größten der Sitzung, daneben steht beides. *@
            <div class="sec">Storage<span class="right mono">all drives</span></div>
            <div class="card">
                <div class="ctx">
                    <div class="bar"><i id="t-disk-read"></i></div>
                    <span class="num"><svg class="ic"><use href="#i-arrow-down" /></svg> <span id="v-disk-read">–</span></span>
                </div>
                <div class="ctx" style="margin-top:6px">
                    <div class="bar"><i id="t-disk-write"></i></div>
                    <span class="num"><svg class="ic"><use href="#i-arrow-up" /></svg> <span id="v-disk-write">–</span></span>
                </div>
            </div>

            <div class="sec">Network<span class="right mono">all adapters</span></div>
            <div class="card">
                <div class="ctx">
                    <div class="bar"><i id="t-net-rx"></i></div>
                    <span class="num"><svg class="ic"><use href="#i-arrow-down" /></svg> <span id="v-net-rx">–</span></span>
                </div>
                <div class="ctx" style="margin-top:6px">
                    <div class="bar"><i id="t-net-tx"></i></div>
                    <span class="num"><svg class="ic"><use href="#i-arrow-up" /></svg> <span id="v-net-tx">–</span></span>
                </div>
            </div>
        </div>
    </div>

    <div id="toast"></div>
</main>