@implements IDisposable
@inject ProxyDialogs Dialogs
@inject EngineHost Host
@inject WebActions Web
@inject Toasts Toast
@inject IJSRuntime JS

@* Der Proxy-Dialog in vier Reitern (General, Sources, Routing, Tests): an/aus, Standardmodell, Port und LAN; angehängte
   Rechner und Cloud-Anbieter mit Schlüssel und Modellwahl; Sicherheitsprüfung und Bilder; die beiden Modelltests, jeder mit
   eigener Anbieter-Auswahl, Hinweis und Tabelle. Der zuletzt gewählte Reiter bleibt je Browser. Er öffnet über den
   Proxy-Chip der Kopfleiste oder das Zahnrad der Karte. Nur mit Schreibrecht bedienbar; sonst lesend. Esc, Klick daneben
   und das X schließen ihn. Die Modellwahl eines Anbieters ist ein eigener Dialog über diesem. *@
@if (Dialogs.IsOpen)
{
    var px = Host.Engine.Proxies;
    var models = px.Choices(); var remotes = px.RemoteStates(); var provs = Providers;
    <div class="modal-back" @onclick="Close">
        <div class="modal pxd" role="dialog" aria-modal="true" aria-labelledby="pxd-title" tabindex="-1"
             @onclick:stopPropagation="true" @onkeydown="OnKey">
            <div class="cdlg-hd">
                <Icon Name="proxy" Class="lg" />
                <div class="cdlg-t">
                    <h2 id="pxd-title">@Strings.PxTitle</h2>
                    <span class="small @(px.Running ? "acc" : "muted")">@(px.Running ? Strings.PxRunning : Strings.PxStopped)</span>
                </div>
                <button class="ib quiet" title="@Strings.Close" aria-label="@Strings.Close" @onclick="Close"><Icon Name="x" /></button>
            </div>
            @if (!CanWrite)
            {
                <div class="small muted cdlg-note">@Strings.ViewerOnly</div>
            }

            <div class="seg pxd-tabs" role="tablist" aria-label="@Strings.PxTitle">
                @foreach (var t in ProxyDialogTabs.All)
                {
                    var tab = t;
                    <button role="tab" class="@(_tab == tab ? "on" : "")" aria-selected="@(_tab == tab ? "true" : "false")" @onclick="() => SetTab(tab)">@TabName(tab)</button>
                }
            </div>

            @if (_tab == ProxyDialogTabs.General)
            {
                <div class="cdlg-row">
                    <span class="cdlg-l">@Strings.PxSwitch</span>
                    <button id="pxd-switch" class="switch @(px.Running ? "on" : "")" role="switch" aria-checked="@(px.Running ? "true" : "false")"
                            aria-label="@Strings.PxSwitch" disabled="@(!CanWrite)" @onclick="ToggleProxy"><i></i></button>
                </div>

                <div class="pxp-row">
                    <span class="pxp-l">@Strings.PxDefault <span class="tip" title="@(Strings.PxDefaultTip + " " + Strings.ProxySwitchHint)"><Icon Name="info" /></span></span>
                    <select disabled="@(!CanWrite)" value="@ServeValue" @onchange="OnServeChanged" aria-label="@Strings.PxDefault">
                        <option value="">@Strings.ProxyTargetAuto</option>
                        @foreach (var c in models) { <option value="@c.Value">@c.Display</option> }
                    </select>
                </div>
                <div class="pxp-row">
                    <span class="pxp-l">@Strings.PxPort <span class="tip" title="@Strings.PxPortTip"><Icon Name="info" /></span></span>
                    <input type="number" min="1024" max="65535" class="pxp-port" value="@(_port ?? px.Port.ToString(CultureInfo.InvariantCulture))" @oninput="e => _port = e.Value?.ToString()" disabled="@(!CanWrite)" aria-label="@Strings.PxPort" />
                    @if (_port != null && _port != px.Port.ToString(CultureInfo.InvariantCulture) && CanWrite)
                    {
                        <button class="primary" @onclick="SavePort">@Strings.BtnSave</button><button class="ghost" @onclick="() => _port = null">@Strings.PxCancel</button>
                    }
                </div>
                <div class="pxp-row">
                    <span class="pxp-l">@Strings.PxLan <span class="tip warnc" title="@Strings.ProxyLanHint"><Icon Name="info" /></span></span>
                    <button class="switch sm @(px.BindLan ? "on warn" : "")" role="switch" aria-checked="@(px.BindLan ? "true" : "false")" aria-label="@Strings.PxLan" disabled="@(!CanWrite)" @onclick="() => SetLan(!px.BindLan)"><i></i></button>
                    <span class="muted small">@(px.BindLan ? Strings.PxLanOn : Strings.PxLanOff)</span>
                </div>
            }

            @if (_tab == ProxyDialogTabs.Sources)
            {
                <div class="pxs-list">
                    <div class="pxs-item">
                        <Icon Name="host" /><span class="n">@Strings.PxThisPc</span>
                        <span class="muted small">@Strings.PxModels(ProxyPanel.LocalModelCount(models))</span>
                    </div>
                    <div class="pxs-grp">
                        <span>@Strings.PxMachines <span class="tip" title="@Strings.ProxyRemoteHint"><Icon Name="info" /></span></span>
                        @if (CanWrite && _add != "remote") { <button class="ib quiet" title="@Strings.PxAdd" aria-label="@Strings.PxAdd" @onclick='() => _add = "remote"'>+ @Strings.PxAdd</button> }
                    </div>
                    @if (remotes.Count == 0 && _add != "remote") { <div class="muted small pxs-none">@Strings.PxNoMachines</div> }
                    @foreach (var r in remotes)
                    {
                        var rr = r;
                        <div class="pxs-item">
                            <span class="lampi @(r.Ready ? "ok" : "bad")" title="@(r.Ready ? Strings.PxReachable : Strings.PxUnreachable)"><Icon Name="@(r.Ready ? "r-ok" : "r-err")" Title="@(r.Ready ? Strings.PxReachable : Strings.PxUnreachable)" /></span>
                            <span class="n" title="@r.Url">@r.Name</span>
                            <span class="muted small">@Strings.PxModels(r.Models.Length)</span>
                            @if (CanWrite) { <button class="ib quiet danger" title="@Strings.PxRemove" aria-label="@Strings.PxRemove" @onclick="() => RemoveRemote(rr.Url)"><Icon Name="trash" /></button> }
                        </div>
                    }
                    @if (_add == "remote")
                    {
                        <div class="pxs-form">
                            <input placeholder="@Strings.ProxyRemoteNameLabel" @bind="_rName" @bind:event="oninput" />
                            <input placeholder="@Strings.ProxyRemoteUrlLabel" @bind="_rUrl" @bind:event="oninput" />
                            <div class="row"><button class="primary" @onclick="AddRemote">@Strings.PxAdd</button><button class="ghost" @onclick="() => _add = null">@Strings.PxCancel</button></div>
                        </div>
                    }

                    <div class="pxs-grp">
                        <span>@Strings.PxCloud <span class="tip" title="@Strings.ProxyProviderHint"><Icon Name="info" /></span></span>
                        @if (CanWrite && _add != "provider") { <button class="ib quiet" title="@Strings.PxAdd" aria-label="@Strings.PxAdd" @onclick='() => _add = "provider"'>+ @Strings.PxAdd</button> }
                    </div>
                    @if (provs.Count == 0 && _add != "provider") { <div class="muted small pxs-none">@Strings.PxNoCloud</div> }
                    @foreach (var pv in provs)
                    {
                        var pp = pv;
                        <div class="pxs-item">
                            <span class="lampi @(pv.Ready ? "ok" : pv.HasKey ? "bad" : "")" title="@(pv.Error.Length > 0 ? pv.Error : pv.Ready ? Strings.PxReachable : Strings.PxUnreachable)"><Icon Name="@(pv.Ready ? "r-ok" : pv.HasKey ? "r-err" : "s-idle")" Title="@(pv.Ready ? Strings.PxReachable : Strings.PxUnreachable)" /></span>
                            <span class="n" title="@pv.Url">@pv.Name</span>
                            <span class="muted small" title="@string.Join(", ", pv.Offered)">@Strings.ProxyProviderOffered(pv.Offered.Length, pv.Models.Length)</span>
                            <span class="small @(pv.HasKey ? "muted" : "warnc")"><Icon Name="lock" Class="sm" /> @(pv.HasKey ? Strings.PxKeyStored : Strings.PxKeyMissing)</span>
                            @if (CanWrite)
                            {
                                <button class="ghost" title="@Strings.ProxyProviderModelsHint" aria-label="@Strings.ProxyProviderModelsButton" @onclick="() => _modelsFor = pp.Url">@Strings.ProxyProviderModelsButton</button>
                                <button class="ib quiet" title="@Strings.PxSetKey" aria-label="@Strings.PxSetKey" @onclick="() => _keyFor = pp.Url"><Icon Name="edit" /></button>
                                <button class="ib quiet danger" title="@Strings.PxRemove" aria-label="@Strings.PxRemove" @onclick="() => RemoveProvider(pp.Url)"><Icon Name="trash" /></button>
                            }
                        </div>
                        @if (pv.Error.Length > 0) { <div class="small pxs-err">@pv.Error</div> }
                        @if (_keyFor == pv.Url)
                        {
                            <div class="pxs-form">
                                <input type="password" placeholder="@Strings.ProxyProviderKeyLabel" value="@KeyFor(pv.Url)" @oninput="e => OnKeyInput(pp.Url, e)" autocomplete="off" />
                                <div class="row"><button class="primary" @onclick="() => { SaveKey(pp.Url); _keyFor = null; }">@Strings.BtnProxyProviderKey</button><button class="ghost" @onclick="() => _keyFor = null">@Strings.PxCancel</button></div>
                            </div>
                        }
                    }
                    @if (_add == "provider")
                    {
                        <div class="pxs-form">
                            <div class="row">
                                @foreach (var pr in ProviderPresets.All)
                                {
                                    var preset = pr;
                                    <button class="ghost" title="@Strings.ProxyProviderPresetHint" @onclick="() => UsePreset(preset)">@preset.Name</button>
                                }
                            </div>
                            <input placeholder="@Strings.ProxyProviderNameLabel" @bind="_pName" @bind:event="oninput" />
                            <input placeholder="@Strings.ProxyProviderUrlLabel" @bind="_pUrl" @bind:event="oninput" />
                            <input type="password" placeholder="@Strings.ProxyProviderKeyLabel" @bind="_pKey" @bind:event="oninput" autocomplete="off" />
                            <div class="row"><button class="primary" @onclick="AddProviderForm">@Strings.PxAdd</button><button class="ghost" @onclick="() => _add = null">@Strings.PxCancel</button></div>
                        </div>
                    }
                </div>

                @if (models.Count > 0)
                {
                    <details class="pxp-models">
                        <summary>@Strings.PxModelList(models.Count)</summary>
                        <ul>@foreach (var c in models) { <li title="@c.Value">@c.Display</li> }</ul>
                    </details>
                }
            }

            @if (_tab == ProxyDialogTabs.Routing)
            {
                <h3 class="sec">@Strings.ClientAutoSection</h3>
                <div class="small muted">@Strings.ClientAutoHint</div>
                <select class="cdlg-sel" aria-label="@Strings.ClientAutoLabel" title="@Strings.ClientAutoLabel" disabled="@(!CanWrite)"
                        value="@px.ClassifierValue()" @onchange="OnClassifier">
                    <option value="">@Strings.ClientAutoSame</option>
                    @foreach (var c in models) { <option value="@c.Value">@c.Display</option> }
                </select>

                <h3 class="sec">@Strings.ProxyVisionSection</h3>
                <div class="small muted">@Strings.ProxyVisionHint</div>
                <select class="cdlg-sel" aria-label="@Strings.ProxyVisionLabel" title="@Strings.ProxyVisionLabel" disabled="@(!CanWrite)"
                        value="@px.VisionValue()" @onchange="OnVision">
                    <option value="">@Strings.ClientAutoSame</option>
                    @foreach (var c in models) { <option value="@c.Value">@c.Display</option> }
                </select>
            }

            @* Modelltest der Sicherheitsprüfung: jedes Modell eines Anbieters bekommt eine Prüfung und zeigt, ob es schnell und
               im Format antwortet *@
            @if (_tab == ProxyDialogTabs.Tests)
            {
                var tests = Host.Engine.ClassifierRun;
                var running = tests is { Running: true };
                var testUrl = ClassifierTestUrl;
                <h3 class="sec">@Strings.ClassifierTestButton</h3>
                <div class="small muted pxp-hint">@(_realRequest ? Strings.ClassifierTestRealRequest : Strings.ClassifierTestExampleRequest)</div>
                @if (Providers.Count == 0)
                {
                    <div class="muted small">@Strings.ClassifierTestNoProvider</div>
                }
                else
                {
                    <div class="pxp-row">
                        <select class="ctt-prov" value="@testUrl" aria-label="@Strings.ClassifierTestProvider" title="@Strings.ClassifierTestProvider"
                                disabled="@(!CanWrite || running)" @onchange="e => _testUrl = e.Value?.ToString()">
                            @foreach (var pv in Providers) { <option value="@pv.Url">@pv.Name</option> }
                        </select>
                        <label class="small"><input type="checkbox" @bind="_retryUnavailable" disabled="@(!CanWrite || running)" /> @Strings.ClassifierTestRetry</label>
                        @if (running)
                        {
                            <button class="ghost" @onclick="StopTest">@Strings.ClassifierTestStop</button>
                        }
                        else
                        {
                            <button class="primary" disabled="@(!CanWrite)" @onclick="StartTest">@Strings.PxStartTest</button>
                        }
                    </div>
                }
                @if (tests != null)
                {
                    var c = tests.Counts;
                    @if (running)
                    {
                        var st = tests.Status;
                        var sec = st.RequestSeconds;
                        <div class="ctt-live">
                            <div class="ctt-live-head"><b>@st.Model</b> <span class="muted">@Strings.TestPhaseText(st.Phase, st.WaitSeconds)</span><span class="ctt-live-sec">@Strings.ClassifierTestSeconds(sec)</span></div>
                            <div class="bar"><div style="width:@(LivePct(sec, tests.TimeoutSeconds))%"></div></div>
                            <div class="small muted">@Strings.ClassifierTestCounts(tests.Done, tests.Total, c.Ok, c.Failed, c.Skipped)@(Strings.ClassifierTestLeft(tests.RemainingSec()) is { Length: > 0 } left ? " · " + left : "")</div>
                        </div>
                    }
                    else
                    {
                        <div class="small muted pxp-hint">@Strings.ClassifierTestCounts(tests.Done, tests.Total, c.Ok, c.Failed, c.Skipped)</div>
                    }
                    <div class="ctt-scroll">
                        <table class="ctt">
                            <thead><tr>
                                <th>@Strings.ClassifierColModel</th><th>@Strings.ClassifierColFormat</th><th>@Strings.ClassifierColStatus</th>
                                <th>@Strings.ClassifierColFirst</th><th>@Strings.ClassifierColTotal</th><th>@Strings.ClassifierColNote</th><th></th>
                            </tr></thead>
                            <tbody>
                            @if (running)
                            {
                                var st = tests.Status;
                                <tr class="ctt-run">
                                    <td title="@st.Model">@st.Model</td><td>–</td>
                                    <td><Icon Name="s-load" Class="spin" /> @Strings.TestPhaseText(st.Phase, st.WaitSeconds)</td>
                                    <td>–</td><td>@Strings.ClassifierTestSeconds(st.RequestSeconds)</td><td></td><td></td>
                                </tr>
                            }
                            @foreach (var row in ClassifierTest.Sorted(tests.Results))
                            {
                                var rr = row;
                                <tr>
                                    <td title="@rr.Model">@rr.Model</td>
                                    <td>@(rr.FormatOk is true ? Strings.ClassifierFormatOk : rr.FormatOk is false ? Strings.ClassifierFormatNo : "–")</td>
                                    <td>@rr.Status</td>
                                    <td>@(rr.FirstByteSec is double fb ? fb.ToString("0.00", CultureInfo.InvariantCulture) : "–")</td>
                                    <td>@(rr.TotalSec is double tt ? tt.ToString("0.00", CultureInfo.InvariantCulture) : "–")</td>
                                    <td class="ctt-note" title="@NoteTitle(rr.Status, rr.Note, tests.TimeoutSeconds)">@NoteShown(rr.Status, rr.Note, tests.TimeoutSeconds)</td>
                                    <td>
                                        @if (rr.FormatOk is true && !running)
                                        {
                                            <button class="ghost" disabled="@(!CanWrite)" @onclick='() => UseModel("proxy.classifier", tests.ProviderUrl, rr.Model)'>@Strings.ClassifierTestUse</button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                @* Bildtest: jedes Modell bekommt ein kleines Bild (links rot, rechts blau) und zeigt, ob es beide Farben nennt *@
                var vtests = Host.Engine.VisionRun;
                var vrunning = vtests is { Running: true };
                var visionUrl = VisionTestUrl;
                <h3 class="sec">@Strings.VisionTestButton</h3>
                <div class="small muted pxp-hint">@Strings.VisionTestImageNote</div>
                @if (Providers.Count == 0)
                {
                    <div class="muted small">@Strings.ClassifierTestNoProvider</div>
                }
                else
                {
                    <div class="pxp-row">
                        <select class="ctt-prov" value="@visionUrl" aria-label="@Strings.ClassifierTestProvider" title="@Strings.ClassifierTestProvider"
                                disabled="@(!CanWrite || vrunning)" @onchange="e => _visionUrl = e.Value?.ToString()">
                            @foreach (var pv in Providers) { <option value="@pv.Url">@pv.Name</option> }
                        </select>
                        <label class="small"><input type="checkbox" @bind="_retryVision" disabled="@(!CanWrite || vrunning)" /> @Strings.ClassifierTestRetry</label>
                        @if (vrunning)
                        {
                            <button class="ghost" @onclick="StopTest">@Strings.ClassifierTestStop</button>
                        }
                        else
                        {
                            <button class="primary" disabled="@(!CanWrite)" @onclick="StartVisionTest">@Strings.PxStartTest</button>
                        }
                    </div>
                }
                @if (vtests != null)
                {
                    var vc = vtests.Counts;
                    @if (vrunning)
                    {
                        var vst = vtests.Status;
                        var vsec = vst.RequestSeconds;
                        <div class="ctt-live">
                            <div class="ctt-live-head"><b>@vst.Model</b> <span class="muted">@Strings.TestPhaseText(vst.Phase, vst.WaitSeconds)</span><span class="ctt-live-sec">@Strings.ClassifierTestSeconds(vsec)</span></div>
                            <div class="bar"><div style="width:@(LivePct(vsec, vtests.TimeoutSeconds))%"></div></div>
                            <div class="small muted">@Strings.ClassifierTestCounts(vtests.Done, vtests.Total, vc.Ok, vc.Failed, vc.Skipped)@(Strings.ClassifierTestLeft(vtests.RemainingSec()) is { Length: > 0 } vleft ? " · " + vleft : "")</div>
                        </div>
                    }
                    else
                    {
                        <div class="small muted pxp-hint">@Strings.ClassifierTestCounts(vtests.Done, vtests.Total, vc.Ok, vc.Failed, vc.Skipped)</div>
                    }
                    <div class="ctt-scroll">
                        <table class="ctt">
                            <thead><tr>
                                <th>@Strings.ClassifierColModel</th><th>@Strings.ClassifierColStatus</th><th>@Strings.VisionTestColTime</th>
                                <th>@Strings.VisionTestColOk</th><th>@Strings.ClassifierColNote</th><th></th>
                            </tr></thead>
                            <tbody>
                            @if (vrunning)
                            {
                                var vst = vtests.Status;
                                <tr class="ctt-run">
                                    <td title="@vst.Model">@vst.Model</td>
                                    <td><Icon Name="s-load" Class="spin" /> @Strings.TestPhaseText(vst.Phase, vst.WaitSeconds)</td>
                                    <td>@Strings.ClassifierTestSeconds(vst.RequestSeconds)</td><td>–</td><td></td><td></td>
                                </tr>
                            }
                            @foreach (var row in VisionTest.Sorted(vtests.Results))
                            {
                                var vr = row;
                                bool skipped = vr.Status == Strings.ClassifierStatusSkipped;
                                <tr>
                                    <td title="@vr.Model">@vr.Model</td>
                                    <td>@vr.Status</td>
                                    <td>@(vr.TotalSec is double tt ? tt.ToString("0.00", CultureInfo.InvariantCulture) : "–")</td>
                                    <td>@(skipped ? "–" : vr.Ok ? Strings.ClassifierFormatOk : Strings.ClassifierFormatNo)</td>
                                    <td class="ctt-note" title="@NoteTitle(vr.Status, vr.Note, vtests.TimeoutSeconds)">@NoteShown(vr.Status, vr.Note, vtests.TimeoutSeconds)</td>
                                    <td>
                                        @if (vr.Ok && !vrunning)
                                        {
                                            <button class="ghost" disabled="@(!CanWrite)" @onclick='() => UseModel("proxy.vision", vtests.ProviderUrl, vr.Model)'>@Strings.VisionTestUse</button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_flash.Length > 0) { <div class="small pxp-flash">@_flash</div> }
            <div class="row end">
                <button class="ghost" @onclick="Close">@Strings.Close</button>
            </div>
        </div>
    </div>
}

@* Auswahl der Modelle eines Anbieters: ein Dialog über dem Proxy-Dialog, außerhalb von ihm (Klicks gehen nicht an ihn) *@
@if (Dialogs.IsOpen && _modelsFor is { } mUrl && Providers.Any(x => x.Url == mUrl))
{
    var mp = Providers.First(x => x.Url == mUrl);
    var (listed, chosen) = Host.Engine.Proxies.ProviderModelLists(mUrl);
    <ProviderModelsDialog @key="mUrl" Name="@mp.Name" Listed="listed" Chosen="chosen" OnSave="models => SaveModels(mUrl, models)" OnClose="CloseModels" />
}

@code {
    private Timer? _t;
    private string _flash = "";
    private string _rName = "", _rUrl = "";
    private string _pName = "", _pUrl = "", _pKey = "";
    private readonly Dictionary<string, string> _pKeys = new();
    // Welches Formular offen ist ("remote", "provider" oder keins), für welchen Anbieter der Schlüssel und welche Modellwahl
    private string? _add, _keyFor, _modelsFor;
    private string? _port;
    private bool _wasOpen, _focus;
    // Der offene Reiter (ProxyDialogTabs); beim ersten Zeichnen aus dem Browser gelesen
    private string _tab = ProxyDialogTabs.General;
    // Modelltests: je Test der gewählte Anbieter und die Wiederholung „Retry unavailable“ (Modelle, die beim letzten Lauf
    // 404 hatten, werden für diesen Lauf wieder gefragt). Die Sicherheitsprüfung zeigt, ob die Testanfrage die letzte echte
    // Prüfung ist (sonst das Beispiel).
    private string? _testUrl, _visionUrl;
    private bool _realRequest, _retryUnavailable, _retryVision;

    private bool CanWrite => Web.CanWrite && !Host.ReadOnly;

    // Anteil der Zeitgrenze, den die laufende Anfrage schon verbraucht hat (0 bis 100) – für den Balken der Live-Zeile
    private static int LivePct(double sec, double timeoutSec) => timeoutSec <= 0 ? 0 : (int)Math.Min(100, Math.Round(sec / timeoutSec * 100));
    // Die Notiz, kurz übersetzt wenn bekannt; der Tooltip zeigt dann das Original
    private static string NoteShown(string status, string note, double timeoutSec) => TestNotes.Friendly(status, note, timeoutSec) ?? note;
    private static string NoteTitle(string status, string note, double timeoutSec) => TestNotes.Friendly(status, note, timeoutSec) is null ? "" : note;

    protected override void OnInitialized()
    {
        Dialogs.Changed += Refresh;
        // Die Werte laufen im Takt weiter, solange der Dialog offen ist (zu bleibt er still)
        _t = new Timer(_ => { if (Dialogs.IsOpen) InvokeAsync(StateHasChanged); }, null, 1000, 1000);
    }

    // Öffnen: die Eingaben und Formulare zurücksetzen und den Schalter fokussieren. Schließen: nur leeren. Der Reiter bleibt.
    private void Refresh()
    {
        if (Dialogs.IsOpen && !_wasOpen)
        {
            _flash = "";
            _port = null;
            _add = _keyFor = _modelsFor = null;
            _testUrl = _visionUrl = null;
            _retryUnavailable = _retryVision = false;
            _realRequest = Host.Engine.ClassifierSample().Real;
            _focus = true;
        }
        _wasOpen = Dialogs.IsOpen;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        // Der zuletzt gewählte Reiter (je Browser, ui.js); ohne Speicher bleibt es bei General
        if (first)
        {
            _tab = ProxyDialogTabs.Parse(await Stored("stykkerUi.proxyTab"));
            StateHasChanged();
        }
        if (!_focus) return;
        _focus = false;
        try { await JS.InvokeVoidAsync("stykkerFocus", "pxd-switch"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
    }

    // Liest einen Wert aus dem Browser; fehlt das Skript (alte Seite im Cache) oder der Speicher, kommt null
    private async Task<string?> Stored(string what)
    {
        try { return await JS.InvokeAsync<string?>(what); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or NotSupportedException) { return null; }
    }

    private async Task SetTab(string tab)
    {
        _tab = tab;
        try { await JS.InvokeVoidAsync("stykkerUi.setProxyTab", tab); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or NotSupportedException) { }
    }

    private static string TabName(string tab) => tab switch
    {
        ProxyDialogTabs.General => Strings.PxTabGeneral,
        ProxyDialogTabs.Sources => Strings.PxSources,
        ProxyDialogTabs.Routing => Strings.PxTabRouting,
        _ => Strings.PxTabTests,
    };

    private IReadOnlyList<(string Name, string Url, bool HasKey, bool Ready, string[] Models, string Error, string[] Offered)> Providers
        => Host.Engine.Proxies.ProviderStates();

    private void OnKey(KeyboardEventArgs e) { if (e.Key == "Escape") Close(); }

    private void Close()
    {
        _flash = "";
        _add = _keyFor = _modelsFor = null;
        Dialogs.Close();
    }

    private void ToggleProxy()
    {
        if (!CanWrite) return;
        if (!Host.Engine.Proxies.Toggle(out var error) && error != null) _flash = error;
    }

    // Kennung des servierten Modells: „<ServerKey>|<Modell>" oder eine Cloud-Zielkennung, leer = Auto
    private string ServeValue => Host.Engine.Proxies.ChoiceValue();

    private void OnServeChanged(ChangeEventArgs a) { if (CanWrite) Host.Engine.Proxies.SetChoiceValue(a.Value?.ToString() ?? ""); }

    private async Task OnVision(ChangeEventArgs e)
    {
        if (!CanWrite) return;
        var r = await Web.RunAsync(new ActionRequest { Action = "proxy.vision", Arg = e.Value?.ToString() ?? "" });
        if (r.Ok) { _flash = ""; Toast.Show(r.Message); } else _flash = r.Message;
    }

    private async Task OnClassifier(ChangeEventArgs e)
    {
        if (!CanWrite) return;
        var r = await Web.RunAsync(new ActionRequest { Action = "proxy.classifier", Arg = e.Value?.ToString() ?? "" });
        if (r.Ok) { _flash = ""; Toast.Show(r.Message); } else _flash = r.Message;
    }

    // Der Anbieter, den der jeweilige Test prüft (Regel in ProxyPanel.TestTarget)
    private string ClassifierTestUrl => ProxyPanel.TestTarget(Providers.Select(p => (p.Url, p.HasKey)), _testUrl);
    private string VisionTestUrl => ProxyPanel.TestTarget(Providers.Select(p => (p.Url, p.HasKey)), _visionUrl);

    private bool Offered(string url, string model)
        => Providers.FirstOrDefault(p => p.Url == url).Offered is { } offered && Array.IndexOf(offered, model) >= 0;

    private async Task StartTest()
    {
        if (!CanWrite || ClassifierTestUrl is not { Length: > 0 } url) return;
        var r = await Web.RunAsync(new ActionRequest { Action = "classifier.test.start", Arg = url, Flag = _retryUnavailable });
        if (r.Ok) { _flash = ""; Toast.Show(r.Message); } else _flash = r.Message;
    }

    private async Task StartVisionTest()
    {
        if (!CanWrite || VisionTestUrl is not { Length: > 0 } url) return;
        var r = await Web.RunAsync(new ActionRequest { Action = "vision.test.start", Arg = url, Flag = _retryVision });
        if (r.Ok) { _flash = ""; Toast.Show(r.Message); } else _flash = r.Message;
    }

    // Abbrechen geht über classifier.test.stop für beide Tests (es läuft ohnehin nur ein Modelltest zur Zeit)
    private async Task StopTest()
    {
        if (!CanWrite) return;
        var r = await Web.RunAsync(new ActionRequest { Action = "classifier.test.stop" });
        if (r.Ok) { _flash = ""; Toast.Show(r.Message); } else _flash = r.Message;
    }

    // Das geprüfte Modell als Prüfmodell setzen (action „proxy.classifier“ oder „proxy.vision“): die Cloud-Zielkennung trägt Anbieter
    // und Modell. Ist es beim Anbieter nicht angehakt, wird es erst als angeboten eingetragen – mit derselben Aktion wie der
    // Modell-Dialog des Anbieters.
    private async Task UseModel(string action, string url, string model)
    {
        if (!CanWrite) return;
        if (!Offered(url, model))
        {
            var offered = Providers.FirstOrDefault(p => p.Url == url).Offered ?? Array.Empty<string>();
            var add = new ActionRequest { Action = "provider.models", Arg = url };
            add.Values["models"] = string.Join('\n', offered.Append(model));
            var a = await Web.RunAsync(add);
            if (!a.Ok) { _flash = a.Message; return; }
        }
        var r = await Web.RunAsync(new ActionRequest { Action = action, Arg = ProxyTarget.CloudKey(url, model) });
        if (r.Ok) { _flash = ""; Toast.Show(r.Message); } else _flash = r.Message;
    }

    private void SetLan(bool on) { if (CanWrite) Host.Engine.Proxies.SetBindLan(on); }

    private async Task SavePort()
    {
        if (!CanWrite || _port == null) return;
        var req = new ActionRequest { Action = "proxy.port" };
        req.Values["port"] = _port;
        var r = await Web.RunAsync(req);
        if (r.Ok) { _port = null; Toast.Show(r.Message); } else _flash = r.Message;
    }

    private void AddRemote()
    {
        if (!CanWrite) return;
        if (string.IsNullOrWhiteSpace(_rUrl)) return;
        Host.Engine.Proxies.AddRemote(_rName, _rUrl);
        _rName = _rUrl = "";
        _add = null;
    }

    private void RemoveRemote(string url) { if (CanWrite) Host.Engine.Proxies.RemoveRemote(url); }

    private string KeyFor(string url) => _pKeys.TryGetValue(url, out var k) ? k : "";

    private void OnKeyInput(string url, ChangeEventArgs a) => _pKeys[url] = a.Value?.ToString() ?? "";

    private void AddProvider()
    {
        if (!CanWrite) return;
        Host.Engine.Proxies.AddProvider(_pName, _pUrl, _pKey, out var error);
        if (error != null) { _flash = error; return; }
        _pName = _pUrl = _pKey = "";
    }

    private void AddProviderForm()
    {
        var url = ProviderKeys.Normalize(_pUrl);
        AddProvider();
        // angenommen: Felder sind geleert; ein neuer Anbieter bietet noch nichts an, darum gleich die Auswahl öffnen
        if (_pName.Length == 0 && _pUrl.Length == 0) { _add = null; _modelsFor = url; }
    }

    private void SaveKey(string url)
    {
        if (!CanWrite) return;
        Host.Engine.Proxies.SetProviderKey(url, KeyFor(url), out var error);
        if (error != null) { _flash = error; return; }
        _pKeys.Remove(url);
    }

    private void RemoveProvider(string url)
    {
        if (!CanWrite) return;
        Host.Engine.Proxies.RemoveProvider(url);
        _pKeys.Remove(url);
    }

    private void CloseModels() => _modelsFor = null;

    private async Task SaveModels(string url, string[] models)
    {
        if (!CanWrite) return;
        var req = new ActionRequest { Action = "provider.models", Arg = url };
        req.Values["models"] = string.Join('\n', models);
        var r = await Web.RunAsync(req);
        if (r.Ok) { _modelsFor = null; Toast.Show(r.Message); } else _flash = r.Message;
    }

    // Vorlage gewählt: Name und Basis-URL stehen im Formular, der Schlüssel fehlt noch
    private void UsePreset((string Name, string BaseUrl) preset)
    {
        _pName = preset.Name;
        _pUrl = preset.BaseUrl;
    }

    public void Dispose()
    {
        Dialogs.Changed -= Refresh;
        _t?.Dispose();
    }
}
