    <div class="pxp-row">
        <span class="pxp-l">@Strings.PxSources</span>
        <span class="pxp-v">@Strings.PxSourceCounts(machines, clouds)</span>
    </div>
    <div class="pxp-row">
        <span class="pxp-l">@Strings.PxClassifier</span>
        <span class="pxp-v">@ProxyPanel.ClassifierLabel(px.ClassifierValue(), models)</span>
    </div>
    <div class="pxp-row">
        <span class="pxp-l">@Strings.ProxyVisionLabel</span>
        <span class="pxp-v">@ProxyPanel.ClassifierLabel(px.VisionValue(), models)</span>
    </div>
    <div class="pxp-row" title="@Strings.PxRoutedTip">
        <span class="pxp-l">@Strings.PxRouted</span>
        <span class="pxp-v">@Strings.PxRoutedText(routes.Auto, routes.Image, routes.Cloud)</span>
    </div>
</div>
</div>
</aside>
</div>


@code {
    private Timer? _t;
    private string _q = "", _flash = "";
    private Profile? _edit;
    private string _editName = "", _editNote = "", _editArgs = "";

    // Startknopf-Tooltip wie im Fenster: die Vorprüfung (Port, Modelldatei, VRAM, RAM) läuft im Hintergrund,
    // das Ergebnis wird kurz (10 s) zwischengespeichert, damit die Seite nicht bei jedem Takt neu prüft
    private readonly Dictionary<string, (DateTime At, string Text)> _startTips = new();
    private readonly HashSet<string> _startTipBusy = new();

    protected override void OnInitialized() => _t = new Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    public void Dispose() => _t?.Dispose();

    private string StartTip(Profile p)
    {
        if (_startTips.TryGetValue(p.Key, out var cached) && (DateTime.Now - cached.At).TotalSeconds < 10) return cached.Text;
        if (_startTipBusy.Add(p.Key))
        {
            var hist = Host.Engine.Library.HistoryOf(p);
            var spec = new LaunchSpec(p.Name, p.Program, p.Args, p.WorkingDir, p.Id, hist is { MaxVramGb: > 0 } ? hist.MaxVramGb : null, p.Env,
                hist is { MaxRamGb: > 0 } ? hist.MaxRamGb : null);
            var running = Host.Engine.Registry.Servers.Select(s => s.Info).ToList();
            var gpu = Host.Engine.Gpu;
            _ = Task.Run(async () =>
            {
                string text;
                try
                {
                    var issues = (await ServerLauncher.CheckAsync(spec, Host.Engine.Platform, gpu, running)).Where(i => i.Code != "secret").ToList();
                    var errors = issues.Where(i => i.Severity == LaunchSeverity.Error).ToList();
                    var warns = issues.Where(i => i.Severity == LaunchSeverity.Warning).ToList();
                    text = errors.Count > 0 ? Strings.StartTipBlocked(IssueLines(errors))
                        : warns.Count > 0 ? Strings.StartTipWarn(IssueLines(warns))
                        : Strings.StartTipReady;
                }
                catch { text = Strings.StartTipReady; }
                await InvokeAsync(() =>
                {
                    _startTips[p.Key] = (DateTime.Now, text);
                    _startTipBusy.Remove(p.Key);
                    StateHasChanged();
                });
            });
        }
        return _startTips.TryGetValue(p.Key, out var old) ? old.Text : Strings.StartTipChecking;
    }

    private static string IssueLines(IEnumerable<LaunchIssue> issues) => string.Join("\n", issues.Select(i => "• " + i.Message));

    // Beschriftung unten links an der Kurve: wie weit sie zurückreicht (300 Takte)
    private string SparkAgo => Strings.CardSparkAgo(Math.Max(1, (int)Math.Round(ServerWatcher.HistoryLength * Math.Max(500, Host.Engine.Settings.IntervalMs) / 60000.0)));

    private async Task HostUnload(string hostId, string key, string model)
    {
        if (!CanWrite) return;
        var req = new ActionRequest { Action = "host.unload", Arg = hostId, Arg2 = key };
        req.Values["model"] = model;
        var r = await Web.RunAsync(req);
        if (!r.Ok) await Prompt.InformAsync(Strings.ActionFailed, r.Message, warning: true);
    }

    private async Task HostStop(string hostId, string key)
    {
        if (!CanWrite) return;
        var r = await Web.RunAsync(new ActionRequest { Action = "host.stop", Arg = hostId, Arg2 = key });
        if (!r.Ok) await Prompt.InformAsync(Strings.ActionFailed, r.Message, warning: true);
    }

    // Laufwerkswerte für die Karte: „–", wenn nicht gemessen (nie eine erfundene 0)
    private static string DiskRate(double? bytesPerSec) => bytesPerSec is double b ? DiskFormat.Rate(b) : "–";
    private static string DiskPercent(double? pct) => pct is double p ? p.ToString("0", CultureInfo.InvariantCulture) + " %" : "–";

    // (Die Messanzeigen der Hardware-Karte sind die Bausteine HwMeter und HwStack.)

    // VRAM-Vorhersage eines Profils (U6): gemessen beim letzten Lauf, sonst aus dem GGUF-Kopf geschätzt (einmal je
    // Profil im Hintergrund gelesen und gemerkt), sonst null
    private readonly Dictionary<string, double?> _need = new();
    private readonly HashSet<string> _needBusy = new();
    private double? VramNeed(Profile p, HistoryEntry? hist)
    {
        if (hist is { MaxVramGb: > 0 }) return hist.MaxVramGb;
        if (_need.TryGetValue(p.Key, out var known)) return known;
        if (_needBusy.Add(p.Key))
        {
            var args = LlamaServerArgs.Parse(p.Args, p.Env);
            var path = ServerLauncher.ResolveModel(args.Model ?? p.ModelPath, p.WorkingDir);
            _ = Task.Run(async () =>
            {
                double? gb = null;
                try
                {
                    if (path != null && Gguf.TryRead(path) is { } g)
                    {
                        int ctx = args.Ctx is > 0 ? args.Ctx.Value : (int)Math.Min(g.ContextLength ?? 4096, 131072);
                        gb = VramEstimate.Estimate(g, ctx, args.CacheTypeK, args.CacheTypeV, args.Ngl).TotalGb;
                    }
                }
                catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException) { }
                await InvokeAsync(() => { _need[p.Key] = gb; _needBusy.Remove(p.Key); StateHasChanged(); });
            });
        }
        return null;
    }

    private static string Pct(double part, double whole) =>
        (whole > 0 ? Math.Clamp(100 * part / whole, 0, 100) : 0).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private static string NameTip(Profile p, string? model) =>
        (model ?? p.Name) + (string.IsNullOrWhiteSpace(p.Note) ? "" : "\n" + p.Note);

    private Task SetRestart(Profile p, bool on) =>
        Web.RunAsync(new ActionRequest { Action = "profile.restart", Arg = p.Id.ToString("N"), Flag = on });

    private Task SetIdle(Profile p, int minutes) =>
        Web.RunAsync(new ActionRequest { Action = "profile.idleunload", Arg = p.Id.ToString("N"), Number = minutes });

    private bool _copied;

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); _copied = true; }
        catch (JSException) { _flash = text; }
        catch (InvalidOperationException) { }
        _ = Task.Delay(1500).ContinueWith(_ => InvokeAsync(() => { _copied = false; StateHasChanged(); }));
    }

    private static string BackendColor(BackendKind k) => k switch
    {
        BackendKind.Ollama => "--b-ollama", BackendKind.LmStudio => "--b-lms", BackendKind.Vllm => "--b-vllm", _ => "--b-llama",
    };

    // „12s“, „4m“, „2h“ – wie lange die Anfrage her ist
    private static string Ago(DateTime? t)
    {
        if (t == null) return Strings.FromLog;
        var d = DateTime.Now - t.Value;
        return d.TotalSeconds < 60 ? $"{Math.Max(0, (int)d.TotalSeconds)}s" : d.TotalMinutes < 60 ? $"{(int)d.TotalMinutes}m" : d.TotalHours < 24 ? $"{(int)d.TotalHours}h" : $"{(int)d.TotalDays}d";
    }

    // Verlauf desselben Servers (gleiche Befehlszeile) für „langsamer als sonst“
    private HistoryEntry? UsualFor(ServerWatcher s) =>
        string.IsNullOrEmpty(s.Info.Program) || s.Info.Args == null ? null : Host.Engine.Library.HistoryFor(s.Info.Program, s.Info.Args, s.Info.WorkingDir);

    private async Task ActArg2(string action, string arg, string arg2)
    {
        if (!CanWrite) return;
        var r = await Web.RunAsync(new ActionRequest { Action = action, Arg = arg, Arg2 = arg2 });
        if (!r.Ok) await Prompt.InformAsync(Strings.ActionFailed, r.Message, warning: true);
    }

    // Tooltip der CPU-Anzeige (U14): Auslastung je logischem Kern, vier je Zeile
    private static string? CoreTip(SystemSample sy)
    {
        if (sy.CoreLoads is not { Length: > 0 } c) return null;
        return string.Join("\n", c.Select((v, i) => $"{i,2}: {v,3:0} %").Chunk(4).Select(row => string.Join("   ", row)));
    }

    private bool Match(HistoryEntry h) => Library.Matches(h, _q);

    // Alles, was hier direkt an Engine, Proxy oder Library geht (nicht über die Aktionen), braucht dieselbe
    // Rollenprüfung wie WebActions – sonst könnte ein Viewer über die Weboberfläche doch etwas bedienen.
    private bool CanWrite => Web.CanWrite && !Host.ReadOnly;

    // Der Claude-Knopf schaltet nicht mehr selbst um: er öffnet den Client-Dialog (Schalter, Start, „Close now / Later“).
    // Auch Viewer dürfen ihn öffnen; der Dialog ist für sie nur lesend.
    private void OpenClaude()
    {
        if (Host.Engine.Clients.Get(ClaudeClient.ClientId) is { } client) Dialogs.Open(client.Id);
    }






    // Diesen Server als Ziel des Proxys (Knopf „→ Proxy" auf der Karte)
    private void Serve(ServerWatcher s)
    {
        if (!CanWrite) return;
        var choice = Host.Engine.Proxies.ServeChoices().FirstOrDefault(c => c.ServerKey == s.Key);
        Host.Engine.Proxies.SetTarget(choice.ServerKey ?? s.Key, choice.Model);
    }

    private void Edit(Profile p)
    {
        _edit = p;
        _editName = p.Name;
        _editNote = p.Note ?? "";
        _editArgs = string.Join(' ', p.Args);
    }

    private async Task SaveEdit()
    {
        if (_edit == null) return;
        var id = _edit.Id.ToString("N");
        if (_editName.Length > 0 && _editName != _edit.Name) await Act("profile.rename", id, _editName);
        if (_editNote != (_edit.Note ?? "")) await Act("profile.note", id, _editNote);
        var args = CmdLine.Split(_editArgs);
        if (!args.SequenceEqual(_edit.Args)) await ActWith("profile.args", id, ("args", _editArgs));
        _edit = null;
        _flash = Strings.SetSaved;
    }

    private async Task Remove(Profile p)
    {
        if (!await Prompt.ConfirmAsync(Strings.BtnRemove, Strings.RemoveProfileConfirm(p.Name), warning: true)) return;
        await Act("profile.remove", p.Id.ToString("N"));
        _edit = null;
    }

    // Vergessen mit Rückgängig (U8): der Eintrag verschwindet sofort aus der Liste, gelöscht wird erst nach Ablauf der Meldung
    private readonly HashSet<string> _forgetting = new();
    private string _hfilter = "all";

    // Grund für gesperrte Schreibknöpfe (Viewer oder Read-only)
    private string WriteReason => Host.ReadOnly ? Strings.ServerReadOnlyHint : Strings.ViewerOnly;

    // Hinweis ausblenden mit Rückgängig: weg ist er sofort, geschlossen wird er erst nach Ablauf der Meldung
    private bool _noticeHidden;
    private void DismissNotice()
    {
        if (!CanWrite) return;
        _noticeHidden = true;
        Toast.ShowUndo(Strings.NoticeDismissed,
            commit: async () => { await Web.RunAsync(new ActionRequest { Action = "notice.dismiss" }); await InvokeAsync(() => { _noticeHidden = false; StateHasChanged(); }); },
            undo: () => InvokeAsync(() => { _noticeHidden = false; StateHasChanged(); }));
    }

    private Task Forget(HistoryEntry h)
    {
        if (!CanWrite) return Task.CompletedTask;
        var name = h.Name.Length > 0 ? h.Name : Strings.SectionHistory;
        var key = h.Key;
        _forgetting.Add(key);
        Toast.ShowUndo(Strings.HistForgotten(name),
            commit: async () =>
            {
                var r = await Web.RunAsync(new ActionRequest { Action = "history.forget", Arg = key });
                if (!r.Ok) Toast.Show(r.Message, warn: true);
                await InvokeAsync(() => { _forgetting.Remove(key); StateHasChanged(); });
            },
            undo: () => InvokeAsync(() => { _forgetting.Remove(key); StateHasChanged(); }));
        return Task.CompletedTask;
    }

    private static string DayGroup(DateTime t) =>
        t.Date == DateTime.Today ? Strings.HistToday : t.Date == DateTime.Today.AddDays(-1) ? Strings.HistYesterday : Strings.HistOlder;

    private static string Dur(double sec) =>
        sec <= 0 ? "–" : sec < 60 ? $"{(int)sec}s" : sec < 3600 ? $"{(int)(sec / 60)}m" : (sec / 3600).ToString("0.#", CultureInfo.InvariantCulture) + "h";

    private static string EndIcon(string end) => end switch
    {
        "live" => "s-gen", "clean" => "r-ok", "crashed" => "e-crash", "lost" => "e-crash", "outside" => "e-kill", _ => "s-idle",
    };

    private async Task Start(Profile p) { if (CanWrite && await Launcher.StartProfileAsync(p)) _flash = Strings.StartingShort; }
    private async Task StartHistory(HistoryEntry h) { if (CanWrite) await Launcher.StartHistoryAsync(h); }

    // Die Details des Eintrags wie im Fenster (Bereich 8): eigene Seite, damit der Knopf im Telefon auch passt
    private void OpenDetails(HistoryEntry h) => Nav.NavigateTo("history/" + Uri.EscapeDataString(h.Key));

    // Alles, was den Server anfasst, läuft über die Aktionen (eine Engine im System, Fenster und TUI machen es genauso)
    private async Task Act(string action, string? arg = null, string? name = null)
    {
        var result = await Web.RunAsync(new ActionRequest { Action = action, Arg = arg, Name = name });
        if (!result.Ok) await Prompt.InformAsync(Strings.ActionFailed, result.Message, warning: true);
        else _flash = result.Message == "ok" ? "" : result.Message;
    }

    private async Task ActWith(string action, string arg, params (string Key, string Value)[] values)
    {
        var req = new ActionRequest { Action = action, Arg = arg };
        foreach (var (k, v) in values) req.Values[k] = v;
        var result = await Web.RunAsync(req);
        if (!result.Ok) await Prompt.InformAsync(Strings.ActionFailed, result.Message, warning: true);
    }
}
