@page "/"
@implements IDisposable
@inject EngineHost Host
@inject LaunchCoordinator Launcher
@inject WebActions Web
@inject WebPrompt Prompt
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Toasts Toast
@inject ClientDialogs Dialogs
@inject ProxyDialogs ProxyDlg
@using Stykker.Shared.Disk

@* Monitor wie im Fenster (docs/ui.md, Bereiche 2–8): Proxy, Saved, Running, GPU, System, Recent requests, History *@

@{ var e = Host.Engine; var px = e.Proxies; bool ro = Host.ReadOnly; }

@if (Host.Engine.CurrentNotice is { } nn && !_noticeHidden)
{
    <div class="card" style="margin-bottom:12px">
        <div class="row">
            <span class="pill @(nn.Alarm ? "" : "ok")">@(nn.Alarm ? Strings.NoticeAlarm : Strings.NoticeHint)</span>
            <span style="margin-left:auto;white-space:nowrap">
                @if (nn.LogFile is { Length: > 0 })
                {
                    <a class="btn" href="@($"log?path={Uri.EscapeDataString(nn.LogFile)}")">@Strings.BtnOpenLog</a>
                }
                <button disabled="@(!CanWrite)" title="@(CanWrite ? Strings.BtnDismiss : WriteReason)" @onclick="DismissNotice">@Strings.BtnDismiss</button>
            </span>
        </div>
        <div style="margin-top:6px">@nn.Text</div>
        @if (nn.LogFile is { Length: > 0 })
        {
            <div class="muted small">@Strings.ColLogFile: @nn.LogFile</div>
        }
    </div>
}

@* Zwei Spalten (docs/plan-ui-redesign.md, U3): links was läuft und was passiert ist, rechts Hardware, Profile und Proxy.
   Schmal in der Reihenfolge von docs/ui.md (Proxy, Saved, laufende Server, Hardware, Anfragen, Verlauf), umgesetzt in
   app.css (order). *@
<div class="mon">
<div class="mon-main">
<div class="mon-area mon-run">
<h3 class="sec">@Strings.SectionRunning</h3>
@if (e.Registry.Servers.Count == 0)
{
    <div class="card"><b>@Strings.NoServersTitle</b><div class="muted small">@Strings.NoServersHint</div></div>
}
@foreach (var s in e.Registry.Servers)
{
    var sv = s;
    <ServerCard Model="ServerCardModel.From(sv, e.Recorder.Sessions.FirstOrDefault(r => r.Target == sv.Key), UsualFor(sv))" CanWrite="CanWrite && !ro"
                Served="px.IsServed(sv.Key)" ProxyRunning="px.Running" SparkAgo="@SparkAgo"
                OnServe="() => Serve(sv)" OnSave='() => Act("save", sv.Key, sv.Name)'
                OnRecord='() => Act(e.Recorder.Sessions.Any(r => r.Target == sv.Key) ? "record.stop" : "record.start", sv.Key)'
                OnStop='() => Act("stop", sv.Key)'
                OnUnload='m => ActArg2("unload", sv.Key, m)' />
}

@* Server auf den Model-Hosts (docs/plan-hosts-gateway.md): dieselbe Karte mit Host-Badge; Stop geht an den Host *@
@{ var onHosts = Host.Hosts.List().Where(h => h.Connected && h.State != null).ToList(); }
@if (onHosts.Count > 0)
{
    <h3 class="sec">@Strings.SectionOnHosts</h3>
    @foreach (var h in onHosts)
    {
        var hn = h.Name.Length > 0 ? h.Name : h.Entry.Name;
        var hid = h.Entry.Id;
        @if (h.State!.Servers.Count == 0)
        {
            <div class="card hostidle"><div class="hd5"><span class="chipi host"><Icon Name="host" />@hn</span><span class="muted small">@Strings.HostsNothingRunning</span>
                @if (h.State.Gpu is { } hg) { <span class="mc" style="margin-left:auto" title="@hg.Name"><Icon Name="vram" Title="@Strings.CardVram" /><b>@hg.MemUsedGb.ToString("0.0", CultureInfo.InvariantCulture)</b><small>/@hg.MemTotalGb.ToString("0", CultureInfo.InvariantCulture) G</small></span> }
            </div></div>
        }
        @foreach (var rs in h.State.Servers)
        {
            var r = rs;
            <ServerCard Model="ServerCardModel.From(r, hid, hn)" CanWrite="CanWrite && !ro" SparkAgo="@SparkAgo"
                        OnStop="() => HostStop(hid, r.Key)" OnUnload="m => HostUnload(hid, r.Key, m)" />
        }
    }
}
</div>

<div class="mon-area mon-rec">
@* Letzte Anfragen (U7): feste Spalten mit Symbolen; Werkzeuge, Denken, Client und Ende aus der Beobachtung des Proxys *@
@{
    var finished = e.Registry.Servers.SelectMany(x => x.Finished.Select(f => (F: f, Host: (string?)null)))
        .Concat(Host.Hosts.List().Where(h => h.Connected && h.State != null)
            .SelectMany(h => h.State!.Servers.SelectMany(rs => rs.Finished.Select(f => (F: f, Host: (string?)(h.Name.Length > 0 ? h.Name : h.Entry.Name))))));
    var reqs = RequestRows.Build(finished, e.RecentProxy(), nameOf: e.Proxies.DisplayName);
    double maxSec = reqs.Count > 0 ? Math.Max(1, reqs.Max(r => r.Seconds)) : 1;
}
<div class="card">
    <div class="row"><h2 style="margin:0">@Strings.RecentRequests</h2>
        <span class="spdscale" title="@Strings.ReqSpeedScale">t/s <i class="sp1"></i><i class="sp2"></i><i class="sp3"></i><i class="sp4"></i></span></div>
    @if (reqs.Count == 0) { <span class="muted small">@Strings.NoneYet</span> }
    else
    {
        <div class="reqs">
            <div class="req head" aria-hidden="true"><span></span><span>@Strings.ReqModel</span><span>@Strings.ReqHost</span><span>@Strings.ReqTime</span><span class="r">@Strings.ReqPrompt</span><span class="r">@Strings.ReqCache</span><span class="r">t/s</span><span class="r">@Strings.ReqTokens</span><span class="c">@Strings.ReqTools</span><span class="c">@Strings.ReqThink</span><span class="c">@Strings.ReqResult</span><span class="r">@Strings.ReqAgo</span></div>
            @foreach (var r in reqs)
            {
                var kind = r.Host == null ? e.Registry.Servers.FirstOrDefault(x => x.Key == r.ServerKey)?.Kind ?? BackendKind.LlamaCpp : BackendKind.LlamaCpp;
                <div class="req">
                    <span class="cl" title="@(r.Client.Length > 0 ? r.Client : Strings.ReqClientUnknown)"><Icon Name="@("c-" + r.ClientKind)" Title="@(r.Client.Length > 0 ? r.Client : Strings.ReqClientUnknown)" /></span>
                    <span class="mdl" title="@r.Model"><i style="background:var(@BackendColor(kind))"></i><span class="mname">@r.Server</span>@if (ProxyRoutes.Label(r.Route).Length > 0) { <span class="rtag" title="@ProxyRoutes.Tip(r.Route)">@ProxyRoutes.Label(r.Route)</span> }</span>
                    <span class="hostc">@if (r.Host != null) { <span class="chipi host"><Icon Name="host" />@r.Host</span> } else { <span class="muted small">@Strings.CardLocal</span> }</span>
                    <span class="dur" title="@r.Seconds.ToString("0.0", CultureInfo.InvariantCulture) s"><span class="dbar"><i style="width:@((int)(100 * r.Seconds / maxSec))%"></i></span><small>@(r.Seconds > 0 ? r.Seconds.ToString("0", CultureInfo.InvariantCulture) + "s" : "–")</small></span>
                    <span class="r muted">@(r.PromptTps > 0 ? r.PromptTps.ToString("0", CultureInfo.InvariantCulture) : "–")</span>
                    <span class="r cache @(r.PromptReused == 0 ? "miss" : "")" title="@RequestRows.CacheTip(r.PromptReused, r.PromptRead, r.PromptReusedEstimated)">@RequestRows.CacheText(r.PromptReused)</span>
                    <span class="r spd sp@(RequestRows.SpeedLevel(r.GenTps))">@(r.GenTps > 0 ? r.GenTps.ToString("0.0", CultureInfo.InvariantCulture) : "–")</span>
                    <span class="r">@r.GenTokens.ToString("N0", CultureInfo.InvariantCulture)</span>
                    <span class="c ex @(r.Tools is > 0 ? "" : "na")" title="@(r.Tools == null ? Strings.ReqNoProxy : Strings.ReqToolsTip(r.Tools.Value))"><Icon Name="x-tool" />@(r.Tools is int t && t > 0 ? t.ToString(CultureInfo.InvariantCulture) : "–")</span>
                    <span class="c ex @(r.ThinkTokens is > 0 ? "" : "na")" title="@(r.ThinkTokens == null ? Strings.ReqNoProxy : Strings.ReqThinkTip(r.ThinkTokens.Value))"><Icon Name="x-think" />@(r.ThinkTokens is int k && k > 0 ? (k >= 1000 ? (k / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) + "k" : k.ToString(CultureInfo.InvariantCulture)) : "–")</span>
                    <span class="c res res-@r.Result" title="@Strings.ReqResultText(r.Result)"><Icon Name="@("r-" + r.Result)" Title="@Strings.ReqResultText(r.Result)" /></span>
                    <span class="r muted small">@Ago(r.Seen)</span>
                </div>
            }
        </div>
    }
</div>
</div>

<div class="mon-area mon-hist">
@* History (U8): nach Tagen gruppiert, je Lauf Laufzeit, Ø/Spitze t/s, Tokens des letzten Laufs und wie er endete;
   Suche (/ springt hinein), Filter, Aktionen als Symbole, Vergessen mit Rückgängig *@
@{
    // Ein Verlaufseintrag gilt als laufend bzw. gemerkt, wenn der Vergleichsschlüssel (Library.CompareKey) passt – für Profil,
    // Verlauf und Start dieselbe Regel
    Func<HistoryEntry, string> histKey = h => Library.CompareKey(h.Program, h.Args, h.WorkingDir);
    var runningKeys = e.Registry.Servers.Where(x => !string.IsNullOrEmpty(x.Info.Program) && x.Info.Args != null).Select(x => Library.CompareKey(x.Info.Program!, x.Info.Args!, x.Info.WorkingDir)).ToHashSet();
    var savedKeys = e.Library.Profiles.Select(p => Library.CompareKey(p.Program, p.Args, p.WorkingDir)).ToHashSet();
    var hlist = e.Library.History.Where(Match).Where(h => !_forgetting.Contains(h.Key))
        .Where(h => _hfilter == "all" || (_hfilter == "crashed" && h.LastEnd == "crashed") || (_hfilter == "running" && runningKeys.Contains(histKey(h))))
        .OrderByDescending(h => h.LastSeen).Take(40).ToList();
    double maxRun = hlist.Count > 0 ? Math.Max(1, hlist.Max(h => h.Runs > 0 ? h.TotalSeconds / h.Runs : 0)) : 1;
}
<div class="card">
    <div class="histbar">
        <h2>@Strings.SectionHistory</h2>
        <label class="search"><input id="hsearch" placeholder="@Strings.HistorySearch" @bind="_q" @bind:event="oninput" aria-label="@Strings.HistorySearch" /><span class="kbd">/</span></label>
        <span class="fchips" role="group" aria-label="@Strings.HistFilter">
            @foreach (var (f, label) in new[] { ("all", Strings.HistAll), ("running", Strings.HistRunning), ("crashed", Strings.HistCrashed) })
            {
                var ff = f;
                <button class="fchip @(_hfilter == ff ? "on" : "")" aria-pressed="@(_hfilter == ff ? "true" : "false")" @onclick="() => _hfilter = ff">@label</button>
            }
        </span>
    </div>
    @if (hlist.Count == 0)
    {
        <div class="empty"><Icon Name="timer" Class="lg" /><div><b>@(_q.Length > 0 || _hfilter != "all" ? Strings.HistNoMatch : Strings.HistEmptyTitle)</b><div class="muted small">@(_q.Length > 0 || _hfilter != "all" ? Strings.HistNoMatchHint : Strings.HistEmptyHint)</div></div></div>
    }
    <div class="hist">
        @foreach (var grp in hlist.GroupBy(h => DayGroup(h.LastSeen)))
        {
            <div class="hgrp">@grp.Key <span class="muted">@grp.Count()</span></div>
            @foreach (var h in grp)
            {
                var hh = h;
                bool live = runningKeys.Contains(histKey(h));
                bool saved = savedKeys.Contains(histKey(h));
                double avgRun = h.Runs > 0 ? h.TotalSeconds / h.Runs : 0;
                var endState = live ? "live" : h.LastEnd;
                <div class="hr">
                    <i class="hdot @(live ? "on" : "")" style="--b:var(--b-llama)"></i>
                    <div class="hname">
                        <b title="@(h.ModelPath ?? h.Name)">@(h.Name.Length > 0 ? h.Name : h.ModelPath != null ? ServerInfo.ModelName(h.ModelPath) : "?")</b>
                        <span class="muted small">@h.LastSeen.ToString(grp.Key == Strings.HistOlder ? "d.M. HH:mm" : "HH:mm", CultureInfo.InvariantCulture) · :@(h.Port?.ToString(CultureInfo.InvariantCulture) ?? "–") · @h.Runs×@(h.MaxVramGb > 0 ? " · " + h.MaxVramGb.ToString("0.0", CultureInfo.InvariantCulture) + " GB VRAM" : "")@(h.MaxRamGb > 0 ? " · " + Strings.HistRam(h.MaxRamGb) : "")</span>
                    </div>
                    <span class="mc @(h.Ctx == null ? "na" : "")" title="@Strings.CardCtx"><Icon Name="ctx" Title="@Strings.CardCtx" /><b>@(h.Ctx is int c ? (c / 1024).ToString(CultureInfo.InvariantCulture) : "–")</b>@if (h.Ctx != null) { <small>k</small> }</span>
                    <span class="hrun" title="@Strings.HistRunTip(avgRun, h.TotalSeconds)"><span class="dbar"><i style="width:@((int)(100 * avgRun / maxRun))%"></i></span><small>@Dur(avgRun)</small></span>
                    <span class="htps" title="@Strings.HistTpsTip"><b class="sp@(RequestRows.SpeedLevel(h.MeanTps))">@(h.MeanTps > 0 ? h.MeanTps.ToString("0.0", CultureInfo.InvariantCulture) : "–")</b><small> / @(h.BestTps > 0 ? h.BestTps.ToString("0.0", CultureInfo.InvariantCulture) : "–")</small></span>
                    <span class="mc @(h.LastRunTokens > 0 ? "" : "na")" title="@Strings.HistTokensTip"><Icon Name="sum" Title="@Strings.CardSum" /><b>@(h.LastRunTokens > 0 ? (h.LastRunTokens / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) : "–")</b>@if (h.LastRunTokens > 0) { <small>k</small> }</span>
                    <span class="hend end-@(endState.Length > 0 ? endState : "none")" title="@Strings.HistEndText(endState, h.LastEndAt)"><Icon Name="@EndIcon(endState)" Title="@Strings.HistEndText(endState, h.LastEndAt)" /></span>
                    <span class="hacts">
                        <button class="ib quiet" disabled="@(ro || !CanWrite || live)" title="@(CanWrite ? Strings.BtnStartAgain : WriteReason)" aria-label="@Strings.BtnStartAgain" @onclick="() => StartHistory(hh)"><Icon Name="play" /></button>
                        @* Gemerkt: der Knopf zeigt es an und ist gesperrt (ein zweites Merken würde nur ein Duplikat anlegen) *@
                        <button class="ib quiet @(saved ? "saved" : "")" disabled="@(ro || !CanWrite || saved)" title="@(saved ? Strings.BtnSaved : CanWrite ? Strings.CardSave : WriteReason)" aria-label="@(saved ? Strings.BtnSaved : Strings.CardSave)" @onclick='() => Act("profile.add-history", hh.Key, hh.Name)'><Icon Name="save" /></button>
                        <button class="ib quiet" title="@Strings.BtnDetails" aria-label="@Strings.BtnDetails" @onclick="() => OpenDetails(hh)"><Icon Name="info" /></button>
                        <button class="ib quiet danger" disabled="@(ro || !CanWrite)" title="@(CanWrite ? Strings.BtnForget : WriteReason)" aria-label="@Strings.BtnForget" @onclick="() => Forget(hh)"><Icon Name="trash" /></button>
                    </span>
                </div>
            }
        }
    </div>
</div>
</div>
</div>
<aside class="mon-side">
@* Hardware (U5): GPU und System in einer Karte, je Programm als gestapelter Balken mit Legende; Details auf /gpu.
   Aussehen und Markup: die Hardware-Bausteine des Design-Systems (hw-*), dieselben wie in StykkerSYS. *@
@if (e.Gpu != null || e.Sys != null || e.Disks != null)
{
    <div class="mon-area mon-hw">
    <h3 class="sec">@Strings.SectionHardware</h3>
    <section class="hw-card">
        @if (e.Gpu is { } g)
        {
            <div class="hw-head">@Strings.Gpu <span class="hw-sub">@g.Name · @g.MemTotalGb.ToString("0", CultureInfo.InvariantCulture) GB</span><a class="hw-more" href="gpu" title="@Strings.GpuDetails">@Strings.HwDetails <Icon Name="open" /></a></div>
            <div class="hw-meters">
                <HwMeter Label="@Strings.GpuLoad" Value="@g.Util.ToString("0", CultureInfo.InvariantCulture)" Unit="%" Fraction="@(g.Util / 100)" />
                <HwMeter Label="@Strings.GpuVram" Value="@g.MemUsedGb.ToString("0.0", CultureInfo.InvariantCulture)" Unit="@("/ " + g.MemTotalGb.ToString("0", CultureInfo.InvariantCulture) + " GB")" Fraction="@(g.MemUsedGb / Math.Max(1, g.MemTotalGb))" Note="@Strings.HwFree(Math.Max(0, g.MemTotalGb - g.MemUsedGb))" />
                <HwMeter Label="@Strings.GpuPower" Value="@g.PowerW.ToString("0", CultureInfo.InvariantCulture)" Unit="@("/ " + g.PowerLimitW.ToString("0", CultureInfo.InvariantCulture) + " W")" Fraction="@(g.PowerW / Math.Max(1, g.PowerLimitW))" />
                <HwMeter Label="@Strings.GpuTemp" Value="@g.TempC.ToString("0", CultureInfo.InvariantCulture)" Unit="°C" Fraction="@Math.Clamp(g.TempC / 90.0, 0, 1)" Note="@(g.Throttled ? g.ThrottleText() : Strings.GpuClocksFree)" NoteWarn="@g.Throttled" />
            </div>
            <div class="hw-subh">@Strings.GpuConsumers</div>
            <HwStack Items="e.VramTop" UsedGb="g.MemUsedGb" TotalGb="g.MemTotalGb" MoreHref="gpu" />
        }
        @if (e.Sys is { } sy)
        {
            <div class="hw-head @(e.Gpu != null ? "hw-sep" : "")">@Strings.SystemCard
                @if (e.Memory is { } mem)
                {
                    <span class="hw-sub" title="@Strings.HwMemTip(mem.Modules, mem.TotalGb, mem.Channels)">@mem.Short · @mem.Modules×@((mem.TotalGb / Math.Max(1, mem.Modules)).ToString("0", CultureInfo.InvariantCulture)) GB · ≈@mem.BandwidthGbs.ToString("0", CultureInfo.InvariantCulture) GB/s</span>
                }
            </div>
            <div class="hw-meters">
                <HwMeter Label="@Strings.CpuLoad" Value="@sy.CpuPercent.ToString("0", CultureInfo.InvariantCulture)" Unit="%" Fraction="@(sy.CpuPercent / 100)" Note="@Strings.LogicalCores(sy.Cores)" Tip="@CoreTip(sy)" />
                <HwMeter Label="@Strings.Memory" Value="@sy.RamUsedGb.ToString("0.0", CultureInfo.InvariantCulture)" Unit="@("/ " + sy.RamTotalGb.ToString("0", CultureInfo.InvariantCulture) + " GB")" Fraction="@sy.RamFrac" Note="@Strings.HwFree(Math.Max(0, sy.RamTotalGb - sy.RamUsedGb))" />
            </div>
            @if (sy.CoreLoads is { Length: > 0 } cores)
            {
                <div class="hw-cores" title="@CoreTip(sy)">@foreach (var c in cores) { <i style="--h:@Math.Max(2, c).ToString("0.#", CultureInfo.InvariantCulture)%"></i> }</div>
            }
            @if (e.RamTop.Count > 0)
            {
                <div class="hw-subh">@Strings.RamConsumers</div>
                <HwStack Items="e.RamTop" UsedGb="sy.RamUsedGb" TotalGb="sy.RamTotalGb" />
            }
        }
    </section>
    @* Laufwerke (Stykker.Shared/Disk): je Volume Belegung, Lesen, Schreiben, Auslastung; Hinweis, wenn ein Modellserver stark liest *@
    @if (e.Disks is { } dk && dk.Volumes.Count > 0)
    {
        var hints = DiskHints.Lines(DiskHints.ServersOf(e.Servers), e.DiskProcesses, dk.Volumes);
        <section class="hw-card">
            <div class="hw-head">@Strings.DisksCard <span class="hw-sub">@dk.Volumes.Count @Strings.DisksVolumes</span><a class="hw-more" href="disks" title="@Strings.DisksPageTitle">@Strings.DisksDetails <Icon Name="open" /></a></div>
            @foreach (var v in dk.Volumes)
            {
                double used = v.TotalBytes > 0 ? Math.Clamp(v.UsedBytes / v.TotalBytes, 0, 1) : 0;
                <div class="hw-vol">
                    <div class="hw-vol-top">
                        <span class="hw-letter">@v.Letter:</span>
                        <span class="hw-kind" data-k="@v.Kind" title="@DiskKinds.Label(v.Kind)">@DiskKinds.Label(v.Kind)</span>
                        <span class="hw-free" title="@v.Label">@DiskFormat.Size(v.FreeBytes) @Strings.DisksFree · @DiskFormat.Size(v.TotalBytes)</span>
                    </div>
                    <div class="hw-bar"><i style="--w:@((int)(used * 100))%"></i></div>
                    <div class="hw-io">
                        <span>@Strings.DisksRead <b>@DiskRate(v.ReadBytesPerSec)</b></span>
                        <span>@Strings.DisksWrite <b>@DiskRate(v.WriteBytesPerSec)</b></span>
                        <span>@Strings.DisksBusy <b>@DiskPercent(v.BusyPercent)</b></span>
                    </div>
                </div>
            }
            @foreach (var line in hints)
            {
                <div class="hw-hint">@line</div>
            }
        </section>
    }
    </div>
}

<div class="mon-area mon-saved">
<h3 class="sec">@Strings.SectionSaved</h3>
@* Profile als Kacheln (U6): Backend-Streifen, sechs feste Symbole, laufend = leuchtet mit Live-t/s, darunter die
   VRAM-Vorhersage (gemessen oder aus dem GGUF-Kopf geschätzt) gegen den freien Grafikspeicher *@
<div class="card pf-card">
    @if (e.Library.Profiles.Count == 0) { <span class="muted small">@Strings.SavedEmpty</span> }
    <div class="pfs">
        @foreach (var p in e.Library.Profiles)
        {
            var pr = p;
            var a = LlamaServerArgs.Parse(p.Args);
            var running = Launcher.RunningFor(p); var starting = Launcher.StartingFor(p);
            var hist = e.Library.HistoryOf(p);
            var need = VramNeed(p, hist);
            double? free = e.Gpu is { } fg && fg.MemTotalGb > 0 ? Math.Max(0, fg.MemTotalGb - fg.MemUsedGb) : null;
            bool tight = running == null && need is double nd && free is double fr && nd > fr;
            bool draft = p.Args.Any(x => x is "-md" or "--model-draft" or "--hf-repo-draft" or "-hfd");
            <div class="pf @(running != null ? "on" : "") @(starting != null ? "starting" : "") @(tight ? "tight" : "")" style="--b:var(--b-llama)">
                <div class="pf-hd">
                    <span class="bk" title="llama.cpp"><Icon Name="b-llama" Title="llama.cpp" /></span>
                    <span class="name" title="@NameTip(p, a.Model)">@p.Name</span>
                    <span class="st" data-s="@(running != null ? (running.Current > 0 ? "gen" : "idle") : starting != null ? "load" : "off")" title="@(running != null ? Strings.RunningTag : starting != null ? Strings.StartingShort : Strings.CardStateOff)">
                        <Icon Name="@(running != null ? (running.Current > 0 ? "s-gen" : "s-idle") : starting != null ? "s-load" : "s-off")" Class="@(starting != null ? "spin" : null)" />
                    </span>
                    <span class="pf-tps @(running == null ? "na" : "")" title="@Strings.ColTps"><b>@(running != null ? running.Current.ToString("0.0", CultureInfo.InvariantCulture) : hist is { BestTps: > 0 } ? hist.BestTps.ToString("0.0", CultureInfo.InvariantCulture) : "–")</b><small>@(running != null ? "t/s" : "best")</small></span>
                </div>
                <div class="pf-grid">
                    <span class="mc @(a.Ctx == null ? "na" : "")" title="@Strings.CardCtx"><Icon Name="ctx" Title="@Strings.CardCtx" /><b>@(a.Ctx is int c ? (c / 1024).ToString(CultureInfo.InvariantCulture) : "–")</b>@if (a.Ctx != null) { <small>k</small> }</span>
                    <span class="mc @(a.NglRaw == null ? "na" : "")" title="@Strings.PfNgl"><Icon Name="layers" Title="@Strings.PfNgl" /><b>@(a.NglRaw ?? "–")</b></span>
                    <span class="mc @(p.Port == null ? "na" : "")" title="@Strings.CardPort(p.Port ?? 0)"><Icon Name="port" Title="Port" /><b>@(p.Port?.ToString(CultureInfo.InvariantCulture) ?? "–")</b></span>
                    <span class="mc @(p.UnloadAfterIdleMin == 0 ? "na off" : "")" title="@(p.UnloadAfterIdleMin == 0 ? Strings.IdleUnloadOff : Strings.IdleUnloadSet(p.UnloadAfterIdleMin))"><Icon Name="timer" Title="@Strings.PfIdle" /><b>@(p.UnloadAfterIdleMin == 0 ? "–" : p.UnloadAfterIdleMin + "m")</b></span>
                    <span class="mc @(draft ? "" : "na off")" title="@(draft ? Strings.PfDraftOn : Strings.PfDraftOff)"><Icon Name="draft" Title="@Strings.CardDraft" /><b>@(draft ? Strings.PfOn : "–")</b></span>
                    <span class="mc @(p.RestartOnCrash ? "" : "na off")" title="@(p.RestartOnCrash ? Strings.PfRestartOn : Strings.PfRestartOff)"><Icon Name="restart" Title="@Strings.PfRestart" /><b>@(p.RestartOnCrash ? Strings.PfOn : "–")</b></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(p.Note)) { <div class="pf-note muted small" title="@p.Note">@p.Note</div> }
                @if (starting != null)
                {
                    <div class="pf-launch @(starting.State == LaunchState.Failed ? "failed" : "")">
                        <Icon Name="@(starting.State == LaunchState.Failed ? "e-crash" : "s-load")" Class="@(starting.State == LaunchState.Failed ? null : "spin")" />
                        <span class="small">@(starting.State == LaunchState.Failed ? (starting.FailureReason ?? Strings.PfStartFailed) : Strings.PfStartingFor((int)(DateTime.Now - starting.Started).TotalSeconds))</span>
                        @if (starting.LogFile.Length > 0) { <a class="btn ib" href="@($"log?path={Uri.EscapeDataString(starting.LogFile)}")" title="@Strings.BtnOpenLog" aria-label="@Strings.BtnOpenLog"><Icon Name="file" /></a> }
                        @if (CanWrite && !ro)
                        {
                            var lid = starting.Id.ToString();
                            @if (starting.State == LaunchState.Failed)
                            {
                                <button class="ib" title="@Strings.BtnDismiss" aria-label="@Strings.BtnDismiss" @onclick='() => Act("launch.dismiss", lid)'><Icon Name="x" /></button>
                            }
                            else
                            {
                                <button class="ib danger" title="@Strings.PfCancelStart" aria-label="@Strings.PfCancelStart" @onclick='() => Act("launch.stop", lid)'><Icon Name="stop" /></button>
                            }
                        }
                    </div>
                }
                @* Zwei Balken: VRAM (Vorhersage gegen freien Grafikspeicher) und RAM (höchster gemerkter Bedarf mit Kindprozessen
                   gegen freien RAM). „needs“ = höchster Wert aus früheren Läufen (sonst Schätzung), „free“ = jetzt frei; rot, wenn needs > free *@
                @if (running == null && need is double needGb && free is double freeGb)
                {
                    <div class="pf-fc @(needGb > freeGb ? "warn" : "")" title="@Strings.PfForecastTip(needGb, freeGb, hist is { MaxVramGb: > 0 })">
                        <Icon Name="vram" Title="VRAM" />
                        <span class="fc-bar"><i class="free" style="width:@Pct(freeGb, Math.Max(needGb, freeGb))"></i><i class="need" style="width:@Pct(needGb, Math.Max(needGb, freeGb))"></i></span>
                        <span class="fc-txt">@Strings.PfNeedsFree(needGb, freeGb)</span>
                    </div>
                }
                @if (running == null && hist is { MaxRamGb: > 0 } rh && e.Sys is { } ramSys)
                {
                    double ramNeed = rh.MaxRamGb, ramFree = Math.Max(0, ramSys.RamTotalGb - ramSys.RamUsedGb);
                    <div class="pf-fc ram @(ramNeed > ramFree ? "warn" : "")" title="@Strings.PfRamForecastTip(ramNeed, ramFree)">
                        <Icon Name="ram" Title="@Strings.RowRamMax" />
                        <span class="fc-bar"><i class="free" style="width:@Pct(ramFree, Math.Max(ramNeed, ramFree))"></i><i class="need" style="width:@Pct(ramNeed, Math.Max(ramNeed, ramFree))"></i></span>
                        <span class="fc-txt">@Strings.PfNeedsFree(ramNeed, ramFree)</span>
                    </div>
                }
                <div class="pf-act">
                    @if (running != null)
                    {
                        <a class="btn ib" href="@($"prompt?server={Uri.EscapeDataString(running.Key)}")" title="@Strings.PromptTitle" aria-label="@Strings.PromptTitle"><Icon Name="chat" /></a>
                        <button class="ib danger" disabled="@(ro || !CanWrite)" title="@(CanWrite ? Strings.CardStop : Strings.ViewerOnly)" aria-label="@Strings.CardStop" @onclick='() => Act("stop", running.Key)'><Icon Name="stop" /></button>
                    }
                    else if (starting == null)
                    {
                        <button class="ib txt primary" disabled="@(ro || !CanWrite)" title="@(CanWrite ? StartTip(p) : Strings.ViewerOnly)" @onclick="() => Start(pr)"><Icon Name="play" />@Strings.BtnStart</button>
                    }
                    <details class="pf-cmd">
                        <summary title="@Strings.PfCmdLine">@Strings.PfCmdLine</summary>
                        <code>@p.Program @string.Join(" ", p.Args)</code>
                    </details>
                    @if (CanWrite && !ro)
                    {
                    <details class="menu" style="margin-left:auto">
                        <summary title="@Strings.BtnMore" aria-label="@Strings.BtnMore"><Icon Name="more" /></summary>
                        <div>
                            <a href="@($"bench?target={p.Id:N}")">@Strings.BtnBench</a>
                            <button @onclick="() => Edit(pr)">@Strings.BtnEdit</button>
                            <button @onclick="() => SetRestart(pr, !pr.RestartOnCrash)">@(p.RestartOnCrash ? Strings.PfRestartTurnOff : Strings.PfRestartTurnOn)</button>
                            <span class="grp">@Strings.PfIdle</span>
                            <div class="seg">
                                @foreach (var min in new[] { 0, 15, 30, 60 })
                                {
                                    var mm = min;
                                    <button class="@(p.UnloadAfterIdleMin == mm ? "on" : "")" @onclick="() => SetIdle(pr, mm)">@(mm == 0 ? Strings.PfOff : mm + "m")</button>
                                }
                            </div>
                            <button class="bad" @onclick="() => Remove(pr)">@Strings.BtnRemove</button>
                        </div>
                    </details>
                    }
                </div>
            </div>
        }
    </div>
    @if (_edit != null)
    {
        <div style="margin-top:12px;border-top:1px solid var(--line);padding-top:10px">
            <div class="row"><b>@Strings.BtnEdit</b> <span class="muted small">@_edit.Name</span>
                <span style="margin-left:auto"><button class="good" disabled="@ro" @onclick="SaveEdit">@Strings.BtnSaved</button> <button @onclick="() => _edit = null">@Strings.Close</button></span></div>
            <div class="row" style="margin-top:8px">
                <input placeholder="@Strings.FieldName" @bind="_editName" @bind:event="oninput" style="flex:1" />
                <input placeholder="@Strings.FieldNote" @bind="_editNote" @bind:event="oninput" style="flex:1" />
            </div>
            <textarea @bind="_editArgs" @bind:event="oninput" rows="3" style="width:100%;margin-top:8px;font-family:Consolas,monospace"></textarea>
        </div>
    }
</div>
</div>

<div id="proxy" class="mon-proxy">
@* Proxy-Karte (nur Information): an/aus, Adresse zum Kopieren, Ziel, Port, LAN, Quellen, Prüfmodell. Eingaben und Schalter
   stehen im Proxy-Dialog – über das Zahnrad hier oder einen Klick auf den Proxy-Chip in der Kopfleiste. *@
@{ var models = px.Choices(); var baseUrl = ProxyPanel.BaseUrl(px); var cd = e.Claude; int machines = px.RemoteStates().Count, clouds = px.ProviderStates().Count; var routes = e.RouteCounts.Snapshot(); }
<h3 class="sec">@Strings.PxTitle</h3>
<div class="card pxp @(px.Running ? "on" : "")">
