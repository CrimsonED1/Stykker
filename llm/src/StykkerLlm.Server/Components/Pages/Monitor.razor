        }
        <button class="ib quiet pxp-gear" title="@Strings.PxSettings" aria-label="@Strings.PxSettings" aria-haspopup="dialog" @onclick="() => ProxyDlg.Open()"><Icon Name="wrench" /></button>
    </div>
    @if (_flash.Length > 0) { <div class="small pxp-flash">@_flash</div> }

    <div class="pxp-row">
        <span class="pxp-l">@Strings.PxTarget</span>
        <span class="pxp-v">@px.TargetName()</span>
