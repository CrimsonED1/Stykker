@page "/gpu"
@implements IDisposable
@inject EngineHost Host

@* GPU-Details (docs/ui.md, Bereich 5): Auslastung, Takte, Engines, Programme mit VRAM und Auslastung, Verlauf.
   Aussehen und Markup: die Hardware-Bausteine des Design-Systems (hw-*), dieselben wie in StykkerSYS. *@

@{ var e = Host.Engine; var g = e.Gpu; }

<div class="hw-head">
    <span>@Strings.GpuDetails</span>
    <a class="hw-more" href="">@Strings.BackToMonitor</a>
</div>

@if (g == null)
{
    <section class="hw-card"><span class="hw-sub">@Strings.NvmlMissing</span></section>
}
else
{
    <section class="hw-card">
        <div class="hw-head">@g.Name <span class="hw-sub">@g.MemTotalGb.ToString("0", CultureInfo.InvariantCulture) GB</span></div>
        <div class="hw-meters">
            <HwMeter Label="@Strings.GpuLoad" Value="@g.Util.ToString("0", CultureInfo.InvariantCulture)" Unit="%" Fraction="@(g.Util / 100)" />
            <HwMeter Label="@Strings.GpuVram" Value="@g.MemUsedGb.ToString("0.0", CultureInfo.InvariantCulture)" Unit="@("/ " + g.MemTotalGb.ToString("0", CultureInfo.InvariantCulture) + " GB")" Fraction="@(g.MemUsedGb / Math.Max(1, g.MemTotalGb))" Note="@Strings.HwFree(Math.Max(0, g.MemFreeGb))" />
            <HwMeter Label="@Strings.GpuPower" Value="@g.PowerW.ToString("0", CultureInfo.InvariantCulture)" Unit="@("/ " + g.PowerLimitW.ToString("0", CultureInfo.InvariantCulture) + " W")" Fraction="@(g.PowerW / Math.Max(1, g.PowerLimitW))" />
            <HwMeter Label="@Strings.GpuTemp" Value="@g.TempC.ToString("0", CultureInfo.InvariantCulture)" Unit="°C" Fraction="@Math.Clamp(g.TempC / 90.0, 0, 1)" Note="@(g.Throttled ? Strings.GpuClocksLimited + ": " + g.ThrottleText() : Strings.GpuClocksFree)" NoteWarn="@g.Throttled" Tip="@g.ThrottleText()" />
        </div>
        <div class="hw-scroll">
            <table class="hw-table">
                <tr><th>@Strings.ColProperty</th><th class="num">@Strings.ColValue</th></tr>
                <tr><td>@Strings.GpuGfxClock</td><td class="num">@Mhz(g.GfxMhz) / @Mhz(g.GfxMaxMhz)</td></tr>
                <tr><td>@Strings.GpuMemClock</td><td class="num">@Mhz(g.MemMhz) / @Mhz(g.MemMaxMhz)</td></tr>
                <tr><td>@Strings.GpuVram</td><td class="num">@g.MemUtil.ToString("0", CultureInfo.InvariantCulture) % · @Strings.VramFree @g.MemFreeGb.ToString("0.0", CultureInfo.InvariantCulture) GB</td></tr>
                <tr><td>@Strings.GpuThrottling</td><td class="num">@g.ThrottleText()</td></tr>
            </table>
        </div>
    </section>

    <section class="hw-card">
        <div class="hw-head">@Strings.GpuEngines</div>
        <p class="hw-sub hw-hint-line">@Strings.GpuEnginesHint</p>
        @if (_engines.Count == 0)
        {
            <span class="hw-sub">@Strings.GpuEnginesNone</span>
        }
        else
        {
            <div class="hw-meters">
                @foreach (var (engine, pct) in _engines)
                {
                    <HwMeter Label="@engine" Value="@pct.ToString("0", CultureInfo.InvariantCulture)" Unit="%" Fraction="@(pct / 100)" />
                }
            </div>
        }
    </section>

    <section class="hw-card">
        <div class="hw-head">@Strings.GpuConsumers</div>
        <p class="hw-sub hw-hint-line">@Strings.GpuDetailsHint</p>
        @if (_rows.Count == 0)
        {
            <span class="hw-sub">@Strings.GpuDetailsNoData</span>
        }
        else
        {
            <div class="hw-scroll">
                <table class="hw-table">
                    <tr><th>@Strings.ColProcess</th><th class="num">@Strings.ColGpuUtil</th><th class="num">@Strings.ColVramUsed</th></tr>
                    @foreach (var (name, gb, pct) in _rows)
                    {
                        <tr>
                            <td class="hw-name" title="@name">@name</td>
                            <td class="num @(pct >= 50 ? "good-text" : "")">@(pct > 0 ? pct.ToString("0", CultureInfo.InvariantCulture) + " %" : "–")</td>
                            <td class="num">@gb.ToString("0.0", CultureInfo.InvariantCulture) GB</td>
                        </tr>
                    }
                </table>
            </div>
        }
    </section>

    <section class="hw-card">
        <div class="hw-head">@Strings.GpuHistoryTitle</div>
        <p class="hw-sub hw-hint-line">@Strings.GpuHistoryHint</p>
        @{ var points = e.GpuHistory.Points(); }
        @if (points.Count < 2)
        {
            <span class="hw-sub">@Strings.GpuHistoryNone</span>
        }
        else
        {
            var util = points.Select(p => (double?)p.Util).ToList();
            var vram = points.Select(p => (double?)p.MemUsedGb).ToList();
            var power = points.Select(p => (double?)p.PowerW).ToList();
            var temp = points.Select(p => (double?)p.TempC).ToList();
            <div class="hw-sparks">
                <div>
                    <div class="hw-spark-hd">@Strings.GpuSparkUtil · max 100 %</div>
                    <svg class="hw-spark" viewBox="0 0 300 70" preserveAspectRatio="none"><polyline class="line" fill="none" points="@Sparkline.Points(util, 100)" /></svg>
                </div>
                <div>
                    <div class="hw-spark-hd">@Strings.GpuSparkVram · max @g.MemTotalGb.ToString("0", CultureInfo.InvariantCulture) GB</div>
                    <svg class="hw-spark" viewBox="0 0 300 70" preserveAspectRatio="none"><polyline class="line second" fill="none" points="@Sparkline.Points(vram, Math.Max(1, g.MemTotalGb))" /></svg>
                </div>
                <div>
                    <div class="hw-spark-hd">@Strings.GpuSparkPower · max @g.PowerLimitW.ToString("0", CultureInfo.InvariantCulture) W</div>
                    <svg class="hw-spark" viewBox="0 0 300 70" preserveAspectRatio="none"><polyline class="line" fill="none" points="@Sparkline.Points(power, Math.Max(1, g.PowerLimitW))" /></svg>
                </div>
                <div>
                    <div class="hw-spark-hd">@Strings.GpuSparkTemp · max 90 °C</div>
                    <svg class="hw-spark" viewBox="0 0 300 70" preserveAspectRatio="none"><polyline class="line warn" fill="none" points="@Sparkline.Points(temp, 90)" /></svg>
                </div>
            </div>
        }
    </section>
}

@code {
    private Timer? _t;
    private List<(string Name, double Gb, double Pct)> _rows = new();
    private List<(string Engine, double Percent)> _engines = new();

    protected override void OnInitialized()
    {
        Read();
        _t = new Timer(_ => InvokeAsync(() => { Read(); StateHasChanged(); }), null, 1000, 1000);
    }

    public void Dispose() => _t?.Dispose();

    // Alle Programme, nicht nur die gemessenen Server (wie im Fenster)
    private void Read()
    {
        var platform = Host.Engine.Platform;
        var mem = platform.ReadGpuTop(64) ?? Array.Empty<(string Name, double Gb)>();
        var reading = platform.ReadGpuUtil();
        var util = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        foreach (var (n, pct) in reading?.Processes ?? Array.Empty<(string Name, double Percent)>()) util[n] = pct;
        var byName = new Dictionary<string, (double Gb, double Pct)>(StringComparer.OrdinalIgnoreCase);
        foreach (var (n, gb) in mem) byName[n] = (gb, util.TryGetValue(n, out var p) ? p : 0);
        foreach (var (n, pct) in util) if (!byName.ContainsKey(n)) byName[n] = (0, pct);
        _rows = byName.Select(kv => (kv.Key, kv.Value.Gb, kv.Value.Pct))
                      .OrderByDescending(x => x.Gb).ThenByDescending(x => x.Pct).ToList();
        _engines = reading?.Engines.ToList() ?? new();
    }

    private static string Mhz(double mhz) => mhz > 0 ? mhz.ToString("N0", CultureInfo.InvariantCulture) + " MHz" : "–";
}
