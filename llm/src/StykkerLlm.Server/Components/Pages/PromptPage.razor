@page "/prompt"
@rendermode InteractiveServer
@inject EngineHost Host
@inject ViewerSession Viewer
@inject IJSRuntime JS
@implements IDisposable

@* Mini-Harness: ein geladenes Modell direkt anprompten (Knopf „Prompt“ an der Serverkarte). Das Gespräch gehört
   dieser Browser-Sitzung; der Server merkt sich nichts davon. *@
<h2>@Strings.PromptTitle</h2>
<p class="muted small">@Strings.PromptHint</p>

@if (!Viewer.Known)
{
    <p class="muted small">@Strings.RemoteCheckRole</p>
}
else if (!Viewer.CanWrite)
{
    <div class="card"><p class="muted small">@Strings.ViewerOnly</p></div>
}
else
{
    <div class="grid2">
        <div class="card">
            <div class="chat">
                @if (_session.Turns.Count == 0 && !_session.Busy)
                {
                    <p class="muted small chat-empty">@Strings.ChatEmpty</p>
                }
                @{ int turnNo = 0; }
                @foreach (var t in _session.Turns)
                {
                    var no = turnNo++;
                    if (t.Role == "tool")
                    {
                        <div class="turn tool"><div class="msg tool-out">@Cut(t.Content)</div></div>
                    }
                    else if (t.ToolCalls is { Count: > 0 } calls)
                    {
                        <div class="turn assistant">
                            @if (t.Content.Length > 0) { <div class="msg md-msg"><ChatText Text="@t.Content" /></div> }
                            @foreach (var c in calls) { <div class="msg tool-call">⚙ @c.Summary</div> }
                        </div>
                    }
                    else if (t.Role == "assistant")
                    {
                        @* Antwort als Markdown; darunter die Messwerte und Kopieren (der Text so, wie das Modell ihn schrieb) *@
                        var answer = t.Content;
                        <div class="turn assistant">
                            <div class="who">@Strings.PromptModelSays</div>
                            <div class="msg md-msg"><ChatText Text="@answer" /></div>
                            <div class="turn-ft">
                                @if (t.Stats is { Length: > 0 } st) { <span class="muted small">@st</span> }
                                <button class="ib quiet txt" title="@Strings.ChatCopyAnswer" aria-label="@Strings.ChatCopyAnswer" @onclick="() => CopyText(answer, no)">
                                    <Icon Name="@(_copiedTurn == no ? "r-ok" : "file")" />@(_copiedTurn == no ? Strings.ChatCopied : Strings.ChatCopy)</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="turn @t.Role"><div class="who">@Strings.PromptYou</div><div class="msg">@t.Content</div></div>
                    }
                }
                @if (_session.Waiting is { } w)
                {
                    <div class="approve">
                        <div class="small"><b>@Strings.ToolApproveTitle</b></div>
                        <div class="msg tool-call">⚙ @w.Summary</div>
                        <pre class="small">@w.Arguments</pre>
                        <button class="good" @onclick="() => Answer(true)">@Strings.BtnAllow</button>
                        <button class="bad" @onclick="() => Answer(false)">@Strings.BtnRefuse</button>
                    </div>
                }
                @if (_session.Busy && _session.Waiting == null)
                {
                    <div class="turn assistant">
                        <div class="who">@Strings.PromptModelSays …</div>
                        @if (_session.LiveReasoning.Length > 0) { <div class="msg think">@_session.LiveReasoning</div> }
                        <div class="msg md-msg"><ChatText Text="@_session.LiveText" /></div>
                    </div>
                }
                else if (_session.Last is { } last)
                {
                    @if (last.Reasoning.Trim().Length > 0)
                    {
                        <details class="small"><summary class="muted">@Strings.PromptThinking</summary><div class="msg think">@last.Reasoning</div></details>
                    }
                    @if (!last.Ok)
                    {
                        <p class="small warn">@last.Error</p>
                        @if (_restored) { <p class="small muted">@Strings.ChatRestored</p> }
                    }
                }
            </div>
            <textarea class="prompt-in" rows="3" aria-label="@Strings.PromptInput" @bind="_input" @bind:event="oninput" @onkeydown="Key" placeholder="@Strings.PromptInput"></textarea>
            <div class="row" style="margin-top:8px">
                @if (_session.Busy)
                {
                    <button class="bad" @onclick="Stop">@Strings.BtnStopAnswer</button>
                }
                else
                {
                    <button class="good" disabled="@(!CanSend || _input.Trim().Length == 0)" @onclick="Send">@Strings.BtnSend</button>
                }
                <button disabled="@_session.Busy" @onclick="Clear">@Strings.BtnClear</button>
                @if (_session.Turns.Count > 0)
                {
                    <button class="ib quiet txt" style="margin-left:auto" title="@Strings.ChatCopyAllTip" aria-label="@Strings.ChatCopyAllTip"
                            @onclick="() => CopyText(ChatMarkdown.Conversation(_session.Turns), -2)"><Icon Name="@(_copiedTurn == -2 ? "r-ok" : "file")" />@(_copiedTurn == -2 ? Strings.ChatCopied : Strings.ChatCopyAll)</button>
                }
            </div>
            @if (_proxyMsg.Length > 0) { <p class="small warn">@_proxyMsg</p> }
        </div>

        <div class="card opts">
            <label for="pr-server">@Strings.ColServer</label>
            <select id="pr-server" @bind="ServerKey">
                @foreach (var s in Servers) { <option value="@s.Key">@s.Name · @s.Url.Replace("http://", "")</option> }
                <optgroup label="@Strings.PromptViaGroup">
                    @foreach (var o in ProxyOptions) { <option value="@o.Value">@o.Label</option> }
                </optgroup>
            </select>
            @if (IsVia) { <p class="muted small">@Strings.PromptViaHint</p> }
            @if (Servers.Count == 0 && !IsVia) { <p class="small warn">@Strings.PromptNoServer</p> }
            <label for="pr-model">@Strings.PromptModel</label>
            <input id="pr-model" @bind="_session.Options.Model" />
            <label style="color:var(--ink);margin-top:14px"><input type="checkbox" @bind="ToolsOn" /> @Strings.PromptToolsOn</label>
            @if (_tools)
            {
                <label for="pr-workdir">@Strings.PromptWorkdir</label>
                <div class="row" style="flex-wrap:nowrap">
                    <input id="pr-workdir" @bind="Workdir" placeholder="C:\…" style="flex:1;min-width:0" />
                    <button @onclick="OpenPicker">@Strings.PromptChooseFolder</button>
                </div>
                @if (_picker is { } pick)
                {
                    <div style="border:1px solid var(--card-border);border-radius:var(--radius);padding:8px;margin-top:8px">
                        <div class="row" style="flex-wrap:nowrap">
                            <button title="@Strings.PromptFolderUp" aria-label="@Strings.PromptFolderUp" disabled="@(pick.Parent == null)" @onclick="() => OpenFolder(pick.Parent)">↑</button>
                            <span class="small muted" style="overflow-wrap:anywhere">@(pick.Current.Length > 0 ? pick.Current : Strings.PromptFolderDrives)</span>
                        </div>
                        @if (pick.Failed) { <p class="small warn">@Strings.PromptFolderFailed</p> }
                        <div style="max-height:220px;overflow:auto;margin:6px 0">
                            @if (pick.Current.Length == 0)
                            {
                                @foreach (var d in pick.Drives) { <button style="display:block;width:100%;text-align:left;margin:2px 0" @onclick="() => OpenFolder(d)">@d</button> }
                            }
                            else
                            {
                                @foreach (var f in pick.Folders) { <button style="display:block;width:100%;text-align:left;margin:2px 0" @onclick="() => OpenFolder(SubFolder(pick.Current, f))">@f</button> }
                                @if (!pick.Failed && pick.Folders.Count == 0) { <p class="small muted">@Strings.PromptFolderEmpty</p> }
                            }
                        </div>
                        <div class="row">
                            <button class="good" disabled="@(pick.Current.Length == 0 || pick.Failed)" @onclick="UseFolder">@Strings.PromptUseFolder</button>
                            <button @onclick="CloseFolders">@Strings.PromptFolderCancel</button>
                        </div>
                    </div>
                }
                <label style="color:var(--ink)"><input type="checkbox" @bind="_session.Options.AutoApprove" /> @Strings.PromptAutoApprove</label>
                <p class="muted small">@Strings.PromptToolsHint</p>
                @if (_toolMsg.Length > 0) { <p class="small warn">@_toolMsg</p> }
            }
            <details class="small" style="margin-top:14px">
                <summary class="muted">@Strings.PromptAdvanced</summary>
                <label for="pr-system">@Strings.PromptSystem</label>
                <textarea id="pr-system" rows="4" @bind="_session.Options.System"></textarea>
                <div class="row">
                    <label for="pr-temp" style="margin:0">@Strings.PromptTemperature</label><input id="pr-temp" type="number" step="0.1" min="0" max="2" style="width:80px" @bind="_session.Options.Temperature" />
                    <label for="pr-max" style="margin:0">@Strings.PromptMaxTokens</label><input id="pr-max" type="number" min="1" max="32768" style="width:90px" @bind="_session.Options.MaxTokens" />
                </div>
                @if (!IsVia)
                {
                    <label for="pr-key">@Strings.PromptApiKey</label>
                    <input id="pr-key" type="password" autocomplete="off" @bind="_session.Options.ApiKey" />
                }
            </details>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "server")] public string? Initial { get; set; }

    // Eine Verbindung für alle Seiten: lange Antworten dürfen dauern, gestoppt wird über den Knopf
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromMinutes(10) };

    // Im Simulator (nur Debug) antworten die Server über dessen eigenen Weg statt über das Netz – so lässt sich die Seite dort ausprobieren
    private HttpClient Client => Host.Sim?.Http ?? Http;

    private readonly PromptSession _session = new();
    private int _copiedTurn = -1;   // welcher Knopf gerade „Copied“ zeigt (-2 = ganze Unterhaltung)
    private bool _restored;         // nach einem Fehlschlag steht die Nachricht wieder im Eingabefeld
    // Die Auswahl: ein laufender lokaler Server (sein Key) oder ein Eintrag „Via Stykker-Proxy“ (PromptTargets)
    private string _input = "", _serverKey = "", _proxyMsg = "";
    private CancellationTokenSource? _cts;
    private DateTime _lastPaint;
    private bool _tools;
    private string _workdir = "", _toolMsg = "";
    private FolderListing? _picker;   // der Ordner-Wähler, solange er offen ist
    private TaskCompletionSource<bool>? _approval;

    private static string Cut(string s) => s.Length <= 600 ? s : s[..600] + " …";

    // Arbeitsordner und Werkzeug-Schalter gelten für den Server und überleben einen Neustart (settings.json). AutoApprove und
    // der API-Schlüssel bleiben bewusst nur für diese Sitzung. Gespeichert wird nur mit Schreibrecht und nicht im Nur-Lesen-Modus.
    private bool ToolsOn { get => _tools; set { _tools = value; Remember(); } }
    private string Workdir { get => _workdir; set { _workdir = value; Remember(); } }

    private void Remember()
    {
        if (!Viewer.CanWrite || Host.ReadOnly) return;
        var settings = Host.Engine.Settings;
        settings.PromptToolsOn = _tools;
        settings.PromptWorkdir = _workdir.Trim();
        settings.Save();
    }

    // Ordner-Wähler: blättert die Ordner des Servers durch (der Browser kann dessen Ordner nicht öffnen). Startet beim
    // eingetragenen Arbeitsordner, wenn der existiert, sonst bei den Laufwerken
    private void OpenPicker()
    {
        var start = _workdir.Trim();
        _picker = FolderBrowser.Browse(Directory.Exists(start) ? start : "");
    }

    private void OpenFolder(string? path) => _picker = FolderBrowser.Browse(path);

    private void UseFolder()
    {
        if (_picker is { Failed: false, Current.Length: > 0 } pick) Workdir = pick.Current;
        _picker = null;
    }

    private void CloseFolders() => _picker = null;

    private static string SubFolder(string parent, string name) => Path.Combine(parent, name);

    // Freigabe eines Werkzeugaufrufs: die Schleife wartet, bis hier geklickt wird
    private Task<bool> AskAsync(ToolCall call)
    {
        _approval = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _ = InvokeAsync(StateHasChanged);
        return _approval.Task;
    }

    private void Answer(bool ok) { _approval?.TrySetResult(ok); _approval = null; }

    private List<ServerWatcher> Servers => Host.Engine.Registry.Servers.Where(s => s.Online).ToList();
    private ServerWatcher? Server => IsVia ? null : Servers.FirstOrDefault(s => s.Key == _serverKey) ?? Servers.FirstOrDefault();

    private bool IsVia => PromptTargets.IsVia(_serverKey);
    private IReadOnlyList<ProxyChoice> ProxyChoices => Host.Engine.Proxies.Choices();
    private IReadOnlyList<(string Value, string Label)> ProxyOptions => PromptTargets.Options(ProxyChoices);
    private bool CanSend => IsVia || Server != null;

    // Auswahl wechseln heißt: das Modell eintragen und neu anfangen (ein Gespräch mit zwei Modellen ergibt nichts).
    // Über den Proxy geht kein Schlüssel von dieser Seite hinaus; der Proxy setzt ihn selbst.
    private string ServerKey
    {
        get => IsVia ? _serverKey : Server?.Key ?? "";
        set
        {
            _serverKey = value;
            _proxyMsg = "";
            _session.Clear();
            if (IsVia)
            {
                _session.Options.ApiKey = null;
                _session.Options.Model = PromptTargets.ModelOf(value, ProxyChoices) ?? "";
            }
            else _session.Options.Model = Server is { } s ? PromptHarness.ModelFor(s) : "";
        }
    }

    protected override void OnInitialized()
    {
        _serverKey = Initial ?? "";
        _tools = Host.Engine.Settings.PromptToolsOn;
        _workdir = Host.Engine.Settings.PromptWorkdir;
        if (IsVia) _session.Options.Model = PromptTargets.ModelOf(_serverKey, ProxyChoices) ?? "";
        else if (Server is { } s) _session.Options.Model = PromptHarness.ModelFor(s);
    }

    private async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey && !_session.Busy) await Send();
    }

    private async Task Send()
    {
        if (!CanSend || _input.Trim().Length == 0 || _session.Busy) return;
        _toolMsg = "";
        _proxyMsg = "";
        // Adresse: für ein Cloud-Modell der lokale Proxy (er hat den Schlüssel), sonst der Server selbst
        string baseUrl;
        if (IsVia)
        {
            var (target, error) = PromptTargets.Resolve(_serverKey, ProxyChoices, Host.Engine.Proxies.Port, Host.Engine.Proxies.Running);
            if (target == null) { _proxyMsg = error ?? ""; return; }
            baseUrl = target.Url;
            _session.Options.ApiKey = null;
        }
        else if (Server is { } s) baseUrl = s.Url;
        else return;
        if (_tools)
        {
            if (!Directory.Exists(_workdir.Trim())) { _toolMsg = Strings.PromptNoWorkdir; return; }
            if (_session.Options.Tools?.Root.TrimEnd('\\') != Path.GetFullPath(_workdir.Trim()).TrimEnd('\\')) _session.Options.Tools = new PromptTools(_workdir.Trim());
        }
        else _session.Options.Tools = null;
        var text = _input.Trim();
        _input = "";
        _restored = false;
        int before = _session.Turns.Count;
        _cts = new CancellationTokenSource();
        var task = _session.SendAsync(Client, baseUrl, text, () =>
        {
            // höchstens zehnmal je Sekunde neu zeichnen, sonst kommt die Leitung zum Browser nicht nach
            if ((DateTime.Now - _lastPaint).TotalMilliseconds < 100) return;
            _lastPaint = DateTime.Now;
            _ = InvokeAsync(StateHasChanged);
        }, _cts.Token, AskAsync);
        StateHasChanged();
        var result = await task;
        _cts.Dispose();
        _cts = null;
        // Nichts zurückgekommen (Server weg, Zeitlimit): die Frage steht nicht im Verlauf – dann zurück ins Feld, statt sie zu verlieren
        if (!result.Ok && _session.Turns.Count == before && _input.Length == 0)
        {
            _input = text;
            _restored = true;
        }
    }

    private async Task CopyText(string text, int which)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); _copiedTurn = which; }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { return; }
        _ = Task.Delay(1500).ContinueWith(_ => InvokeAsync(() => { _copiedTurn = -1; StateHasChanged(); }));
    }

    private void Stop() { _approval?.TrySetResult(false); _cts?.Cancel(); }

    private void Clear() { if (!_session.Busy) { _session.Clear(); _restored = false; } }

    public void Dispose() { _approval?.TrySetResult(false); _cts?.Cancel(); }
}
