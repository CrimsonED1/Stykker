@page "/disks"
@implements IDisposable
@inject EngineHost Host
@using Stykker.Shared.Disk

@* Laufwerke (Karte „Disks" im Monitor): je Volume Belegung und der Verlauf der letzten fünf Minuten für Lesen, Schreiben
   und Auslastung, dann die physischen Laufwerke und die Programme mit dem meisten Platten-E/A. Ein Takt je Sekunde;
   nicht gemessene Werte stehen als „–". Aussehen und Markup: die Hardware-Bausteine des Design-Systems (hw-*). *@

@{ var e = Host.Engine; var dk = e.Disks; }

<div class="hw-head">
    <span>@Strings.DisksPageTitle</span>
    <a class="hw-more" href="">@Strings.BackToMonitor</a>
</div>

@if (dk == null)
{
    <section class="hw-card"><span class="hw-sub">@Strings.DisksNoData</span></section>
}
else
{
    <section class="hw-card">
        <p class="hw-sub hw-hint-line">@Strings.DisksDetailsHint</p>
        <div class="hw-head">@Strings.DisksVolumes</div>
        @if (dk.Volumes.Count == 0)
        {
            <span class="hw-sub">@Strings.DisksNoData</span>
        }
        @foreach (var v in dk.Volumes)
        {
            var points = e.DiskHistory.Of(v.Letter);
            double used = v.TotalBytes > 0 ? Math.Clamp(v.UsedBytes / v.TotalBytes, 0, 1) : 0;
            var reads = points.Select(p => p.Read).ToList();
            var writes = points.Select(p => p.Write).ToList();
            var busy = points.Select(p => p.Busy).ToList();
            // Die Skala: der größte Wert des Verlaufs, mindestens 1 MB/s – so steht die Beschriftung für die volle Höhe
            double readTop = Sparkline.Scale(reads, 1024 * 1024), writeTop = Sparkline.Scale(writes, 1024 * 1024);
            <div class="hw-vol">
                <div class="hw-vol-top">
                    <span class="hw-letter">@v.Letter:</span>
                    <span class="hw-kind" data-k="@v.Kind">@DiskKinds.Label(v.Kind)</span>
                    <span class="hw-sub">@v.Label @v.FileSystem</span>
                    <span class="hw-free">@DiskFormat.Size(v.UsedBytes) @Strings.DisksUsed · @DiskFormat.Size(v.FreeBytes) @Strings.DisksFree · @DiskFormat.Size(v.TotalBytes)</span>
                </div>
                <div class="hw-bar"><i style="--w:@((int)(used * 100))%"></i></div>
                <div class="hw-io">
                    <span>@Strings.DisksRead <b>@Rate(v.ReadBytesPerSec)</b></span>
                    <span>@Strings.DisksWrite <b>@Rate(v.WriteBytesPerSec)</b></span>
                    <span>@Strings.DisksBusy <b>@Pct(v.BusyPercent)</b></span>
                    <span>@Strings.DisksQueue <b>@(v.QueueLength is double q ? q.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "–")</b></span>
                </div>
                <div class="hw-subh">@Strings.DisksHistory</div>
                @if (points.Count < 2)
                {
                    <div class="hw-sub">@Strings.DisksNoHistory</div>
                }
                else
                {
                    <div class="hw-sparks">
                        <div>
                            <div class="hw-spark-hd">@Strings.DisksRead · max @Rate(readTop)</div>
                            <svg class="hw-spark" viewBox="0 0 300 70" preserveAspectRatio="none"><polyline class="line" fill="none" points="@Spark(reads, readTop)" /></svg>
                        </div>
                        <div>
                            <div class="hw-spark-hd">@Strings.DisksWrite · max @Rate(writeTop)</div>
                            <svg class="hw-spark" viewBox="0 0 300 70" preserveAspectRatio="none"><polyline class="line second" fill="none" points="@Spark(writes, writeTop)" /></svg>
                        </div>
                        <div>
                            <div class="hw-spark-hd">@Strings.DisksBusy · max 100 %</div>
                            <svg class="hw-spark" viewBox="0 0 300 70" preserveAspectRatio="none"><polyline class="line warn" fill="none" points="@Spark(busy, 100)" /></svg>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="hw-card">
        <div class="hw-head">@Strings.DisksPhysical</div>
        @if (dk.Disks.Count == 0)
        {
            <span class="hw-sub">@Strings.DisksNoData</span>
        }
        else
        {
            <div class="hw-scroll">
                <table class="hw-table">
                    <tr><th>#</th><th>@Strings.DisksType</th><th>@Strings.DisksModel</th><th class="num">@Strings.DisksRead</th><th class="num">@Strings.DisksWrite</th><th class="num">@Strings.DisksBusy</th><th class="num">@Strings.DisksQueue</th></tr>
                    @foreach (var p in dk.Disks)
                    {
                        <tr>
                            <td>@p.Number</td>
                            <td>@DiskKinds.Label(p.Kind)</td>
                            <td class="hw-name" title="@p.Model">@p.Model</td>
                            <td class="num">@Rate(p.ReadBytesPerSec)</td>
                            <td class="num">@Rate(p.WriteBytesPerSec)</td>
                            <td class="num">@Pct(p.BusyPercent)</td>
                            <td class="num">@(p.QueueLength is double q ? q.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "–")</td>
                        </tr>
                    }
                </table>
            </div>
        }
    </section>

    <section class="hw-card">
        <div class="hw-head">@Strings.DisksPrograms</div>
        <p class="hw-sub hw-hint-line">@Strings.DisksProgramsHint</p>
        @if (e.DiskProcesses.Count == 0)
        {
            <span class="hw-sub">@Strings.DisksProgramsNone</span>
        }
        else
        {
            <div class="hw-scroll">
                <table class="hw-table">
                    <tr><th>@Strings.ColProcess</th><th class="num">PID</th><th class="num">@Strings.DisksRead</th><th class="num">@Strings.DisksWrite</th></tr>
                    @foreach (var p in e.DiskProcesses)
                    {
                        <tr>
                            <td class="hw-name" title="@p.Name">@p.Name</td>
                            <td class="num">@p.Pid</td>
                            <td class="num">@DiskFormat.Rate(p.ReadBytesPerSec)</td>
                            <td class="num">@DiskFormat.Rate(p.WriteBytesPerSec)</td>
                        </tr>
                    }
                </table>
            </div>
        }
    </section>
}

@code {
    private Timer? _t;

    protected override void OnInitialized()
    {
        _t = new Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    public void Dispose() => _t?.Dispose();

    private static string Rate(double? bytesPerSec) => bytesPerSec is double b ? DiskFormat.Rate(b) : "–";

    private static string Pct(double? pct) => pct is double p ? p.ToString("0", System.Globalization.CultureInfo.InvariantCulture) + " %" : "–";

    private static string Spark(IReadOnlyList<double?> values, double max) => Sparkline.Points(values, max);
}
