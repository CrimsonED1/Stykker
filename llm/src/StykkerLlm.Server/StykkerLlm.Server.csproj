<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- StykkerLLM-Server: der Kern (Engine, Eval-Warteschlange) mit Web-Oberfläche (Blazor Server, Port 8078) und Tray-Symbol.
       Fenster (StykkerUI.exe, zeigt diese Weboberfläche) und TUI (stykker.exe) sind Bedienoberflächen dieses Servers. -->
  <PropertyGroup>
    <!-- net10.0 statt net10.0-windows: nur so bindet das SDK blazor.web.js ein (Tray-Symbol folgt ohne WinForms) -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Exe statt WinExe: mit WinExe bindet das SDK blazor.web.js nicht ein. Fenster/TUI starten den Server ohne Konsolenfenster. -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StykkerLLM-Server</AssemblyName>
    <RootNamespace>StykkerLlm.Server</RootNamespace>
    <ApplicationIcon>../../assets/app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StykkerLlm.Core\StykkerLlm.Core.csproj" />
    <ProjectReference Include="..\StykkerLlm.Platform.Windows\StykkerLlm.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
