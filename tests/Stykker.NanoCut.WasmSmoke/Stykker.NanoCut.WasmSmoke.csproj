<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    Runs the analytic reference checks inside the real browser-wasm runtime (Mono interpreter).
    Build:  dotnet build -c Release
    Run:    node bin/Release/net10.0/wwwroot/main.mjs   (exit code 0 = all checks within budget)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Stykker.NanoCut.WasmSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Stykker.NanoCut.Core/Stykker.NanoCut.Core.csproj" />
    <ProjectReference Include="../../src/Stykker.NanoCut.Geometry2D/Stykker.NanoCut.Geometry2D.csproj" />
    <ProjectReference Include="../../src/Stykker.NanoCut.Cutting/Stykker.NanoCut.Cutting.csproj" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <None Include="node/main.mjs" Link="wwwroot/main.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
