<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Versuch (docs/spike-frame-proxy.md): die Zentrale als Hülle mit Leiste und Frame, davor YARP für Dienste,
       die sich nicht einbetten lassen. Kein Teil eines Werkzeugs und in keiner Solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
