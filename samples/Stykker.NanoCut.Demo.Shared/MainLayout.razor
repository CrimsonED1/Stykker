@inherits LayoutComponentBase
@inject IComputeRunner Runner
<div class="shell">
    <nav class="sidebar">
        <div class="brand">Stykker<span>.NanoCut</span></div>
        <div class="tagline">exact cutting · 1 nm grid · @(Runner is InlineComputeRunner ? "runs in your browser" : "computed on the server")</div>
        @foreach (var group in SceneCatalog.All.GroupBy(s => s.Category))
        {
            <div class="group">@group.Key</div>
            @foreach (var s in group)
            {
                <NavLink class="item" href="@($"scene/{s.Id}")">@s.Title</NavLink>
            }
        }
        <div class="group">Machines</div>
        <NavLink class="item" href="machine/lathe">Lathe (jog / G-code)</NavLink>
        <NavLink class="item" href="machine/mill">3-axis mill (jog / G-code)</NavLink>
        <NavLink class="item" href="spinning">Spinning disc (saw / wheel)</NavLink>
        <NavLink class="item" href="grinding">Grinding grains</NavLink>
        <NavLink class="item" href="cubes">Free-form: cube shapes cube</NavLink>
        <NavLink class="item" href="preview">Preview: exact vs CPU vs GPU</NavLink>
        <div class="group">Measurement</div>
        <NavLink class="item" href="profiles">Profiles (sections of 3D parts)</NavLink>
        <NavLink class="item" href="inspect">Inspection (colour = deviation in nm)</NavLink>
        <div class="group">Verification</div>
        <NavLink class="item" href="selftest">Self test</NavLink>
        <div class="foot">@Runner.Where · three.js / Babylon.js</div>
    </nav>
    <main class="content">@Body</main>
</div>
