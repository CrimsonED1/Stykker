@inherits LayoutComponentBase
@inject IComputeRunner Runner
<div class="shell">
    <nav class="sidebar">
        <div class="brand">Stykker<span>.NanoCut</span></div>
        <div class="tagline">exact cutting · 1 nm grid · @(Runner is InlineComputeRunner ? "runs in your browser" : "computed on the server")</div>
        <NavLink class="item" href="" Match="NavLinkMatch.All">Overview</NavLink>
        @foreach (var group in SceneCatalog.All.GroupBy(s => s.Category))
        {
            <div class="group">@group.Key</div>
            @foreach (var s in group)
            {
                <NavLink class="item" href="@($"scene/{s.Id}")">@s.Title</NavLink>
            }
        }
        @foreach (var group in Pages.PageIndex.All.GroupBy(p => p.Group))
        {
            <div class="group">@group.Key</div>
            @foreach (var p in group)
            {
                <NavLink class="item" href="@p.Route">@p.Title</NavLink>
            }
        }
        <div class="foot">@Runner.Where · three.js / Babylon.js</div>
    </nav>
    <main class="content">@Body</main>
</div>
