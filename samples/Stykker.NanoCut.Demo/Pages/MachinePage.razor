@page "/machine/{Kind}"
@using Stykker.NanoCut.Demo.Machines
@using Stykker.NanoCut.Geometry3D
@inject Viewer Viewer
@implements IAsyncDisposable

<div class="scene">
    <section class="stage">
        <header class="stage-head">
            <div>
                <h1>@_machine.Title</h1>
                <p class="desc">Jog the axes, enter target positions or run a G-code program (G0 rapid, G1 cut, absolute mm).
                    Every move removes exactly what the tool sweeps. @_machine.AxisNote</p>
            </div>
            <div class="engine">
                <button class="@(_engine == "three" ? "on" : "")" @onclick='() => SwitchEngine("three")'>three.js</button>
                <button class="@(_engine == "babylon" ? "on" : "")" @onclick='() => SwitchEngine("babylon")'>Babylon.js</button>
            </div>
        </header>
        <div id="viewport" class="viewport">
            @if (_busy)
            {
                <div class="busy"><div class="spinner"></div>@_busyText</div>
            }
        </div>
    </section>

    <aside class="panel">
        <h2>Position</h2>
        <div class="dro">
            @for (int i = 0; i < _machine.Axes.Length; i++)
            {
                <div><span>@_machine.Axes[i]</span>@_machine.Position[i].ToString("0.000", CultureInfo.InvariantCulture)</div>
            }
        </div>

        <h2>Jog (cuts while moving)</h2>
        <label class="param">
            <span>Step</span>
            <select @bind="_step">
                <option value="0.01">0.01 mm</option>
                <option value="0.1">0.1 mm</option>
                <option value="0.5">0.5 mm</option>
                <option value="1">1 mm</option>
                <option value="5">5 mm</option>
            </select>
        </label>
        @for (int i = 0; i < _machine.Axes.Length; i++)
        {
            int axis = i;
            <div class="jog">
                <b>@_machine.Axes[axis]</b>
                <button disabled="@_busy" @onclick="() => Jog(axis, -10)">−10×</button>
                <button disabled="@_busy" @onclick="() => Jog(axis, -1)">−</button>
                <button disabled="@_busy" @onclick="() => Jog(axis, 1)">+</button>
                <button disabled="@_busy" @onclick="() => Jog(axis, 10)">+10×</button>
            </div>
        }

        <h2>Go to</h2>
        @for (int i = 0; i < _machine.Axes.Length; i++)
        {
            int axis = i;
            <label class="param">
                <span>@_machine.Axes[axis]</span>
                <input type="number" step="0.1" value="@_target[axis].ToString(CultureInfo.InvariantCulture)"
                       @onchange="e => _target[axis] = double.Parse((string)e.Value!, CultureInfo.InvariantCulture)" />
            </label>
        }
        <div class="actions">
            <button class="run" disabled="@_busy" @onclick="() => GoTo(false)">G1 cut</button>
            <button class="ghost" disabled="@_busy" @onclick="() => GoTo(true)">G0 rapid</button>
            <button class="ghost" disabled="@_busy" @onclick="Undo">Undo</button>
        </div>

        <h2>Program</h2>
        <textarea class="program" @bind="_program"></textarea>
        <div class="actions">
            <button class="run" disabled="@_busy" @onclick="RunProgram">Run program</button>
            <button class="ghost" disabled="@_busy" @onclick="() => _program = _machine.DefaultProgram">Example</button>
        </div>

        <h2>Setup</h2>
        @foreach (var p in _machine.Settings)
        {
            <label class="param">
                <span>@p.Label</span>
                @if (p.Choices is { } choices)
                {
                    <select value="@((int)_settings[p.Key])" @onchange="e => _settings[p.Key] = int.Parse((string)e.Value!)">
                        @for (int i = 0; i < choices.Length; i++)
                        {
                            <option value="@i">@choices[i]</option>
                        }
                    </select>
                }
                else
                {
                    <span class="num">
                        <input type="number" step="@p.Step.ToString(CultureInfo.InvariantCulture)" value="@_settings[p.Key].ToString(CultureInfo.InvariantCulture)"
                               @onchange="e => _settings[p.Key] = double.Parse((string)e.Value!, CultureInfo.InvariantCulture)" />
                        <em>@p.Unit</em>
                    </span>
                }
            </label>
        }
        <div class="actions"><button class="ghost" disabled="@_busy" @onclick="ResetMachine">New workpiece</button></div>

        @if (_error is not null)
        {
            <div class="error">@_error</div>
        }
        @if (_view is not null)
        {
            <h2>Status</h2>
            <table class="metrics">
                @foreach (var (label, value) in _view.Metrics)
                {
                    <tr><td>@label</td><td>@value</td></tr>
                }
            </table>
            <div class="actions">
                <button class="ghost" @onclick="DownloadStl">STL</button>
                <button class="ghost" @onclick="DownloadNcs">.ncs (lossless)</button>
            </div>
        }
        <h2>Log</h2>
        <div class="log">@string.Join("\n", _machine.Log.TakeLast(40))</div>
    </aside>
</div>

@code {
    [Parameter] public string Kind { get; set; } = "lathe";

    private Machine _machine = new LatheMachine();
    private Dictionary<string, double> _settings = [];
    private double[] _target = [];
    private string _step = "1";
    private string _program = "";
    private SceneResult? _view;
    private string? _error;
    private bool _busy;
    private string _busyText = "";
    private string _engine = "three";
    private bool _attached;
    private string? _loadedKind;

    protected override void OnParametersSet()
    {
        if (_loadedKind == Kind) return;
        _loadedKind = Kind;
        _machine = Kind == "mill" ? new MillMachine() : new LatheMachine();
        _settings = _machine.Settings.ToDictionary(p => p.Key, p => p.Default);
        _program = _machine.DefaultProgram;
        _machine.Reset(_settings);
        _target = (double[])_machine.Position.Clone();
        _view = null;
        if (_attached) _ = Redraw();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_attached) return;
        await Viewer.Attach("viewport", _engine);
        _attached = true;
        await Redraw();
        StateHasChanged();
    }

    private async Task Busy(string text, Func<Task> work)
    {
        if (_busy) return;
        _busy = true;
        _busyText = text;
        _error = null;
        StateHasChanged();
        await Task.Delay(30);
        try { await work(); }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _busy = false;
            _target = (double[])_machine.Position.Clone();
            StateHasChanged();
        }
    }

    private Task Jog(int axis, double factor) => Busy("Cutting…", async () =>
    {
        double step = double.Parse(_step, CultureInfo.InvariantCulture) * factor;
        var p = (double[])_machine.Position.Clone();
        p[axis] += step;
        _machine.Execute(ToMove(p, rapid: false));
        await Redraw();
    });

    private Task GoTo(bool rapid) => Busy(rapid ? "Rapid move…" : "Cutting…", async () =>
    {
        _machine.Execute(ToMove(_target, rapid));
        await Redraw();
    });

    private Task Undo() => Busy("Undo…", async () =>
    {
        _machine.Undo();
        await Redraw();
    });

    private Task RunProgram() => Busy("Running program…", async () =>
    {
        var moves = Machine.Parse(_program);
        for (int i = 0; i < moves.Count; i++)
        {
            _busyText = $"Running program… move {i + 1} / {moves.Count}";
            _machine.Execute(moves[i]);
            if (i % 3 == 2 || i == moves.Count - 1)
            {
                await Redraw();
                StateHasChanged();
                await Task.Delay(1);
            }
        }
    });

    private Task ResetMachine() => Busy("New workpiece…", async () =>
    {
        _machine.Reset(_settings);
        await Redraw();
    });

    private Move ToMove(double[] p, bool rapid) => _machine.Axes.Length == 2
        ? new Move(rapid, p[0], null, p[1])
        : new Move(rapid, p[0], p[1], p[2]);

    private async Task Redraw()
    {
        _view = _machine.Render();
        await Viewer.Clear();
        foreach (var o in _view.Objects)
            if (o.Mesh is { } m) await Viewer.AddMesh(o.Name, m, o.Color, o.Opacity);
        if (_machine.MoveCount == 0) await Viewer.Fit(_view.View);
    }

    private async Task SwitchEngine(string engine)
    {
        if (_engine == engine) return;
        _engine = engine;
        try
        {
            await Viewer.SetEngine(engine);
            await Redraw();
            await Viewer.Fit(_view?.View ?? "iso");
        }
        catch (Exception ex) { _error = $"Could not start {engine}: {ex.Message}"; }
    }

    private async Task DownloadStl()
    {
        if (_view?.Result is { } s) await Viewer.Download($"{Kind}.stl", s.ToMeshBuffers(OriginMode.Absolute).ToStl());
    }

    private async Task DownloadNcs()
    {
        if (_view?.Result is not { } s) return;
        using var ms = new MemoryStream();
        NcsFormat.Save(s, ms);
        await Viewer.Download($"{Kind}.ncs", ms.ToArray());
    }

    public async ValueTask DisposeAsync()
    {
        if (_attached) await Viewer.Clear();
    }
}
