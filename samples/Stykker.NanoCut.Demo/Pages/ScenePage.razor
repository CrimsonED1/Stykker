@page "/scene/{Id}"
@using Stykker.NanoCut.Geometry3D
@inject Viewer Viewer
@implements IAsyncDisposable

@if (_scene is null)
{
    <p class="pad">Unknown scene.</p>
}
else
{
    <div class="scene">
        <section class="stage">
            <header class="stage-head">
                <div>
                    <h1>@_scene.Title</h1>
                    <p class="desc">@_scene.Description</p>
                </div>
                <div class="engine">
                    <button class="@(_engine == "three" ? "on" : "")" @onclick='() => SwitchEngine("three")'>three.js</button>
                    <button class="@(_engine == "babylon" ? "on" : "")" @onclick='() => SwitchEngine("babylon")'>Babylon.js</button>
                </div>
            </header>
            <div id="viewport" class="viewport">
                @if (_busy)
                {
                    <div class="busy"><div class="spinner"></div>Computing in WebAssembly…</div>
                }
            </div>
        </section>

        <aside class="panel">
            <h2>Parameters</h2>
            @foreach (var p in _scene.Params)
            {
                <label class="param">
                    <span>@p.Label</span>
                    @if (p.Choices is { } choices)
                    {
                        <select value="@((int)_values[p.Key])" @onchange="e => _values[p.Key] = int.Parse((string)e.Value!)">
                            @for (int i = 0; i < choices.Length; i++)
                            {
                                <option value="@i">@choices[i]</option>
                            }
                        </select>
                    }
                    else
                    {
                        <span class="num">
                            <input type="number" min="@F(p.Min)" max="@F(p.Max)" step="@F(p.Step)" value="@F(_values[p.Key])"
                                   @onchange="e => Set(p, (string?)e.Value)" />
                            <em>@p.Unit</em>
                        </span>
                    }
                </label>
            }
            <div class="actions">
                <button class="run" disabled="@_busy" @onclick="Run">Run</button>
                <button class="ghost" disabled="@_busy" @onclick="Reset">Defaults</button>
            </div>

            @if (_error is not null)
            {
                <div class="error">@_error</div>
            }
            @if (_result is not null)
            {
                <h2>Results</h2>
                <table class="metrics">
                    @foreach (var (label, value) in _result.Metrics)
                    {
                        <tr><td>@label</td><td>@value</td></tr>
                    }
                </table>
                @if (_result.Checks.Count > 0)
                {
                    <h2>Checks</h2>
                    @foreach (var c in _result.Checks)
                    {
                        <div class="check @(c.Passed ? "pass" : "fail")">
                            <b>@(c.Passed ? "PASS" : "FAIL")</b> @c.Name
                            <small>|Δ| @c.Deviation.ToString("0.###e+0", CultureInfo.InvariantCulture) ≤ @c.Allowed.ToString("0.###e+0", CultureInfo.InvariantCulture) @c.Unit</small>
                        </div>
                    }
                }
                @if (_result.Result is not null)
                {
                    <h2>Download</h2>
                    <div class="actions">
                        <button class="ghost" @onclick="DownloadStl">STL</button>
                        <button class="ghost" @onclick="DownloadNcs">.ncs (lossless)</button>
                    </div>
                }
                <h2>Objects</h2>
                @foreach (var o in _result.Objects.Where(o => o.Mesh is not null))
                {
                    <div class="legend"><i style="background:@o.Color; opacity:@Math.Max(0.35, o.Opacity).ToString(CultureInfo.InvariantCulture)"></i>@o.Name</div>
                }
            }
        </aside>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private DemoScene? _scene;
    private Dictionary<string, double> _values = [];
    private SceneResult? _result;
    private string? _error;
    private bool _busy;
    private string _engine = "three";
    private bool _attached;
    private string? _loadedId;

    private static string F(double v) => v.ToString(CultureInfo.InvariantCulture);

    protected override void OnParametersSet()
    {
        if (_loadedId == Id) return;
        _loadedId = Id;
        _scene = SceneCatalog.Find(Id);
        _result = null;
        _error = null;
        Reset();
    }

    private void Reset()
    {
        if (_scene is null) return;
        _values = _scene.Params.ToDictionary(p => p.Key, p => p.Default);
    }

    private void Set(Param p, string? text)
    {
        if (double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var v))
            _values[p.Key] = Math.Clamp(v, p.Min, p.Max);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scene is null) return;
        if (!_attached)
        {
            await Viewer.Attach("viewport", _engine);
            _attached = true;
            await Run();
        }
        else if (_result is null && !_busy && _error is null)
        {
            await Run(); // navigated to another scene
        }
    }

    private async Task Run()
    {
        if (_scene is null || _busy) return;
        _busy = true;
        _error = null;
        StateHasChanged();
        await Task.Delay(30); // let the browser paint the busy indicator
        try
        {
            _result = _scene.Run(_values);
            await Show();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task Show()
    {
        if (_result is null) return;
        await Viewer.Clear();
        foreach (var o in _result.Objects)
        {
            if (o.Mesh is { } m) await Viewer.AddMesh(o.Name, m, o.Color, o.Opacity);
            if (o.Lines is { } l) await Viewer.AddLines(o.Name, l, o.Color);
        }
        await Viewer.Fit(_result.View);
    }

    private async Task SwitchEngine(string engine)
    {
        if (_engine == engine) return;
        _engine = engine;
        try
        {
            await Viewer.SetEngine(engine);
            await Show();
        }
        catch (Exception ex)
        {
            _error = $"Could not start {engine}: {ex.Message}";
        }
    }

    private async Task DownloadStl()
    {
        if (_result?.Result is { } s) await Viewer.Download($"{Id}.stl", s.ToMeshBuffers(OriginMode.Absolute).ToStl());
    }

    private async Task DownloadNcs()
    {
        if (_result?.Result is not { } s) return;
        using var ms = new MemoryStream();
        NcsFormat.Save(s, ms);
        await Viewer.Download($"{Id}.ncs", ms.ToArray());
    }

    public async ValueTask DisposeAsync()
    {
        if (_attached) await Viewer.Clear();
    }
}
