@inherits LayoutComponentBase
<div class="shell">
    <nav class="sidebar">
        <div class="brand">Stykker<span>.NanoCut</span></div>
        <div class="tagline">exact cutting · 1 nm grid · runs in your browser</div>
        @foreach (var group in SceneCatalog.All.GroupBy(s => s.Category))
        {
            <div class="group">@group.Key</div>
            @foreach (var s in group)
            {
                <NavLink class="item" href="@($"scene/{s.Id}")">@s.Title</NavLink>
            }
        }
        <div class="group">Machines</div>
        <NavLink class="item" href="machine/lathe">Lathe (jog / G-code)</NavLink>
        <NavLink class="item" href="machine/mill">3-axis mill (jog / G-code)</NavLink>
        <div class="group">Verification</div>
        <NavLink class="item" href="selftest">Self test</NavLink>
        <div class="foot">C# on WebAssembly · three.js / Babylon.js</div>
    </nav>
    <main class="content">@Body</main>
</div>
