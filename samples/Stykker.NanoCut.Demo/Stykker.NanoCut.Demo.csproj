<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    Interactive demo: all geometry is computed in the browser (C# on WebAssembly) and shown with three.js or Babylon.js.
    The pages live in samples/Stykker.NanoCut.Demo.Shared; samples/Stykker.NanoCut.Server runs the same pages with the
    geometry computed on the server.
    Run:      dotnet run (in samples/Stykker.NanoCut.Demo)
    Publish:  dotnet publish -c Release   (static files in bin/Release/net10.0/publish/wwwroot)
    AOT:      add -p:Aot=true to publish (needs the wasm-tools workload); much faster for heavy scenes.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Plain framework file names: the page keeps its own import map for three.js / Babylon.js. -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <RootNamespace>Stykker.NanoCut.Demo</RootNamespace>
    <RunAOTCompilation Condition="'$(Aot)' == 'true'">true</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pages, scenes, viewer and static files; shared with the server host (samples/Stykker.NanoCut.Server). -->
    <ProjectReference Include="../Stykker.NanoCut.Demo.Shared/Stykker.NanoCut.Demo.Shared.csproj" />
  </ItemGroup>
</Project>
