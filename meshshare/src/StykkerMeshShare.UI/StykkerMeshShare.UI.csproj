<Project Sdk="Microsoft.NET.Sdk">

  <!-- StykkerMeshShare: das Fenster um die Oberfläche des Servers (Photino: unter Windows WebView2), wie bei StykkerSYS.
       Kein eigener Oberflächen-Code – Fenster, Browser und Handy zeigen dieselben Seiten. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StykkerMeshShare</AssemblyName>
    <RootNamespace>StykkerMeshShare.UI</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>StykkerMeshShare.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Das Symbol auch als Datei neben der Exe: Photino setzt es damit für das Fenster (Taskleiste, Alt+Tab). -->
    <Content Include="StykkerMeshShare.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <ProjectReference Include="..\..\..\shared\src\Stykker.Pairing\Stykker.Pairing.csproj" />
    <!-- TrayIcon (Win32, wie beim Server und beim Starter) -->
    <ProjectReference Include="..\..\..\shared\src\Stykker.Shared\Stykker.Shared.csproj" />
  </ItemGroup>

</Project>
