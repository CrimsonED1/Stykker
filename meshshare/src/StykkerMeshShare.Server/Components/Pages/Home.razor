@page "/"
@* Eine Seite: links die Dropzone, rechts der Sync-Status, darunter die Übertragung, die Dateien (ansehen und
   herunterladen, auch am Handy), was zuletzt passiert ist und der Papierkorb. Statisch gerendert; die Skripte in
   wwwroot/js holen die Werte aus /api/status, /api/files und /api/trash. *@

<div class="top">
    <div class="brand"><span class="logo">◆</span> STYKKER <span class="acc">MESHSHARE</span></div>
    <div class="strip">
        <span class="stat" title="The PC this page belongs to">This PC <b id="v-name">–</b></span>
        <span class="stat hide-s" title="Files in the shared folder">Files <b id="v-files">–</b></span>
        <span class="stat hide-s" title="Size of the shared folder">Size <b id="v-size">–</b></span>
        <span class="stat" id="v-free-chip" title="Free space on the drive of the shared folder">Free <b id="v-free">–</b></span>
        <span class="stat" id="v-peers-chip" title="Other PCs online">PCs <b id="v-peers">–</b></span>
        <div class="seg" role="group" aria-label="Theme">
            <button type="button" data-theme-choice="dark" class="on" aria-pressed="true">Dark</button>
            <button type="button" data-theme-choice="titan" aria-pressed="false">Titan</button>
        </div>
    </div>
    @* Nur im eigenen Fenster: Thema als ein Chip und die Fensterknöpfe, wie beim Starter. *@
    <button type="button" class="tchip ms-win-only" id="t-theme" title="Switch the theme">Titan</button>
    <span class="t-controls ms-win-only">
        <button type="button" class="t-btn" id="t-min" title="Minimize" aria-label="Minimize">–</button>
        <button type="button" class="t-btn" id="t-max" title="Maximize" aria-label="Maximize">□</button>
        <button type="button" class="t-btn t-close" id="t-close" title="Close" aria-label="Close">✕</button>
    </span>
</div>

<main>
    <div id="notes"></div>

    <div class="ms-grid">
        <section class="card ms-drop" id="drop" aria-label="Add files">
            <input type="file" id="pick" multiple hidden />
            <input type="file" id="pick-dir" webkitdirectory multiple hidden />
            <div class="ms-drop-inner">
                <svg class="ic ms-drop-ic" aria-hidden="true"><use href="#i-arrow-down" /></svg>
                <b class="ms-drop-pc">Drop files or folders here</b>
                <b class="ms-drop-phone">Add files from this phone</b>
                <span class="muted">They go into the shared folder and reach every PC.</span>
                <span class="ms-drop-acts">
                    <button type="button" class="primary" id="pick-btn">Choose files</button>
                    <button type="button" id="pick-dir-btn" class="ms-pc-only">Choose folder</button>
                    <button type="button" id="open-folder" hidden title="Open the shared folder in the Explorer">Open folder</button>
                </span>
                <label class="ms-target">Into
                    <select id="target" aria-label="Folder the files go into"><option value="">the shared folder</option></select>
                </label>
            </div>
            <div id="uploads" class="ms-uploads" aria-live="polite"></div>
        </section>

        <section class="card ms-status">
            <div class="ms-head">
                <span class="st" id="v-lamp" data-s="idle" title="Idle" aria-label="Idle"><svg class="ic"><use id="v-lamp-ic" href="#s-idle" /></svg></span>
                <div class="ms-state">
                    <b id="v-state" aria-live="polite">Starting…</b>
                    <span class="muted mono ms-ellipsis" id="v-folder">–</span>
                </div>
                @* Sync-Pause dieses PCs; bei den anderen PCs sitzt der Knopf in ihrer Zeile. Jeder PC (und das Handy) darf das. *@
                <button type="button" class="quiet" id="sync-btn" aria-pressed="false" title="Stop all syncing of this PC: nothing comes in, nothing goes out">Pause sync</button>
                <button type="button" class="quiet" id="folder-btn" hidden title="Choose another shared folder">Change folder</button>
            </div>
            @* Freier Platz auf dem Laufwerk des Ordners. Unter der Grenze nimmt dieser PC nichts an; die Grenze ändert man
               nur am PC selbst. *@
            <div class="ms-disk" id="disk" hidden>
                <span class="mono" id="v-disk">–</span>
                <span class="bar" title="Used space on this drive"><i id="v-disk-bar"></i></span>
                <span class="mono ms-disk-total" id="v-disk-total"></span>
            </div>
            <div class="ms-disk-hint muted" id="disk-hint" hidden>
                <span id="v-minfree-text">Receiving stops below 5 GB free.</span>
                <button type="button" class="quiet" id="minfree-btn" hidden>Change</button>
            </div>
            <form id="minfree-form" class="ms-minfree" hidden autocomplete="off">
                <label for="minfree-gb">Keep at least</label>
                <input id="minfree-gb" type="number" min="0" max="10000" step="0.5" inputmode="decimal" />
                <span>GB free (0 = no limit)</span>
                <button type="submit" class="primary">Save</button>
                <button type="button" class="quiet" id="minfree-cancel">Cancel</button>
            </form>
            @* Ordner wechseln: nur am PC selbst (der Server blendet den Knopf sonst aus). *@
            <form id="folder-form" class="ms-folder" hidden autocomplete="off">
                <label class="ms-label" for="folder-path">New shared folder</label>
                <div class="search"><input id="folder-path" class="mono" placeholder="D:\Shared" aria-describedby="folder-check" /></div>
                <span class="ms-check muted" id="folder-check" aria-live="polite">The new folder must be empty or not exist yet.</span>
                <label class="ms-choice"><input type="radio" name="folder-mode" value="move" checked />
                    <span><b>Move the files there</b><span class="muted">Everything moves to the new folder. The other PCs notice nothing.</span></span></label>
                <label class="ms-choice"><input type="radio" name="folder-mode" value="fresh" />
                    <span><b>Start empty</b><span class="muted">The new folder gets all files from the other PCs. The old folder stays as it is; nothing is deleted anywhere.</span></span></label>
                <span class="ms-folder-acts">
                    <button type="submit" class="primary" id="folder-apply">Change</button>
                    <button type="button" class="quiet" id="folder-cancel">Cancel</button>
                </span>
            </form>
            <div class="sec">Other PCs <span class="n" id="v-peer-count">0</span></div>
            <div id="peers" class="ms-peers"></div>
            <form id="add-peer" class="ms-add" autocomplete="off" hidden>
                <div class="search"><input id="peer-address" placeholder="Add a PC: name or address" aria-label="Name or address of another PC" /></div>
                <button type="submit">Add</button>
            </form>
            <p class="muted ms-hint">PCs in the same home network find each other. Over Tailscale, add the other PC by its name.</p>
        </section>
    </div>

    @* Übertragung: die laufende Datei mit Rate und Restzeit, darunter die Warteschlange. Die Reihenfolge legt man per
       Ziehen fest oder mit den Pfeilen (Tastatur, Handy); „Load now“ hält die laufende Datei an, sie lädt später weiter. *@
    <section class="card ms-transfers" id="transfers">
        <div class="ms-bar">
            <h2>Transfers</h2>
            <span class="muted ms-rate" id="v-rate"></span>
        </div>
        <div id="total" class="ms-total" hidden><span class="bar"><i></i></span><span class="muted" id="v-total"></span></div>
        <div id="current" class="ms-current"></div>
        <div id="queue" class="ms-queue" role="list" aria-label="Waiting files"></div>
        <div id="queue-live" class="sr-only" aria-live="polite"></div>
    </section>

    <div class="ms-grid">
        <section class="card">
            <div class="ms-bar">
                <h2>Files</h2>
                <div class="search"><input id="q" placeholder="Search" aria-label="Search files" /></div>
            </div>
            <div id="files" class="ms-files"></div>
            <p class="muted ms-hint" id="files-note"></p>
        </section>

        <section class="card">
            <h2>Activity</h2>
            <div id="activity" class="ms-activity"></div>
            <details class="ms-trash" id="trash-box">
                <summary>Trash <span class="muted">(replaced or deleted by other PCs, kept 30 days)</span></summary>
                <div class="ms-trash-bar"><span class="muted" id="trash-count"></span>
                    <button type="button" class="quiet danger-text" id="trash-empty" hidden>Empty trash</button></div>
                <div id="trash" class="ms-files"></div>
            </details>
        </section>
    </div>

    @* Nur im eigenen Fenster: die Frage beim Schließen, wie beim Starter. *@
    <div class="ms-scrim" id="ask-close" hidden>
        <div class="ms-dlg" role="dialog" aria-modal="true" aria-labelledby="ask-close-title">
            <div class="head"><b>◆</b><span id="ask-close-title">CLOSE THE WINDOW</span></div>
            <div class="body">
                <p>Keep StykkerMeshShare running in the tray, or quit it? Quitting also stops syncing on this PC.</p>
                <label class="ms-check"><input type="checkbox" id="ask-close-remember" /><span>Don't ask again (change it in the tray menu)</span></label>
            </div>
            <div class="bottom">
                <button type="button" class="quiet" id="ask-close-cancel">Cancel</button>
                <button type="button" id="ask-close-quit">Quit</button>
                <button type="button" class="primary" id="ask-close-tray">Keep in tray</button>
            </div>
        </div>
    </div>

    <div class="toasts" id="toasts" role="status"></div>
</main>
