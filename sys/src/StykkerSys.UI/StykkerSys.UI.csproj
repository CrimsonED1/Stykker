<Project Sdk="Microsoft.NET.Sdk">

  <!-- StykkerSYS: das Fenster um die Oberfläche des Servers (Photino: unter Windows WebView2).
       Kein eigener Oberflächen-Code – Fenster und Browser zeigen dieselben Seiten. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StykkerSYS</AssemblyName>
    <RootNamespace>StykkerSys.UI</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

</Project>
