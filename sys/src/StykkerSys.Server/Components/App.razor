@* Die Hülle der Seiten: Themenwahl am <html>, die Stile aus dem gemeinsamen Design-System (unter /ds aus
   shared\design-system geliefert) und die eigene Ergänzung app.css.
   "shell" ist die Klasse des Design-Systems für Fenster ohne Grafikkarte – das Fenster setzt sie über ?shell=1. *@
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>StykkerSYS</title>
    <link rel="icon" href="/ds/assets/Logos/app-icon.png" />
    <link rel="stylesheet" href="/ds/tokens.css" />
    <link rel="stylesheet" href="/ds/components/bundle.css" />
    <link rel="stylesheet" href="/app.css" />
    @* Läuft vor dem ersten Zeichnen: die gemerkte Themenwahl und "shell" (Fenster ohne Grafikkarte) am <html>. *@
    <script>
        try {
            const theme = localStorage.getItem("stykkersys.theme");
            if (theme) document.documentElement.dataset.theme = theme;
        } catch { }
        if (new URLSearchParams(location.search).has("shell")) document.documentElement.classList.add("shell");
    </script>
</head>
<body>
    <Routes />
    <script src="/ds/components/bundle.js"></script>
    <script src="/sys.js"></script>
</body>
</html>
