@page "/overview"
@using Stykker.Pairing
@using Stykker.Hardware.Components
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@* Die Übersicht: die gemeinsame Hardware-Seite (Stykker.Hardware, dieselbe wie in StykkerLLM) – Prozessor und Speicher,
   Grafikkarte, Laufwerke und Netzwerk auf einer Seite. Der Baustein läuft interaktiv und misst nur, solange die Seite
   offen ist. Kopf und Navigation bleiben die von StykkerSYS. *@

<div class="top">
    <div class="brand"><span class="logo">◆</span> STYKKER <span class="acc">SYS</span></div>
    <nav>
        <a class="active" href="/overview">Overview</a>
        <a href="/">Processes</a>
        <a href="/disks">Disks</a>
        <a href="http://127.0.0.1:@(StykkerPorts.Hub)/" title="StykkerHUD: CPU, memory, GPU, storage and network">Hub</a>
    </nav>
    <div class="strip">
        <div class="seg" role="group" aria-label="Theme">
            <button type="button" data-theme-choice="dark" class="on">Dark</button>
            <button type="button" data-theme-choice="titan">Titan</button>
        </div>
    </div>
</div>

<main>
    <HardwarePanel @rendermode="InteractiveServer" />
</main>
