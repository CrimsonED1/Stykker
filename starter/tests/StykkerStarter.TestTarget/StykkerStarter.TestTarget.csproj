<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ziel für Tests und den Probelauf: ein winziges Konsolenprogramm. Die Dateiversion stellt die Projektdatei
       ein (Property TargetVersion), damit zwei Versionen gebaut werden können. Es läuft, bis es beendet wird. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StykkerStarter.TestTarget</AssemblyName>
    <RootNamespace>StykkerStarter.TestTarget</RootNamespace>
    <IsPackable>false</IsPackable>
    <TargetVersion Condition="'$(TargetVersion)' == ''">1.0.0.0</TargetVersion>
    <Version>$(TargetVersion)</Version>
    <AssemblyVersion>$(TargetVersion)</AssemblyVersion>
    <FileVersion>$(TargetVersion)</FileVersion>
    <InformationalVersion>$(TargetVersion)</InformationalVersion>
  </PropertyGroup>

</Project>
