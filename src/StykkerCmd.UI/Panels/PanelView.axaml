<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="clr-namespace:StykkerCmd.UI.Panels"
             x:Class="StykkerCmd.UI.Panels.PanelView"
             x:DataType="panels:PanelViewModel">

    <Border x:Name="Frame" Classes="panel" CornerRadius="{DynamicResource PanelRadius}" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- Laufwerkstabs: ein Tab je Datenträger. Der Datenträger des angezeigten Ordners ist hervorgehoben. -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding Volumes}" Margin="8,8,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:VolumeTab">
                        <Button Classes="volume" Classes.active="{Binding IsCurrent}" Tag="{Binding Root}"
                                Content="{Binding Label}" Click="OnVolumeClick" IsTabStop="False" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Kopfzeile: Pfad und Sortierung -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="14,10,14,10">
                <TextBlock Text="{Binding DisplayPath}" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                           Foreground="{DynamicResource muted}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding SortLabel}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                           Foreground="{DynamicResource muted}" Margin="10,0,0,0" />
            </Grid>

            <!-- Filter: Teiltreffer, mit * und ? auch Muster -->
            <!-- Nicht in der Tab-Reihenfolge: sonst bekäme das Filterfeld beim Start den Fokus statt der Liste. -->
            <TextBox x:Name="FilterBox" Grid.Row="2" Margin="10,0,10,8" IsTabStop="False" PlaceholderText="Filter, z. B. *.txt"
                     Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Liste -->
            <ListBox x:Name="List" Grid.Row="3" Margin="6,0" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemsSource="{Binding Rows}"
                     SelectedIndex="{Binding CursorIndex, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="panels:EntryRow">
                        <Grid ColumnDefinitions="4,24,*,96,150" Height="26">
                            <Border Grid.Column="0" Background="{DynamicResource acc}" CornerRadius="2"
                                    IsVisible="{Binding IsMarked}" Margin="0,4" />
                            <TextBlock Grid.Column="1" Text="{Binding Icon}" Foreground="{DynamicResource muted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="12" Foreground="{DynamicResource muted}" TextAlignment="Right"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding DateText}" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="12" Foreground="{DynamicResource muted}" VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Fuß: Zählung, Markierungen, Fehler -->
            <TextBlock Grid.Row="4" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource muted}"
                       TextTrimming="CharacterEllipsis" Margin="14,8" />
        </Grid>
    </Border>
</UserControl>
