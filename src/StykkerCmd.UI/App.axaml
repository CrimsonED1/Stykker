<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StykkerCmd.UI.App"
             RequestedThemeVariant="Default">

    <!-- Die Farben kommen zur Laufzeit aus Themes/tokens.json (ThemeService), nicht aus dieser Datei. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
