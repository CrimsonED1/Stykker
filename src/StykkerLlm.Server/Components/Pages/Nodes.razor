@page "/nodes"
@rendermode InteractiveServer
@inject EngineHost Host
@inject ActionContext Actions
@inject WebActions Web
@inject ViewerSession Viewer
@implements IDisposable

@* Nodes (docs/nodes.md, Bereich 13 in docs/ui.md): andere PCs mit Stykker, mit diesem gekoppelt. Oben suchen und koppeln,
   darunter je Node eine Karte (GPU, VRAM, was läuft, Tests, Knöpfe), unten der Vergleich der Modelle je PC. *@
<h2>@Strings.NodesTitle</h2>
<p class="muted small">@Strings.NodesHint</p>

@if (Viewer.Known && Viewer.CanWrite)
{
    <div class="card">
        <div class="row">
            <button @onclick="Search" disabled="@_searching">@Strings.BtnNodesSearch</button>
            <span class="muted small">@_searchMsg</span>
        </div>
        @if (_found.Count > 0)
        {
            <table style="margin-top:8px">
                @foreach (var f in _found)
                {
                    <tr>
                        <td><b>@f.Name</b></td><td class="muted">@f.Url</td>
                        <td class="actions">
                            @if (f.Paired) { <span class="pill ok">@Strings.NodePaired</span> }
                            else { <button class="good" @onclick="() => Pair(f.Url, null)">@Strings.BtnNodePair</button> }
                        </td>
                    </tr>
                }
            </table>
        }
        <div class="row" style="margin-top:12px">
            <input @bind="_address" placeholder="@Strings.NodeAddressLabel" style="flex:1 1 220px" />
            <input class="digits" @bind="_code" placeholder="@Strings.NodeCodeLabel" inputmode="numeric" maxlength="7" style="width:13em" />
            <button class="good" disabled="@(string.IsNullOrWhiteSpace(_address))" @onclick="() => Pair(_address, _code)">@Strings.BtnNodePair</button>
        </div>
        @if (_msg.Length > 0)
        {
            <p class="small @(_ok ? "good" : "warn")">@_msg</p>
        }
        @if (_state.Pairing is { } p)
        {
            <div class="pairbox">
                @if (p.Status == PairStatus.Pending)
                {
                    <div class="muted small">@p.Name · @p.Url</div>
                    <div class="code">@AccessControl.Pretty(p.Code)</div>
                    <div class="small">@Strings.NodePairShowCode(AccessControl.Pretty(p.Code))</div>
                    <div class="muted small">@Strings.NodePairWhere · @Strings.CodeValidFor(p.Expires - DateTime.Now)</div>
                    <button style="margin-top:8px" @onclick="CancelPair">@Strings.AboutStopCancel</button>
                }
                else
                {
                    <p class="small @(p.Status == PairStatus.Approved ? "good" : "warn")">@p.Name: @p.Message</p>
                }
            </div>
        }
    </div>
}

@if (_state.List.Count == 0)
{
    <div class="card"><p class="muted">@Strings.NodesEmpty</p></div>
}
else
{
    <p class="sec">@Strings.NodesSummary(_state.List.Count, _state.Online)</p>
    <div class="nodes">
        @foreach (var n in _state.List)
        {
            <div class="card node @(n.Online ? "" : "off")">
                <div class="row">
                    <h2 style="margin:0">@n.Name</h2>
                    @if (n.Online) { <span class="pill ok">@Strings.NodeOnline</span> }
                    else { <span class="pill half">@(n.LastSeen is { } seen ? Strings.NodeOfflineSince(DateTime.Now - seen) : Strings.NodeOffline)</span> }
                    <span style="flex:1"></span>
                    <a class="btn" href="@n.Url" target="_blank">@Strings.BtnNodeOpen</a>
                </div>
                <div class="muted small">@n.GpuName@(n.GpuName.Length > 0 ? " · " : "")@n.Url</div>
                @if (n.Online)
                {
                    <div class="kpis" style="margin-top:8px">
                        <div class="kpi"><div class="muted">@Strings.GpuVram</div>@n.VramUsedGb.ToString("0.0", CultureInfo.InvariantCulture) / @n.VramTotalGb.ToString("0") GB<div class="bar"><div style="width:@Pct(n.VramUsedGb, n.VramTotalGb)%"></div></div></div>
                        <div class="kpi"><div class="muted">@Strings.Memory</div>@n.RamUsedGb.ToString("0.0", CultureInfo.InvariantCulture) / @n.RamTotalGb.ToString("0") GB<div class="bar"><div style="width:@Pct(n.RamUsedGb, n.RamTotalGb)%"></div></div></div>
                    </div>
                    @if (n.Servers.Count == 0)
                    {
                        <p class="muted small">@Strings.NodeNothingRunning</p>
                    }
                    @foreach (var sv in n.Servers)
                    {
                        <div class="row small" style="margin-top:6px">
                            <span class="dot ok">●</span><b>@sv.Model</b><span class="muted">@sv.Backend</span>
                            <span class="num">@sv.Tps.ToString("0.0", CultureInfo.InvariantCulture) t/s</span>
                            <span style="flex:1"></span>
                            @if (Viewer.CanWrite && !sv.Manual && sv.Backend == "llama.cpp")
                            {
                                <button class="bad" @onclick='() => Do(n, "stop", sv.Key)'>@Strings.Stop</button>
                            }
                        </div>
                    }
                    @if (n.EvalCurrent.Length > 0 || n.EvalQueued > 0)
                    {
                        <p class="small" style="margin:8px 0 0"><span class="pill run">@Strings.EvalRuns</span> @n.EvalCurrent @(n.EvalQueued > 0 ? $"(+{n.EvalQueued})" : "")</p>
                    }
                    @if (Viewer.CanWrite)
                    {
                        <div class="row" style="margin-top:10px">
                            @if (n.Profiles.Count > 0)
                            {
                                <select @bind="_profile[n.Id]">
                                    <option value="">@Strings.NodeProfilePick</option>
                                    @foreach (var pr in n.Profiles) { <option value="@pr.Id">@pr.Name</option> }
                                </select>
                                <button class="good" disabled="@(Profile(n.Id).Length == 0)" @onclick='() => Do(n, "start", Profile(n.Id))'>@Strings.BtnStart</button>
                            }
                            <button @onclick='() => Do(n, "freevram", null)'>@Strings.BtnFreeVram</button>
                            <span style="flex:1"></span>
                            <button class="bad" @onclick="() => Remove(n)">@Strings.BtnNodeRemove</button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(NodeMsg(n.Id)))
                    {
                        <p class="small muted">@NodeMsg(n.Id)</p>
                    }
                }
                else
                {
                    <p class="muted small">@(n.Error.Length > 0 ? n.Error : Strings.NodeNotReachable)</p>
                    @if (Viewer.CanWrite)
                    {
                        <button class="bad" @onclick="() => Remove(n)">@Strings.BtnNodeRemove</button>
                    }
                }
            </div>
        }
    </div>

    @* N5: welche GGUF liegt wo, und wie schnell war sie dort *@
    <div class="card">
        <h2>@Strings.NodeModelsTitle</h2>
        <p class="muted small">@Strings.NodeModelsHint</p>
        <div style="overflow-x:auto">
            <table>
                <thead>
                    <tr><th>@Strings.ColModel</th>@foreach (var n in _all) { <th class="num">@n.Name</th> }</tr>
                </thead>
                <tbody>
                    @foreach (var file in _files)
                    {
                        <tr>
                            <td>@file</td>
                            @foreach (var n in _all)
                            {
                                var m = n.Models.FirstOrDefault(x => x.File.Equals(file, StringComparison.OrdinalIgnoreCase));
                                var best = n.Best.Where(x => x.File.Equals(file, StringComparison.OrdinalIgnoreCase)).OrderByDescending(x => x.BestTps).FirstOrDefault();
                                <td class="num">
                                    @if (best != null) { <b>@best.BestTps.ToString("0", CultureInfo.InvariantCulture)</b> <span class="muted">t/s</span> }
                                    else if (m != null) { <span class="muted">@m.SizeGb.ToString("0.0", CultureInfo.InvariantCulture) GB</span> }
                                    else { <span class="muted">–</span> }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted small" style="margin-top:10px">@Strings.NodeProxyHint</p>
        @foreach (var n in _state.List.Where(x => x.Online && x.ProxyUrl.Length == 0))
        {
            <p class="small warn">@Strings.NodeProxyOff(n.Name)</p>
        }
    </div>
}

@code {
    private Timer? _t;
    private NodesState _state = new();
    private List<RemoteNode> _all = new();
    private List<string> _files = new();
    private readonly Dictionary<string, string> _profile = new();
    private readonly Dictionary<string, string> _nodeMsg = new();
    private List<(string Name, string Url, bool Paired)> _found = new();
    private string _address = "", _code = "", _msg = "", _searchMsg = "";
    private bool _ok, _searching;

    private static int Pct(double a, double b) => b <= 0 ? 0 : (int)Math.Clamp(100 * a / b, 0, 100);
    private string Profile(string id) => _profile.TryGetValue(id, out var v) ? v : "";
    private string NodeMsg(string id) => _nodeMsg.TryGetValue(id, out var v) ? v : "";

    protected override void OnInitialized()
    {
        Refresh();
        _t = new Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }), null, 1000, 1000);
    }

    private void Refresh()
    {
        _state = NodeStateJson.FromRegistry(Host.Nodes);
        foreach (var n in _state.List) _profile.TryAdd(n.Id, "");
        // Für den Vergleich: dieser PC zuerst, dann die Nodes, die online sind
        var all = new List<RemoteNode>();
        try { all.Add(NodeStateJson.Self(StateSnapshot.Parse(Host.StateJsonText(Actions.ServerPort, withHistory: true, withCode: false)), NetAddr.Url("127.0.0.1", Actions.ServerPort))); }
        catch (System.Text.Json.JsonException) { }
        all.AddRange(_state.List.Where(n => n.Online));
        _all = all;
        _files = all.SelectMany(n => n.Models.Select(m => m.File).Concat(n.Best.Select(b => b.File)))
            .Where(f => f.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private async Task Search()
    {
        _searching = true;
        _searchMsg = Strings.NodeSearching;
        _found.Clear();
        StateHasChanged();
        var r = await Web.RunAsync(new ActionRequest { Action = "node.search" });
        _searchMsg = r.Message;
        if (r.Data is { Length: > 0 } data)
        {
            using var doc = System.Text.Json.JsonDocument.Parse(data);
            foreach (var e in doc.RootElement.EnumerateArray())
                _found.Add((e.GetProperty("Name").GetString() ?? "", e.GetProperty("Url").GetString() ?? "", e.GetProperty("paired").GetBoolean()));
        }
        _searching = false;
    }

    private async Task Pair(string url, string? code)
    {
        var r = await Web.RunAsync(new ActionRequest { Action = "node.pair", Arg = url, Arg2 = string.IsNullOrWhiteSpace(code) ? null : code });
        _ok = r.Ok;
        _msg = r.Ok && string.IsNullOrWhiteSpace(code) ? "" : r.Message;
        if (r.Ok) { _code = ""; _address = ""; }
        Refresh();
    }

    private async Task CancelPair()
    {
        await Web.RunAsync(new ActionRequest { Action = "node.pair.cancel" });
        Refresh();
    }

    private async Task Do(RemoteNode n, string action, string? arg)
    {
        var r = await Web.RunAsync(new ActionRequest { Action = "node.do", Arg = n.Id, Name = action, Arg2 = arg });
        _nodeMsg[n.Id] = r.Message;
    }

    private async Task Remove(RemoteNode n)
    {
        var r = await Web.RunAsync(new ActionRequest { Action = "node.remove", Arg = n.Id });
        _msg = r.Ok ? "" : r.Message;
        Refresh();
    }

    public void Dispose() => _t?.Dispose();
}
