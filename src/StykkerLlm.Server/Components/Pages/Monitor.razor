@page "/"
@implements IDisposable
@inject EngineHost Host
@inject LaunchCoordinator Launcher
@inject WebActions Web
@inject WebPrompt Prompt
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Toasts Toast

@* Monitor wie im Fenster (docs/ui.md, Bereiche 2–8): Proxy, Saved, Running, GPU, System, Recent requests, History *@

@{ var e = Host.Engine; var px = e.Proxies; bool ro = Host.ReadOnly; }

@if (Host.Engine.CurrentNotice is { } nn)
{
    <div class="card" style="margin-bottom:12px">
        <div class="row">
            <span class="pill @(nn.Alarm ? "" : "ok")">@(nn.Alarm ? Strings.NoticeAlarm : Strings.NoticeHint)</span>
            <span style="margin-left:auto;white-space:nowrap">
                @if (nn.LogFile is { Length: > 0 })
                {
                    <a class="btn" href="@($"log?path={Uri.EscapeDataString(nn.LogFile)}")">@Strings.BtnOpenLog</a>
                }
                <button disabled="@ro" @onclick='() => Act("notice.dismiss")'>@Strings.BtnDismiss</button>
            </span>
        </div>
        <div style="margin-top:6px">@nn.Text</div>
        @if (nn.LogFile is { Length: > 0 })
        {
            <div class="muted small">@Strings.ColLogFile: @nn.LogFile</div>
        }
    </div>
}

@* Zwei Spalten (docs/plan-ui-redesign.md, U3): links was läuft und was passiert ist, rechts Hardware, Profile und Proxy.
   Schmal untereinander. *@
<div class="mon">
<div class="mon-main">
<h3 class="sec">@Strings.SectionRunning</h3>
@if (e.Registry.Servers.Count == 0)
{
    <div class="card"><b>@Strings.NoServersTitle</b><div class="muted small">@Strings.NoServersHint</div></div>
}
@foreach (var s in e.Registry.Servers)
{
    var sv = s;
    <ServerCard Model="ServerCardModel.From(sv, e.Recorder.Sessions.FirstOrDefault(r => r.Target == sv.Key))" CanWrite="CanWrite && !ro"
                Served="px.IsServed(sv.Key)" ProxyRunning="px.Running" SparkAgo="@SparkAgo"
                OnServe="() => Serve(sv)" OnSave='() => Act("save", sv.Key, sv.Name)'
                OnRecord='() => Act(e.Recorder.Sessions.Any(r => r.Target == sv.Key) ? "record.stop" : "record.start", sv.Key)'
                OnStop='() => Act("stop", sv.Key)' />
}

@* Server auf den Model-Hosts (docs/plan-hosts-gateway.md): dieselbe Karte mit Host-Badge; Stop geht an den Host *@
@{ var onHosts = Host.Hosts.List().Where(h => h.Connected && h.State != null).ToList(); }
@if (onHosts.Count > 0)
{
    <h3 class="sec">@Strings.SectionOnHosts</h3>
    @foreach (var h in onHosts)
    {
        var hn = h.Name.Length > 0 ? h.Name : h.Entry.Name;
        var hid = h.Entry.Id;
        @if (h.State!.Servers.Count == 0)
        {
            <div class="card hostidle"><div class="hd5"><span class="chipi host"><Icon Name="host" />@hn</span><span class="muted small">@Strings.HostsNothingRunning</span>
                @if (h.State.Gpu is { } hg) { <span class="mc" style="margin-left:auto" title="@hg.Name"><Icon Name="vram" Title="@Strings.CardVram" /><b>@hg.MemUsedGb.ToString("0.0", CultureInfo.InvariantCulture)</b><small>/@hg.MemTotalGb.ToString("0", CultureInfo.InvariantCulture) G</small></span> }
            </div></div>
        }
        @foreach (var rs in h.State.Servers)
        {
            var r = rs;
            <ServerCard Model="ServerCardModel.From(r, hid, hn)" CanWrite="CanWrite && !ro" SparkAgo="@SparkAgo"
                        OnStop="() => HostStop(hid, r.Key)" />
        }
    }
}

@* Letzte Anfragen (U7): feste Spalten mit Symbolen; Werkzeuge, Denken, Client und Ende aus der Beobachtung des Proxys *@
@{
    var finished = e.Registry.Servers.SelectMany(x => x.Finished.Select(f => (F: f, Host: (string?)null)))
        .Concat(Host.Hosts.List().Where(h => h.Connected && h.State != null)
            .SelectMany(h => h.State!.Servers.SelectMany(rs => rs.Finished.Select(f => (F: f, Host: (string?)(h.Name.Length > 0 ? h.Name : h.Entry.Name))))));
    var reqs = RequestRows.Build(finished, e.RecentProxy());
    double maxSec = reqs.Count > 0 ? Math.Max(1, reqs.Max(r => r.Seconds)) : 1;
}
<div class="card">
    <div class="row"><h2 style="margin:0">@Strings.RecentRequests</h2>
        <span class="spdscale" title="@Strings.ReqSpeedScale">t/s <i class="sp1"></i><i class="sp2"></i><i class="sp3"></i><i class="sp4"></i></span></div>
    @if (reqs.Count == 0) { <span class="muted small">@Strings.NoneYet</span> }
    else
    {
        <div class="reqs">
            <div class="req head" aria-hidden="true"><span></span><span>@Strings.ReqModel</span><span>@Strings.ReqHost</span><span>@Strings.ReqTime</span><span class="r">@Strings.ReqPrompt</span><span class="r">t/s</span><span class="r">@Strings.ReqTokens</span><span class="c">@Strings.ReqTools</span><span class="c">@Strings.ReqThink</span><span class="c">@Strings.ReqResult</span><span class="r">@Strings.ReqAgo</span></div>
            @foreach (var r in reqs)
            {
                var kind = r.Host == null ? e.Registry.Servers.FirstOrDefault(x => x.Key == r.ServerKey)?.Kind ?? BackendKind.LlamaCpp : BackendKind.LlamaCpp;
                <div class="req">
                    <span class="cl" title="@(r.Client.Length > 0 ? r.Client : Strings.ReqClientUnknown)"><Icon Name="@("c-" + r.ClientKind)" Title="@(r.Client.Length > 0 ? r.Client : Strings.ReqClientUnknown)" /></span>
                    <span class="mdl" title="@r.Model"><i style="background:var(@BackendColor(kind))"></i>@r.Server</span>
                    <span class="hostc">@if (r.Host != null) { <span class="chipi host"><Icon Name="host" />@r.Host</span> } else { <span class="muted small">@Strings.CardLocal</span> }</span>
                    <span class="dur" title="@r.Seconds.ToString("0.0", CultureInfo.InvariantCulture) s"><span class="dbar"><i style="width:@((int)(100 * r.Seconds / maxSec))%"></i></span><small>@(r.Seconds > 0 ? r.Seconds.ToString("0", CultureInfo.InvariantCulture) + "s" : "–")</small></span>
                    <span class="r muted">@(r.PromptTps > 0 ? r.PromptTps.ToString("0", CultureInfo.InvariantCulture) : "–")</span>
                    <span class="r spd sp@(RequestRows.SpeedLevel(r.GenTps))">@r.GenTps.ToString("0.0", CultureInfo.InvariantCulture)</span>
                    <span class="r">@r.GenTokens.ToString("N0", CultureInfo.InvariantCulture)</span>
                    <span class="c ex @(r.Tools is > 0 ? "" : "na")" title="@(r.Tools == null ? Strings.ReqNoProxy : Strings.ReqToolsTip(r.Tools.Value))"><Icon Name="x-tool" />@(r.Tools is int t && t > 0 ? t.ToString(CultureInfo.InvariantCulture) : "–")</span>
                    <span class="c ex @(r.ThinkTokens is > 0 ? "" : "na")" title="@(r.ThinkTokens == null ? Strings.ReqNoProxy : Strings.ReqThinkTip(r.ThinkTokens.Value))"><Icon Name="x-think" />@(r.ThinkTokens is int k && k > 0 ? (k >= 1000 ? (k / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) + "k" : k.ToString(CultureInfo.InvariantCulture)) : "–")</span>
                    <span class="c res res-@r.Result" title="@Strings.ReqResultText(r.Result)"><Icon Name="@("r-" + r.Result)" Title="@Strings.ReqResultText(r.Result)" /></span>
                    <span class="r muted small">@Ago(r.Seen)</span>
                </div>
            }
        </div>
    }
</div>

@* History (U8): nach Tagen gruppiert, je Lauf Laufzeit, Ø/Spitze t/s, Tokens des letzten Laufs und wie er endete;
   Suche (/ springt hinein), Filter, Aktionen als Symbole, Vergessen mit Rückgängig *@
@{
    var runningKeys = e.Registry.Servers.Where(x => !string.IsNullOrEmpty(x.Info.Program) && x.Info.Args != null).Select(x => Library.MakeKey(x.Info.Program!, x.Info.Args!)).ToHashSet();
    var hlist = e.Library.History.Where(Match).Where(h => !_forgetting.Contains(h.Key))
        .Where(h => _hfilter == "all" || (_hfilter == "crashed" && h.LastEnd == "crashed") || (_hfilter == "running" && runningKeys.Contains(h.Key)))
        .OrderByDescending(h => h.LastSeen).Take(40).ToList();
    double maxRun = hlist.Count > 0 ? Math.Max(1, hlist.Max(h => h.Runs > 0 ? h.TotalSeconds / h.Runs : 0)) : 1;
}
<div class="card">
    <div class="histbar">
        <h2>@Strings.SectionHistory</h2>
        <label class="search"><input id="hsearch" placeholder="@Strings.HistorySearch" @bind="_q" @bind:event="oninput" aria-label="@Strings.HistorySearch" /><span class="kbd">/</span></label>
        <span class="fchips" role="group" aria-label="@Strings.HistFilter">
            @foreach (var (f, label) in new[] { ("all", Strings.HistAll), ("running", Strings.HistRunning), ("crashed", Strings.HistCrashed) })
            {
                var ff = f;
                <button class="fchip @(_hfilter == ff ? "on" : "")" aria-pressed="@(_hfilter == ff ? "true" : "false")" @onclick="() => _hfilter = ff">@label</button>
            }
        </span>
    </div>
    @if (hlist.Count == 0)
    {
        <div class="empty"><Icon Name="timer" Class="lg" /><div><b>@(_q.Length > 0 || _hfilter != "all" ? Strings.HistNoMatch : Strings.HistEmptyTitle)</b><div class="muted small">@(_q.Length > 0 || _hfilter != "all" ? Strings.HistNoMatchHint : Strings.HistEmptyHint)</div></div></div>
    }
    <div class="hist">
        @foreach (var grp in hlist.GroupBy(h => DayGroup(h.LastSeen)))
        {
            <div class="hgrp">@grp.Key <span class="muted">@grp.Count()</span></div>
            @foreach (var h in grp)
            {
                var hh = h;
                bool live = runningKeys.Contains(h.Key);
                double avgRun = h.Runs > 0 ? h.TotalSeconds / h.Runs : 0;
                var endState = live ? "live" : h.LastEnd;
                <div class="hr">
                    <i class="hdot @(live ? "on" : "")" style="--b:var(--b-llama)"></i>
                    <div class="hname">
                        <b title="@(h.ModelPath ?? h.Name)">@(h.Name.Length > 0 ? h.Name : h.ModelPath != null ? ServerInfo.ModelName(h.ModelPath) : "?")</b>
                        <span class="muted small">@h.LastSeen.ToString(grp.Key == Strings.HistOlder ? "d.M. HH:mm" : "HH:mm", CultureInfo.InvariantCulture) · :@(h.Port?.ToString(CultureInfo.InvariantCulture) ?? "–") · @h.Runs×</span>
                    </div>
                    <span class="mc @(h.Ctx == null ? "na" : "")" title="@Strings.CardCtx"><Icon Name="ctx" Title="@Strings.CardCtx" /><b>@(h.Ctx is int c ? (c / 1024).ToString(CultureInfo.InvariantCulture) : "–")</b>@if (h.Ctx != null) { <small>k</small> }</span>
                    <span class="hrun" title="@Strings.HistRunTip(avgRun, h.TotalSeconds)"><span class="dbar"><i style="width:@((int)(100 * avgRun / maxRun))%"></i></span><small>@Dur(avgRun)</small></span>
                    <span class="htps" title="@Strings.HistTpsTip"><b class="sp@(RequestRows.SpeedLevel(h.MeanTps))">@(h.MeanTps > 0 ? h.MeanTps.ToString("0.0", CultureInfo.InvariantCulture) : "–")</b><small> / @(h.BestTps > 0 ? h.BestTps.ToString("0.0", CultureInfo.InvariantCulture) : "–")</small></span>
                    <span class="mc @(h.LastRunTokens > 0 ? "" : "na")" title="@Strings.HistTokensTip"><Icon Name="sum" Title="@Strings.CardSum" /><b>@(h.LastRunTokens > 0 ? (h.LastRunTokens / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) : "–")</b>@if (h.LastRunTokens > 0) { <small>k</small> }</span>
                    <span class="hend end-@(endState.Length > 0 ? endState : "none")" title="@Strings.HistEndText(endState, h.LastEndAt)"><Icon Name="@EndIcon(endState)" Title="@Strings.HistEndText(endState, h.LastEndAt)" /></span>
                    <span class="hacts">
                        <button class="ib quiet" disabled="@(ro || !CanWrite || live)" title="@Strings.BtnStartAgain" aria-label="@Strings.BtnStartAgain" @onclick="() => StartHistory(hh)"><Icon Name="play" /></button>
                        <button class="ib quiet" disabled="@(ro || !CanWrite)" title="@Strings.CardSave" aria-label="@Strings.CardSave" @onclick='() => Act("profile.add-history", hh.Key, hh.Name)'><Icon Name="save" /></button>
                        <button class="ib quiet" title="@Strings.BtnDetails" aria-label="@Strings.BtnDetails" @onclick="() => OpenDetails(hh)"><Icon Name="info" /></button>
                        <button class="ib quiet danger" disabled="@(ro || !CanWrite)" title="@Strings.BtnForget" aria-label="@Strings.BtnForget" @onclick="() => Forget(hh)"><Icon Name="trash" /></button>
                    </span>
                </div>
            }
        }
    </div>
</div>
</div>
<aside class="mon-side">
@* Hardware (U5): GPU und System in einer Karte, je Programm als gestapelter Balken mit Legende; Details auf /gpu *@
@if (e.Gpu != null || e.Sys != null)
{
    <h3 class="sec">@Strings.SectionHardware</h3>
    <div class="card hw">
        @if (e.Gpu is { } g)
        {
            <h2>@Strings.Gpu <small class="muted">@g.Name · @g.MemTotalGb.ToString("0", CultureInfo.InvariantCulture) GB</small><a class="more" href="gpu" title="@Strings.GpuDetails">@Strings.HwDetails <Icon Name="open" /></a></h2>
            <div class="meters">
                @Meter(Strings.GpuLoad, g.Util.ToString("0", CultureInfo.InvariantCulture), "%", g.Util / 100, null)
                @Meter(Strings.GpuVram, g.MemUsedGb.ToString("0.0", CultureInfo.InvariantCulture), "/ " + g.MemTotalGb.ToString("0", CultureInfo.InvariantCulture) + " GB", g.MemUsedGb / Math.Max(1, g.MemTotalGb), Strings.HwFree(Math.Max(0, g.MemTotalGb - g.MemUsedGb)))
                @Meter(Strings.GpuPower, g.PowerW.ToString("0", CultureInfo.InvariantCulture), "/ " + g.PowerLimitW.ToString("0", CultureInfo.InvariantCulture) + " W", g.PowerW / Math.Max(1, g.PowerLimitW), null)
                @Meter(Strings.GpuTemp, g.TempC.ToString("0", CultureInfo.InvariantCulture), "°C", Math.Clamp(g.TempC / 90.0, 0, 1), g.Throttled ? g.ThrottleText() : Strings.GpuClocksFree, warnNote: g.Throttled)
            </div>
            <div class="subh">@Strings.GpuConsumers</div>
            <StackBar Items="e.VramTop" UsedGb="g.MemUsedGb" TotalGb="g.MemTotalGb" MoreHref="gpu" />
        }
        @if (e.Sys is { } sy)
        {
            <h2 class="@(e.Gpu != null ? "hw-sep" : "")">@Strings.SystemCard</h2>
            <div class="meters">
                @Meter(Strings.CpuLoad, sy.CpuPercent.ToString("0", CultureInfo.InvariantCulture), "%", sy.CpuPercent / 100, Strings.LogicalCores(sy.Cores))
                @Meter(Strings.Memory, sy.RamUsedGb.ToString("0.0", CultureInfo.InvariantCulture), "/ " + sy.RamTotalGb.ToString("0", CultureInfo.InvariantCulture) + " GB", sy.RamFrac, Strings.HwFree(Math.Max(0, sy.RamTotalGb - sy.RamUsedGb)))
            </div>
            @if (e.RamTop.Count > 0)
            {
                <div class="subh">@Strings.RamConsumers</div>
                <StackBar Items="e.RamTop" UsedGb="sy.RamUsedGb" TotalGb="sy.RamTotalGb" />
            }
        }
    </div>
}

<h3 class="sec">@Strings.SectionSaved</h3>
@* Profile als Kacheln (U6): Backend-Streifen, sechs feste Symbole, laufend = leuchtet mit Live-t/s, darunter die
   VRAM-Vorhersage (gemessen oder aus dem GGUF-Kopf geschätzt) gegen den freien Grafikspeicher *@
<div class="card pf-card">
    @if (e.Library.Profiles.Count == 0) { <span class="muted small">@Strings.SavedEmpty</span> }
    <div class="pfs">
        @foreach (var p in e.Library.Profiles)
        {
            var pr = p;
            var a = LlamaServerArgs.Parse(p.Args);
            var running = Launcher.RunningFor(p); var starting = Launcher.StartingFor(p);
            var hist = e.Library.FindHistory(p.Key);
            var need = VramNeed(p, hist);
            double? free = e.Gpu is { } fg && fg.MemTotalGb > 0 ? Math.Max(0, fg.MemTotalGb - fg.MemUsedGb) : null;
            bool tight = running == null && need is double nd && free is double fr && nd > fr;
            bool draft = p.Args.Any(x => x is "-md" or "--model-draft" or "--hf-repo-draft" or "-hfd");
            <div class="pf @(running != null ? "on" : "") @(starting != null ? "starting" : "") @(tight ? "tight" : "")" style="--b:var(--b-llama)">
                <div class="pf-hd">
                    <span class="bk" title="llama.cpp"><Icon Name="b-llama" Title="llama.cpp" /></span>
                    <span class="name" title="@(a.Model ?? p.Name)">@p.Name</span>
                    <span class="st" data-s="@(running != null ? (running.Current > 0 ? "gen" : "idle") : starting != null ? "load" : "off")" title="@(running != null ? Strings.RunningTag : starting != null ? Strings.StartingShort : Strings.CardStateOff)">
                        <Icon Name="@(running != null ? (running.Current > 0 ? "s-gen" : "s-idle") : starting != null ? "s-load" : "s-off")" Class="@(starting != null ? "spin" : null)" />
                    </span>
                    <span class="pf-tps @(running == null ? "na" : "")" title="@Strings.ColTps"><b>@(running != null ? running.Current.ToString("0.0", CultureInfo.InvariantCulture) : hist is { BestTps: > 0 } ? hist.BestTps.ToString("0.0", CultureInfo.InvariantCulture) : "–")</b><small>@(running != null ? "t/s" : "best")</small></span>
                </div>
                <div class="pf-grid">
                    <span class="mc @(a.Ctx == null ? "na" : "")" title="@Strings.CardCtx"><Icon Name="ctx" Title="@Strings.CardCtx" /><b>@(a.Ctx is int c ? (c / 1024).ToString(CultureInfo.InvariantCulture) : "–")</b>@if (a.Ctx != null) { <small>k</small> }</span>
                    <span class="mc @(a.NglRaw == null ? "na" : "")" title="@Strings.PfNgl"><Icon Name="layers" Title="@Strings.PfNgl" /><b>@(a.NglRaw ?? "–")</b></span>
                    <span class="mc @(p.Port == null ? "na" : "")" title="@Strings.CardPort(p.Port ?? 0)"><Icon Name="port" Title="Port" /><b>@(p.Port?.ToString(CultureInfo.InvariantCulture) ?? "–")</b></span>
                    <span class="mc @(p.UnloadAfterIdleMin == 0 ? "na off" : "")" title="@(p.UnloadAfterIdleMin == 0 ? Strings.IdleUnloadOff : Strings.IdleUnloadSet(p.UnloadAfterIdleMin))"><Icon Name="timer" Title="@Strings.PfIdle" /><b>@(p.UnloadAfterIdleMin == 0 ? "–" : p.UnloadAfterIdleMin + "m")</b></span>
                    <span class="mc @(draft ? "" : "na off")" title="@(draft ? Strings.PfDraftOn : Strings.PfDraftOff)"><Icon Name="draft" Title="@Strings.CardDraft" /><b>@(draft ? Strings.PfOn : "–")</b></span>
                    <span class="mc @(p.RestartOnCrash ? "" : "na off")" title="@(p.RestartOnCrash ? Strings.PfRestartOn : Strings.PfRestartOff)"><Icon Name="restart" Title="@Strings.PfRestart" /><b>@(p.RestartOnCrash ? Strings.PfOn : "–")</b></span>
                </div>
                @if (running == null && need is double needGb && free is double freeGb)
                {
                    <div class="pf-fc" title="@Strings.PfForecastTip(needGb, freeGb, hist is { MaxVramGb: > 0 })">
                        <Icon Name="vram" />
                        <span class="fc-bar"><i class="free" style="width:@Pct(freeGb, Math.Max(needGb, freeGb))"></i><i class="need" style="width:@Pct(needGb, Math.Max(needGb, freeGb))"></i></span>
                        <b>@needGb.ToString("0.0", CultureInfo.InvariantCulture)</b><small>/ @freeGb.ToString("0.0", CultureInfo.InvariantCulture) G</small>
                    </div>
                }
                <div class="pf-act">
                    @if (running != null)
                    {
                        <a class="btn ib" href="@($"prompt?server={Uri.EscapeDataString(running.Key)}")" title="@Strings.PromptTitle" aria-label="@Strings.PromptTitle"><Icon Name="chat" /></a>
                        <button class="ib danger" disabled="@ro" title="@Strings.CardStop" aria-label="@Strings.CardStop" @onclick='() => Act("stop", running.Key)'><Icon Name="stop" /></button>
                    }
                    else if (starting == null)
                    {
                        <button class="ib txt primary" disabled="@ro" title="@StartTip(p)" @onclick="() => Start(pr)"><Icon Name="play" />@Strings.BtnStart</button>
                    }
                    <details class="pf-cmd">
                        <summary title="@Strings.PfCmdLine">@Strings.PfCmdLine</summary>
                        <code>@p.Program @string.Join(" ", p.Args)</code>
                    </details>
                    <details class="menu" style="margin-left:auto">
                        <summary title="@Strings.BtnMore" aria-label="@Strings.BtnMore"><Icon Name="more" /></summary>
                        <div>
                            <a href="@($"bench?target={p.Id:N}")">@Strings.BtnBench</a>
                            <button disabled="@ro" @onclick="() => Edit(pr)">@Strings.BtnEdit</button>
                            <span class="grp">@Strings.PfIdle</span>
                            <div class="seg">
                                @foreach (var min in new[] { 0, 15, 30, 60 })
                                {
                                    var mm = min;
                                    <button class="@(p.UnloadAfterIdleMin == mm ? "on" : "")" disabled="@ro" @onclick="() => SetIdle(pr, mm)">@(mm == 0 ? Strings.PfOff : mm + "m")</button>
                                }
                            </div>
                            <button class="bad" disabled="@ro" @onclick="() => Remove(pr)">@Strings.BtnRemove</button>
                        </div>
                    </details>
                </div>
            </div>
        }
    </div>
    @if (_edit != null)
    {
        <div style="margin-top:12px;border-top:1px solid var(--line);padding-top:10px">
            <div class="row"><b>@Strings.BtnEdit</b> <span class="muted small">@_edit.Name</span>
                <span style="margin-left:auto"><button class="good" disabled="@ro" @onclick="SaveEdit">@Strings.BtnSaved</button> <button @onclick="() => _edit = null">@Strings.Close</button></span></div>
            <div class="row" style="margin-top:8px">
                <input placeholder="@Strings.FieldName" @bind="_editName" @bind:event="oninput" style="flex:1" />
                <input placeholder="@Strings.FieldNote" @bind="_editNote" @bind:event="oninput" style="flex:1" />
            </div>
            <textarea @bind="_editArgs" @bind:event="oninput" rows="3" style="width:100%;margin-top:8px;font-family:Consolas,monospace"></textarea>
        </div>
    }
</div>

<div id="proxy" class="mon-proxy">
@* Proxy-Panel (U9): Kopf mit Schalter und Adresse, Ziel „stykker“, LAN, Quellen als kurze Listen; Formulare erst auf
   Klick, lange Hinweise als Tooltip am Info-Symbol *@
@{ var models = px.Choices(); var remotes = px.RemoteStates(); var provs = Providers; var baseUrl = ProxyBaseUrl(px); }
<h3 class="sec">@Strings.PxTitle</h3>
<div class="card pxp @(px.Running ? "on" : "")">
    <div class="pxp-hd">
        <span class="lamp @(px.Running ? "on" : "")"></span>
        <b>@(px.Running ? Strings.PxRunning : Strings.PxStopped)</b>
        <button class="switch @(px.Running ? "on" : "")" role="switch" aria-checked="@(px.Running ? "true" : "false")" aria-label="@Strings.PxTitle" disabled="@(ro || !CanWrite)" @onclick="ToggleProxy"><i></i></button>
        @if (px.Running)
        {
            <code class="pxp-url" title="@Strings.ProxyBar(px.Running, px.Port, px.TargetName(), px.BindLan)">@baseUrl</code>
            <button class="ib quiet" title="@Strings.PxCopy" aria-label="@Strings.PxCopy" @onclick="() => Copy(baseUrl)"><Icon Name="@(_copied ? "r-ok" : "file")" /></button>
        }
    </div>
    @if (_flash.Length > 0) { <div class="small pxp-flash">@_flash</div> }

    <div class="pxp-row">
        <span class="pxp-l">@Strings.PxAnswers <span class="tip" title="@Strings.ProxySwitchHint"><Icon Name="info" /></span></span>
        <select disabled="@(ro || !CanWrite)" value="@ServeValue" @onchange="OnServeChanged">
            <option value="">@Strings.ProxyTargetAuto</option>
            @foreach (var c in models) { <option value="@c.Value">@c.Display</option> }
        </select>
    </div>
    <div class="pxp-row">
        <span class="pxp-l">@Strings.PxLan <span class="tip warnc" title="@Strings.ProxyLanHint"><Icon Name="info" /></span></span>
        <button class="switch sm @(px.BindLan ? "on warn" : "")" role="switch" aria-checked="@(px.BindLan ? "true" : "false")" aria-label="@Strings.PxLan" disabled="@(ro || !CanWrite)" @onclick="() => SetLan(!px.BindLan)"><i></i></button>
        <span class="muted small">@(px.BindLan ? Strings.PxLanOn : Strings.PxLanOff)</span>
    </div>

    <div class="subh">@Strings.PxSources</div>
    <div class="pxs-list">
        <div class="pxs-item">
            <Icon Name="host" /><span class="n">@Strings.PxThisPc</span>
            <span class="muted small">@Strings.PxModels(models.Count(c => !c.Cloud && !c.Value.StartsWith("remote:", StringComparison.Ordinal)))</span>
        </div>
        <div class="pxs-grp">
            <span>@Strings.PxMachines <span class="tip" title="@Strings.ProxyRemoteHint"><Icon Name="info" /></span></span>
            @if (CanWrite && !ro && _add != "remote") { <button class="ib quiet" title="@Strings.PxAdd" aria-label="@Strings.PxAdd" @onclick='() => _add = "remote"'>+ @Strings.PxAdd</button> }
        </div>
        @if (remotes.Count == 0 && _add != "remote") { <div class="muted small pxs-none">@Strings.PxNoMachines</div> }
        @foreach (var r in remotes)
        {
            var rr = r;
            <div class="pxs-item">
                <span class="lamp @(r.Ready ? "on" : "bad")" title="@(r.Ready ? Strings.PxReachable : Strings.PxUnreachable)"></span>
                <span class="n" title="@r.Url">@r.Name</span>
                <span class="muted small">@Strings.PxModels(r.Models.Length)</span>
                @if (CanWrite && !ro) { <button class="ib quiet danger" title="@Strings.PxRemove" aria-label="@Strings.PxRemove" @onclick="() => RemoveRemote(rr.Url)"><Icon Name="trash" /></button> }
            </div>
        }
        @if (_add == "remote")
        {
            <div class="pxs-form">
                <input placeholder="@Strings.ProxyRemoteNameLabel" @bind="_rName" @bind:event="oninput" />
                <input placeholder="@Strings.ProxyRemoteUrlLabel" @bind="_rUrl" @bind:event="oninput" />
                <div class="row"><button class="primary" @onclick="AddRemote">@Strings.PxAdd</button><button class="ghost" @onclick="() => _add = null">@Strings.PxCancel</button></div>
            </div>
        }

        <div class="pxs-grp">
            <span>@Strings.PxCloud <span class="tip" title="@Strings.ProxyProviderHint"><Icon Name="info" /></span></span>
            @if (CanWrite && !ro && _add != "provider") { <button class="ib quiet" title="@Strings.PxAdd" aria-label="@Strings.PxAdd" @onclick='() => _add = "provider"'>+ @Strings.PxAdd</button> }
        </div>
        @if (provs.Count == 0 && _add != "provider") { <div class="muted small pxs-none">@Strings.PxNoCloud</div> }
        @foreach (var pv in provs)
        {
            var pp = pv;
            <div class="pxs-item">
                <span class="lamp @(pv.Ready ? "on" : pv.HasKey ? "bad" : "")" title="@(pv.Error.Length > 0 ? pv.Error : pv.Ready ? Strings.PxReachable : Strings.PxUnreachable)"></span>
                <span class="n" title="@pv.Url">@pv.Name</span>
                <span class="muted small" title="@string.Join(", ", pv.Models)">@Strings.PxModels(pv.Models.Length)</span>
                <span class="small @(pv.HasKey ? "muted" : "warnc")"><Icon Name="lock" Class="sm" /> @(pv.HasKey ? Strings.PxKeyStored : Strings.PxKeyMissing)</span>
                @if (CanWrite && !ro)
                {
                    <button class="ib quiet" title="@Strings.PxSetKey" aria-label="@Strings.PxSetKey" @onclick="() => _keyFor = pp.Url"><Icon Name="edit" /></button>
                    <button class="ib quiet danger" title="@Strings.PxRemove" aria-label="@Strings.PxRemove" @onclick="() => RemoveProvider(pp.Url)"><Icon Name="trash" /></button>
                }
            </div>
            @if (_keyFor == pv.Url)
            {
                <div class="pxs-form">
                    <input type="password" placeholder="@Strings.ProxyProviderKeyLabel" value="@KeyFor(pv.Url)" @oninput="e => OnKeyInput(pp.Url, e)" autocomplete="off" />
                    <div class="row"><button class="primary" @onclick="() => { SaveKey(pp.Url); _keyFor = null; }">@Strings.BtnProxyProviderKey</button><button class="ghost" @onclick="() => _keyFor = null">@Strings.PxCancel</button></div>
                </div>
            }
        }
        @if (_add == "provider")
        {
            <div class="pxs-form">
                <input placeholder="@Strings.ProxyProviderNameLabel" @bind="_pName" @bind:event="oninput" />
                <input placeholder="@Strings.ProxyProviderUrlLabel" @bind="_pUrl" @bind:event="oninput" />
                <input type="password" placeholder="@Strings.ProxyProviderKeyLabel" @bind="_pKey" @bind:event="oninput" autocomplete="off" />
                <div class="row"><button class="primary" @onclick="AddProviderForm">@Strings.PxAdd</button><button class="ghost" @onclick="() => _add = null">@Strings.PxCancel</button></div>
            </div>
        }
    </div>

    @if (models.Count > 0)
    {
        <details class="pxp-models">
            <summary>@Strings.PxModelList(models.Count)</summary>
            <ul>@foreach (var c in models) { <li title="@c.Value">@c.Display</li> }</ul>
        </details>
    }
</div>
</div>
</aside>
</div>

@code {
    private Timer? _t;
    private string _q = "", _flash = "";
    private string _rName = "", _rUrl = "";
    private string _pName = "", _pUrl = "", _pKey = "";
    private readonly Dictionary<string, string> _pKeys = new();
    private Profile? _edit;
    private string _editName = "", _editNote = "", _editArgs = "";
    private const string RoTip = "The monitor window owns the data folder – use the window for this (the server becomes the core in a later step).";

    // Startknopf-Tooltip wie im Fenster: die Vorprüfung (Port, Modelldatei, VRAM, RAM) läuft im Hintergrund,
    // das Ergebnis wird kurz (10 s) zwischengespeichert, damit die Seite nicht bei jedem Takt neu prüft
    private readonly Dictionary<string, (DateTime At, string Text)> _startTips = new();
    private readonly HashSet<string> _startTipBusy = new();

    protected override void OnInitialized() => _t = new Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    public void Dispose() => _t?.Dispose();

    private string StartTip(Profile p)
    {
        if (_startTips.TryGetValue(p.Key, out var cached) && (DateTime.Now - cached.At).TotalSeconds < 10) return cached.Text;
        if (_startTipBusy.Add(p.Key))
        {
            var hist = Host.Engine.Library.FindHistory(p.Key);
            var spec = new LaunchSpec(p.Name, p.Program, p.Args, p.WorkingDir, p.Id, hist is { MaxVramGb: > 0 } ? hist.MaxVramGb : null, p.Env);
            var running = Host.Engine.Registry.Servers.Select(s => s.Info).ToList();
            var gpu = Host.Engine.Gpu;
            _ = Task.Run(async () =>
            {
                string text;
                try
                {
                    var issues = (await ServerLauncher.CheckAsync(spec, Host.Engine.Platform, gpu, running)).Where(i => i.Code != "secret").ToList();
                    var errors = issues.Where(i => i.Severity == LaunchSeverity.Error).ToList();
                    var warns = issues.Where(i => i.Severity == LaunchSeverity.Warning).ToList();
                    text = errors.Count > 0 ? Strings.StartTipBlocked(IssueLines(errors))
                        : warns.Count > 0 ? Strings.StartTipWarn(IssueLines(warns))
                        : Strings.StartTipReady;
                }
                catch { text = Strings.StartTipReady; }
                await InvokeAsync(() =>
                {
                    _startTips[p.Key] = (DateTime.Now, text);
                    _startTipBusy.Remove(p.Key);
                    StateHasChanged();
                });
            });
        }
        return _startTips.TryGetValue(p.Key, out var old) ? old.Text : Strings.StartTipChecking;
    }

    private static string IssueLines(IEnumerable<LaunchIssue> issues) => string.Join("\n", issues.Select(i => "• " + i.Message));

    private static string Gb(double? v) => v == null ? "–" : v.Value.ToString("0.0", CultureInfo.InvariantCulture) + " GB";

    // Ollama/LM Studio: Modellname plus, was das Backend selbst meldet (VRAM, Kontext, Entladezeit, Shared Memory)
    private static string ModelLine(LoadedModel m)
    {
        var parts = new List<string> { m.Name };
        if (m.VramBytes > 0 && m.SizeBytes > 0) parts.Add($"{Gb(m.VramBytes / 1073741824.0)} VRAM of {Gb(m.SizeBytes / 1073741824.0)}");
        else if (m.SizeBytes > 0) parts.Add(Gb(m.SizeBytes / 1073741824.0));
        if (m.ContextLength is int c) parts.Add("ctx " + c.ToString("N0", CultureInfo.InvariantCulture));
        if (ServerWatcher.SpillGb(new[] { m }, null) is double spill) parts.Add(Strings.SharedMemoryNote(spill));
        if (Strings.Until(m.ExpiresAt) is { Length: > 0 } un) parts.Add(un);
        return string.Join("  ·  ", parts);
    }

    // Höhe des letzten Werts in Prozent der Kurve (für den Leuchtpunkt rechts, wie im Fenster)
    private static string? SparkTip(ServerWatcher s)
    {
        int n = s.HistoryCount;
        if (n < 2) return null;
        double max = Math.Max(10, Math.Ceiling(s.Peak / 10) * 10);
        double y = 68 - 64 * Math.Min(max, s.HistoryAt(n - 1)) / max;
        return (y / 70 * 100).ToString("0.0", CultureInfo.InvariantCulture);
    }

    // Die Fläche unter der Linie: dieselben Punkte, unten geschlossen
    private static string SparkArea(ServerWatcher s)
    {
        int n = s.HistoryCount;
        if (n < 2) return "";
        double x0 = 300.0 * (ServerWatcher.HistoryLength - n) / (ServerWatcher.HistoryLength - 1);
        return $"{x0.ToString("0.0", CultureInfo.InvariantCulture)},70 {Spark(s)}300,70";
    }

    private static string Spark(ServerWatcher s)
    {
        int n = s.HistoryCount;
        if (n < 2) return "";
        double max = Math.Max(10, Math.Ceiling(s.Peak / 10) * 10);
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < n; i++)
        {
            double x = 300.0 * (ServerWatcher.HistoryLength - n + i) / (ServerWatcher.HistoryLength - 1);
            double y = 68 - 64 * Math.Min(max, s.HistoryAt(i)) / max;
            sb.Append(x.ToString("0.0", CultureInfo.InvariantCulture)).Append(',').Append(y.ToString("0.0", CultureInfo.InvariantCulture)).Append(' ');
        }
        return sb.ToString();
    }

    // Beschriftung unten links an der Kurve: wie weit sie zurückreicht (300 Takte)
    private string SparkAgo => Strings.CardSparkAgo(Math.Max(1, (int)Math.Round(ServerWatcher.HistoryLength * Math.Max(500, Host.Engine.Settings.IntervalMs) / 60000.0)));

    private async Task HostStop(string hostId, string key)
    {
        if (!CanWrite) return;
        var r = await Web.RunAsync(new ActionRequest { Action = "host.stop", Arg = hostId, Arg2 = key });
        if (!r.Ok) await Prompt.InformAsync(Strings.ActionFailed, r.Message, warning: true);
    }

    // Eine Messanzeige der Hardware-Karte: Name, rechts eine Notiz (frei, Drosselung), großer Wert, Balken
    private static RenderFragment Meter(string label, string value, string unit, double frac, string? note, bool warnNote = false) => __builder =>
    {
        frac = Math.Clamp(frac, 0, 1);
        <div class="meter @(frac > .92 ? "hot" : "")">
            <div class="l"><span>@label</span>@if (note != null) { <span class="@(warnNote ? "warnc" : "")" title="@note">@note</span> }</div>
            <div class="v"><b>@value</b> <small>@unit</small></div>
            <div class="bar"><div style="width:@((int)(frac * 100))%"></div></div>
        </div>
    };

    // VRAM-Vorhersage eines Profils (U6): gemessen beim letzten Lauf, sonst aus dem GGUF-Kopf geschätzt (einmal je
    // Profil im Hintergrund gelesen und gemerkt), sonst null
    private readonly Dictionary<string, double?> _need = new();
    private readonly HashSet<string> _needBusy = new();
    private double? VramNeed(Profile p, HistoryEntry? hist)
    {
        if (hist is { MaxVramGb: > 0 }) return hist.MaxVramGb;
        if (_need.TryGetValue(p.Key, out var known)) return known;
        if (_needBusy.Add(p.Key))
        {
            var args = LlamaServerArgs.Parse(p.Args, p.Env);
            var path = ServerLauncher.ResolveModel(args.Model ?? p.ModelPath, p.WorkingDir);
            _ = Task.Run(async () =>
            {
                double? gb = null;
                try
                {
                    if (path != null && Gguf.TryRead(path) is { } g)
                    {
                        int ctx = args.Ctx is > 0 ? args.Ctx.Value : (int)Math.Min(g.ContextLength ?? 4096, 131072);
                        gb = VramEstimate.Estimate(g, ctx, args.CacheTypeK, args.CacheTypeV, args.Ngl).TotalGb;
                    }
                }
                catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException) { }
                await InvokeAsync(() => { _need[p.Key] = gb; _needBusy.Remove(p.Key); StateHasChanged(); });
            });
        }
        return null;
    }

    private static string Pct(double part, double whole) =>
        (whole > 0 ? Math.Clamp(100 * part / whole, 0, 100) : 0).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private Task SetIdle(Profile p, int minutes) =>
        Web.RunAsync(new ActionRequest { Action = "profile.idleunload", Arg = p.Id.ToString("N"), Number = minutes });

    // Proxy-Panel (U9): welches Formular offen ist ("remote", "provider" oder keins), für welchen Anbieter der Schlüssel
    private string? _add, _keyFor;
    private bool _copied;

    // Adresse für Clients: im LAN die erste Netzadresse dieses PCs, sonst 127.0.0.1
    private static string ProxyBaseUrl(ProxyManager px)
    {
        var host = px.BindLan ? NetInfo.Ipv4Addresses().FirstOrDefault() ?? "127.0.0.1" : "127.0.0.1";
        return $"http://{host}:{px.Port.ToString(CultureInfo.InvariantCulture)}/v1";
    }

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); _copied = true; }
        catch (JSException) { _flash = text; }
        catch (InvalidOperationException) { }
        _ = Task.Delay(1500).ContinueWith(_ => InvokeAsync(() => { _copied = false; StateHasChanged(); }));
    }

    private void SetLan(bool on) { if (CanWrite) Host.Engine.Proxies.SetBindLan(on); }

    private void AddProviderForm()
    {
        AddProvider();
        if (_pName.Length == 0 && _pUrl.Length == 0) _add = null;   // angenommen: Felder sind geleert
    }

    private static string BackendColor(BackendKind k) => k switch
    {
        BackendKind.Ollama => "--b-ollama", BackendKind.LmStudio => "--b-lms", BackendKind.Vllm => "--b-vllm", _ => "--b-llama",
    };

    // „12s“, „4m“, „2h“ – wie lange die Anfrage her ist
    private static string Ago(DateTime? t)
    {
        if (t == null) return Strings.FromLog;
        var d = DateTime.Now - t.Value;
        return d.TotalSeconds < 60 ? $"{Math.Max(0, (int)d.TotalSeconds)}s" : d.TotalMinutes < 60 ? $"{(int)d.TotalMinutes}m" : d.TotalHours < 24 ? $"{(int)d.TotalHours}h" : $"{(int)d.TotalDays}d";
    }

    private bool Match(HistoryEntry h) => Library.Matches(h, _q);

    // Alles, was hier direkt an Engine, Proxy oder Library geht (nicht über die Aktionen), braucht dieselbe
    // Rollenprüfung wie WebActions – sonst könnte ein Viewer über die Weboberfläche doch etwas bedienen.
    private bool CanWrite => Web.CanWrite;

    private void ToggleProxy()
    {
        if (!CanWrite) return;
        if (!Host.Engine.Proxies.Toggle(out var error) && error != null) _flash = error;
    }

    // Kennung des servierten Modells: „<ServerKey>|<Modell>" oder eine Cloud-Zielkennung, leer = Auto
    private string ServeValue => Host.Engine.Proxies.ChoiceValue();

    private void OnServeChanged(ChangeEventArgs a) { if (CanWrite) Host.Engine.Proxies.SetChoiceValue(a.Value?.ToString() ?? ""); }


    private void AddRemote()
    {
        if (!CanWrite) return;
        if (string.IsNullOrWhiteSpace(_rUrl)) return;
        Host.Engine.Proxies.AddRemote(_rName, _rUrl);
        _rName = _rUrl = "";
        _add = null;
    }

    private void RemoveRemote(string url) { if (CanWrite) Host.Engine.Proxies.RemoveRemote(url); }

    // ── Cloud-Anbieter: der Schlüssel geht nur an den Proxy (dort DPAPI-geschützt) und wird nie wieder angezeigt *─
    private IReadOnlyList<(string Name, string Url, bool HasKey, bool Ready, string[] Models, string Error)> Providers
        => Host.Engine.Proxies.ProviderStates();

    private string KeyFor(string url) => _pKeys.TryGetValue(url, out var k) ? k : "";

    private void OnKeyInput(string url, ChangeEventArgs a) => _pKeys[url] = a.Value?.ToString() ?? "";

    private void AddProvider()
    {
        if (!CanWrite) return;
        Host.Engine.Proxies.AddProvider(_pName, _pUrl, _pKey, out var error);
        if (error != null) { _flash = error; return; }
        _pName = _pUrl = _pKey = "";
    }

    private void SaveKey(string url)
    {
        if (!CanWrite) return;
        Host.Engine.Proxies.SetProviderKey(url, KeyFor(url), out var error);
        if (error != null) { _flash = error; return; }
        _pKeys.Remove(url);
    }

    private void RemoveProvider(string url)
    {
        if (!CanWrite) return;
        Host.Engine.Proxies.RemoveProvider(url);
        _pKeys.Remove(url);
    }

    // Diesen Server als Ziel des Proxys (Knopf „→ Proxy" auf der Karte)
    private void Serve(ServerWatcher s)
    {
        if (!CanWrite) return;
        var choice = Host.Engine.Proxies.ServeChoices().FirstOrDefault(c => c.ServerKey == s.Key);
        Host.Engine.Proxies.SetTarget(choice.ServerKey ?? s.Key, choice.Model);
    }

    private void Edit(Profile p)
    {
        _edit = p;
        _editName = p.Name;
        _editNote = p.Note ?? "";
        _editArgs = string.Join(' ', p.Args);
    }

    private async Task SaveEdit()
    {
        if (_edit == null) return;
        var id = _edit.Id.ToString("N");
        if (_editName.Length > 0 && _editName != _edit.Name) await Act("profile.rename", id, _editName);
        if (_editNote != (_edit.Note ?? "")) await Act("profile.note", id, _editNote);
        var args = CmdLine.Split(_editArgs);
        if (!args.SequenceEqual(_edit.Args)) await ActWith("profile.args", id, ("args", _editArgs));
        _edit = null;
        _flash = Strings.SetSaved;
    }

    private async Task Remove(Profile p)
    {
        if (!await Prompt.ConfirmAsync(Strings.BtnRemove, Strings.RemoveProfileConfirm(p.Name), warning: true)) return;
        await Act("profile.remove", p.Id.ToString("N"));
        _edit = null;
    }

    // Vergessen mit Rückgängig (U8): der Eintrag verschwindet sofort aus der Liste, gelöscht wird erst nach Ablauf der Meldung
    private readonly HashSet<string> _forgetting = new();
    private string _hfilter = "all";

    private Task Forget(HistoryEntry h)
    {
        if (!CanWrite) return Task.CompletedTask;
        var name = h.Name.Length > 0 ? h.Name : Strings.SectionHistory;
        var key = h.Key;
        _forgetting.Add(key);
        Toast.ShowUndo(Strings.HistForgotten(name),
            commit: async () => { await InvokeAsync(async () => { await Act("history.forget", key); _forgetting.Remove(key); StateHasChanged(); }); },
            undo: () => InvokeAsync(() => { _forgetting.Remove(key); StateHasChanged(); }));
        return Task.CompletedTask;
    }

    private static string DayGroup(DateTime t) =>
        t.Date == DateTime.Today ? Strings.HistToday : t.Date == DateTime.Today.AddDays(-1) ? Strings.HistYesterday : Strings.HistOlder;

    private static string Dur(double sec) =>
        sec <= 0 ? "–" : sec < 60 ? $"{(int)sec}s" : sec < 3600 ? $"{(int)(sec / 60)}m" : (sec / 3600).ToString("0.#", CultureInfo.InvariantCulture) + "h";

    private static string EndIcon(string end) => end switch
    {
        "live" => "s-gen", "clean" => "r-ok", "crashed" => "e-crash", "outside" => "e-kill", _ => "s-idle",
    };

    private async Task Start(Profile p) { if (CanWrite && await Launcher.StartProfileAsync(p)) _flash = Strings.StartingShort; }
    private async Task StartHistory(HistoryEntry h) { if (CanWrite) await Launcher.StartHistoryAsync(h); }

    // Die Details des Eintrags wie im Fenster (Bereich 8): eigene Seite, damit der Knopf im Telefon auch passt
    private void OpenDetails(HistoryEntry h) => Nav.NavigateTo("history/" + Uri.EscapeDataString(h.Key));

    // Alles, was den Server anfasst, läuft über die Aktionen (eine Engine im System, Fenster und TUI machen es genauso)
    private async Task Act(string action, string? arg = null, string? name = null)
    {
        var result = await Web.RunAsync(new ActionRequest { Action = action, Arg = arg, Name = name });
        if (!result.Ok) await Prompt.InformAsync(Strings.ActionFailed, result.Message, warning: true);
        else _flash = result.Message == "ok" ? "" : result.Message;
    }

    private async Task ActWith(string action, string arg, params (string Key, string Value)[] values)
    {
        var req = new ActionRequest { Action = action, Arg = arg };
        foreach (var (k, v) in values) req.Values[k] = v;
        var result = await Web.RunAsync(req);
        if (!result.Ok) await Prompt.InformAsync(Strings.ActionFailed, result.Message, warning: true);
    }
}
