<Project>

  <!-- Gemeinsame Metadaten aller Projekte. Nur Metadaten: kein Verhalten. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Authors>CrimsonED1</Authors>
    <Company>CrimsonED1</Company>
    <Product>StykkerCMD</Product>
    <Copyright>Copyright (c) CrimsonED1</Copyright>
    <Description>Native two-panel file manager for Windows and Linux, keyboard-driven.</Description>
    <Deterministic>true</Deterministic>
    <!-- keine Commit-Kennung in der Produktversion (0.1.0 statt 0.1.0+hash) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
